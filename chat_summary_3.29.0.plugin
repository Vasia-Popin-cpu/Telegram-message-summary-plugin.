def ui_alpha(color, opacity):
    return ui_signed((int(round(max(0.0,min(1.0,opacity))*255))<<24)|(int(color)&0xffffff))


def glass_background(view, palette, panel=False):
    # Compatibility entry point for existing design=4 preferences.
    ui_background(view, palette['background'] if panel else palette['soft'],
                  20 if panel else 12, None if panel else palette['border'])
    return False


UI_TRANSLATIONS.update({'Сводка прочитанных': {'en': 'Read messages summary', 'uk': 'Підсумок прочитаних'}, 'Прочитанных сообщений': {'en': 'Read messages', 'uk': 'Прочитаних повідомлень'}, 'Введите количество': {'en': 'Enter message count', 'uk': 'Введіть кількість'}, 'Дополнительные пожелания к сводке': {'en': 'Additional summary instructions', 'uk': 'Додаткові побажання до підсумку'}, 'Непрочитанных нет. Введите, сколько последних прочитанных сообщений взять.': {'en': 'No unread messages. Enter how many recent read messages to include.', 'uk': 'Непрочитаних немає. Введіть, скільки останніх прочитаних повідомлень узяти.'}, 'Непрочитанные и прочитанный контекст настраиваются здесь.': {'en': 'Configure unread messages and earlier read context here.', 'uk': 'Налаштуйте тут непрочитані повідомлення та прочитаний контекст.'}, 'При наличии непрочитанных прочитанный контекст берётся перед ними. Учитываются и ваши ответы.': {'en': 'Read context comes before the unread messages. Your replies count too.', 'uk': 'Прочитаний контекст береться перед непрочитаними. Ваші відповіді також враховуються.'}, 'Сводки этого чата': {'en': 'Summaries in this chat', 'uk': 'Підсумки цього чату'}, 'Последние результаты этого чата и темы': {'en': 'Recent results in this chat and topic', 'uk': 'Останні результати цього чату й теми'}, 'Здесь появятся последние сводки только этого чата и темы. До 10 результатов, до выгрузки плагина.': {'en': 'Recent summaries from this chat and topic appear here. Up to 10 results, until the plugin unloads.', 'uk': 'Тут з’являться останні підсумки лише цього чату й теми. До 10 результатів, до вивантаження плагіна.'}, 'Чат или аккаунт сменился. Откройте историю заново.': {'en': 'Chat or account changed. Reopen history.', 'uk': 'Чат або акаунт змінився. Відкрийте історію знову.'}, 'Разные цвета имён': {'en': 'Different name colours', 'uk': 'Різні кольори імен'}, 'Цвет имён и ID в тексте и плашках участников.': {'en': 'Name and ID colours in text and participant labels.', 'uk': 'Кольори імен та ID у тексті й плашках учасників.'}, 'Цветные плашки участников': {'en': 'Coloured participant chips', 'uk': 'Кольорові плашки учасників'}, 'Разный фон плашек в стилях с облачками.': {'en': 'Different chip backgrounds in bubble designs.', 'uk': 'Різні тла плашок у стилях із хмаринками.'}, 'AI получает Telegram ID вместо имён. Имена внутри текста не удаляются.': {'en': 'AI receives Telegram IDs instead of names. Names within messages are not removed.', 'uk': 'AI отримує Telegram ID замість імен. Імена всередині тексту не видаляються.'}, 'Подставлять локально, если в выбранной переписке не больше 4 участников.': {'en': 'Restore names locally when the selected conversation has at most 4 participants.', 'uk': 'Підставляти імена локально, якщо у вибраній переписці не більше 4 учасників.'}, 'Обычная, подробная сводка и история текущего чата.': {'en': 'Quick summary, detailed summary and current chat history.', 'uk': 'Звичайний підсумок, докладний підсумок та історія поточного чату.'}, 'Есть непрочитанные — сводка всех. Нет — выбор прочитанных. Удержание — новая.': {'en': 'Summarize all unread messages, or choose a read message count. Hold for a new summary.', 'uk': 'Підсумок усіх непрочитаних або вибір кількості прочитаних. Утримання — новий підсумок.'}, 'Отправители указаны по Telegram ID.': {'en': 'Senders are identified by Telegram ID.', 'uk': 'Відправників указано за Telegram ID.'}, 'Отправители указаны по Telegram ID': {'en': 'Senders are identified by Telegram ID', 'uk': 'Відправників указано за Telegram ID'}, 'Алексей': {'en': 'Alex', 'uk': 'Олексій'}, 'Мария': {'en': 'Maria', 'uk': 'Марія'}, 'Переключитесь на исходный аккаунт, чтобы открыть профиль.': {'en': 'Switch to the original account to open the profile.', 'uk': 'Перейдіть до початкового акаунта, щоб відкрити профіль.'}, 'Не удалось открыть профиль в этой сборке клиента.': {'en': 'Could not open the profile in this client build.', 'uk': 'Не вдалося відкрити профіль у цій збірці клієнта.'}})

CHAT_HISTORY_LIMIT = 10
CHAT_HISTORY_CHATS = 32
PARTICIPANT_COLOURS = [0xFF5794F2,0xFFB37CE3,0xFFE59B45,0xFF48AE9B,0xFFD66FA7,0xFFC5A342,0xFFE37370,0xFF77AA55]


def telegram_sender_label(identity):
    kind,number=identity
    if kind=='user_id' and number>0:
        return str(number)
    if kind in ('channel_id','chat_id') and number>0:
        return ('channel:' if kind=='channel_id' else 'chat:')+str(number)
    return 'unknown'


def participant_label(participant, transcript, names=True):
    key,name,kind,number=participant
    if not names:return key
    label=name if name and name!='Участник' else _tr('Участник')
    duplicates=sorted(p[0] for p in transcript.participants if (p[1] if p[1] and p[1]!='Участник' else _tr('Участник'))==label)
    return label+' ('+str(duplicates.index(key)+1)+')' if len(duplicates)>1 else label


def participant_colour(key, transcript, palette):
    occupied=set();index=0
    for candidate in sorted(p[0] for p in transcript.participants):
        slot=int(hashlib.sha256(candidate.encode('utf-8')).hexdigest()[:8],16)%len(PARTICIPANT_COLOURS)
        for _ in PARTICIPANT_COLOURS:
            if slot not in occupied:break
            slot=(slot+1)%len(PARTICIPANT_COLOURS)
        occupied.add(slot)
        if candidate==key:
            index=slot;break
    colour=ui_signed(PARTICIPANT_COLOURS[index])
    for surface in ('background','soft','tint'):
        colour=ui_legible(colour,palette[surface])
    return colour


def card_participants(text, mid, transcript, names=True):
    if transcript is None:
        return ()
    selected=set()
    for source,key in transcript.source_senders:
        if source==mid:selected.add(key)
    for participant in transcript.participants:
        key=participant[0];label=participant_label(participant,transcript,names)
        if re.search(r'(?<![\w:])tg:'+re.escape(key)+r'(?![\w:])',text):selected.add(key)
        if names and label!=key and re.search(r'(?<!\w)'+re.escape(label)+r'(?!\w)',text):selected.add(key)
    return tuple(p for p in transcript.participants if p[0] in selected and p[0]!='unknown')


def participant_markup(text, transcript, palette, coloured=True, names=True):
    # Build existing safe formatting first, then colour only text nodes, never HTML tags.
    markup=summary_markup(text,Transcript('',0,0,0,0,0))
    if transcript is None:
        return markup
    import html
    labels={}
    for participant in transcript.participants:
        label=participant_label(participant,transcript,names)
        if participant[2]!='preview' and (participant[2] not in ('user_id','chat_id','channel_id') or participant[3]<=0):continue
        colour=(participant_colour(participant[0],transcript,palette) if coloured else palette['text'])&0xffffff
        target=None if participant[2]=='preview' else 'summary-user:'+participant[0]
        labels[html.escape('tg:'+participant[0])]=(colour,target)
        if names and label!=participant[0]:labels[html.escape(label)]=(colour,target)
    if not labels:return markup
    pattern=re.compile(r'(?<!\w)(?:'+'|'.join(re.escape(label) for label in sorted(labels,key=len,reverse=True))+r')(?!\w)')
    def colour(match):
        value=match.group(0)
        tone,target=labels[value]
        value='<font color="#'+format(tone,'06x')+'">'+value+'</font>'
        return '<a href="'+target+'">'+value+'</a>' if target else value
    return ''.join(part if index%2 else pattern.sub(colour,part) for index,part in enumerate(re.split(r'(<[^>]*>)',markup)))


def detail_form_options(base, include_unread, count_text, prompt, selections):
    value=str(count_text).strip()
    if not value:
        count=0
    else:
        try:
            if not value.isdecimal():raise ValueError()
            count=int(value)
        except (ValueError,TypeError):
            raise SummaryError('detail_count','Введите целое количество сообщений от 0.') from None
    if 'catalog' in selections:
        record=selections['catalog'][index_value(selections['style'],len(selections['catalog']))]
        base=with_detail_style(base,record);selections=dict(selections,style=base.style)
    return validate_detailed(replace(base,include_unread=bool(include_unread),prior_count=count,prompt=str(prompt).strip(),
        style=selections['style'],language=selections['language'],output_index=selections['output_index']))



class SummaryParticipantSpanHook(MethodHook):
    def __init__(self,plugin):self.plugin=plugin
    def before_hooked_method(self,param):
        if self.plugin._participant_span_action(param.thisObject):param.setResult(None)


class SummaryParticipantTextHook(MethodHook):
    def __init__(self,plugin):self.plugin=plugin
    def before_hooked_method(self,param):
        result=self.plugin._participant_text_touch(param.thisObject,param.args[0])
        if result is not None:param.setResult(bool(result))


def summary_narrative_entries(display, transcript):
    result=[]
    for text,mid in summary_cards(display,transcript):
        title,body=card_title_and_body(text)
        people=card_participants(title,None,transcript,True)
        if people:
            remaining=title
            for person in sorted(people,key=lambda p:len(participant_label(p,transcript,True)),reverse=True):
                remaining=re.sub(re.escape(participant_label(person,transcript,True)),' ',remaining,flags=re.I)
                remaining=remaining.replace('tg:'+person[0],' ')
            only_names=not re.sub(r'\b(?:и|та|й|and)\b|[\s,;&/+—–-]','',remaining,flags=re.I)
            if not any(re.search(r'(?<!\w)'+re.escape(participant_label(p,transcript,True))+r'(?!\w)',body,re.I) for p in people):
                body=title+' '+(body[:1].lower()+body[1:] if body else '') if only_names else title.rstrip('. ')+'. '+body
            title=_tr('Обсуждение')
        result.append((title,body,mid))
    return result

def history_card_text(saved, names=True):
    result,transcript,provider,model=saved.data
    display=local_summary_text(result.text,transcript,names)
    entries=summary_narrative_entries(display,transcript)
    title,body,_=entries[0] if entries else (_tr('Сводка сообщений'),'',None)
    clean=lambda value:re.sub(r'\s+',' ',re.sub(r'[*_`#]','',value)).strip()
    title,body=clean(title),clean(body)
    if len(title)>80:title=title[:77].rstrip()+'…'
    if len(body)>115:body=body[:112].rstrip()+'…'
    return title,body

UI_TRANSLATIONS.update({'Обсуждение': {'en': 'Discussion', 'uk': 'Обговорення'}, 'Сообщений': {'en': 'Messages', 'uk': 'Повідомлень'}, 'Сообщения': {'en': 'Messages', 'uk': 'Повідомлення'}, 'Прочитанные': {'en': 'Read messages', 'uk': 'Прочитані'}, 'Последние сводки': {'en': 'Recent summaries', 'uk': 'Останні підсумки'}, 'Сохранено': {'en': 'Saved', 'uk': 'Збережено'}, 'В этом чате пока нет сводок': {'en': 'No summaries in this chat yet', 'uk': 'У цьому чаті ще немає підсумків'}, 'Пожелания': {'en': 'Instructions', 'uk': 'Побажання'}, 'Ответ': {'en': 'Response', 'uk': 'Відповідь'}, 'О чём рассказать подробнее?': {'en': 'What should the summary focus on?', 'uk': 'Про що розповісти докладніше?'}, 'Сколько последних сообщений включить?': {'en': 'How many recent messages should be included?', 'uk': 'Скільки останніх повідомлень включити?'}, 'Включены': {'en': 'On', 'uk': 'Увімкнені'}, 'Выключены': {'en': 'Off', 'uk': 'Вимкнені'}, 'Выделять имена в тексте сводки.': {'en': 'Highlight names within the summary text.', 'uk': 'Виділяти імена в тексті підсумку.'}, 'Дима': {'en': 'Dima', 'uk': 'Діма'}, 'Максим': {'en': 'Maxim', 'uk': 'Максим'}, 'Обсуждение лошадей': {'en': 'Discussing horses', 'uk': 'Обговорення коней'}, 'Планы на выходные': {'en': 'Weekend plans', 'uk': 'Плани на вихідні'}, 'Дима и Максим обсуждали лошадей. Договорились выбрать маршрут для прогулки.': {'en': 'Dima and Maxim discussed horses. They agreed to choose a route for a ride.', 'uk': 'Діма й Максим обговорювали коней. Домовилися обрати маршрут для прогулянки.'}, 'Максим предложил встретиться в субботу. Дима уточнит время завтра.': {'en': 'Maxim suggested meeting on Saturday. Dima will confirm the time tomorrow.', 'uk': 'Максим запропонував зустрітися в суботу. Діма уточнить час завтра.'}})

def name_span_style(participant, transcript, palette, design=0, coloured=True, clouds=False):
    spec=summary_design_spec(design);base=palette[spec['fill']] if spec['fill'] else palette['background']
    tone=participant_colour(participant[0],transcript,palette)
    fill=ui_mix(base,tone,0.16) if clouds else base
    ink=ui_legible(tone if coloured else palette['text'],fill)
    return {'ink':ink,'fill':fill,'clouds':bool(clouds),'design':index_value(design,len(SUMMARY_DESIGNS))}


def utf16_offset(value, position):
    return len(str(value)[:position].encode('utf-16-le'))//2


class SummaryParticipantPaintHook(MethodHook):
    def __init__(self,plugin):self.plugin=plugin
    def after_hooked_method(self,param):
        self.plugin._participant_span_paint(param.thisObject,param.args[0])



class ChatSummaryPlugin(BasePlugin):
    def on_plugin_load(self):
        self._sync_display_preferences()
        if self.get_setting('summary_header', None) is None:
            self.set_setting('summary_header', self.get_setting('summary_circle', True))
        self._lock = threading.Lock()
        self._loaded = True
        self._diag_lock = threading.Lock()
        self._diag_events = deque(maxlen=60)
        self._safe_error_text = "Нет ошибок"
        self._diag_icons_warned = False
        with _ICON_LOCK:
            _ICON_CACHE.clear()
            _ICON_AUDIT.clear()
            _GLYPH_CACHE.clear()
            _GLYPH_AUDIT.clear()
        self._job = None
        self._picker = None
        self._result_dialog = None
        self._result_dialog_account = None
        self._last_by_account = {}
        self._recent_by_account = {}
        self._summary_reopen = {}
        self._chat_history = {}
        self._summary_ready={}
        self._init_history_store()
        self.last_error = "Нет ошибок"
        self._connection_checks = {}
        self._header_factory = None
        self._settings_pages_supported = None
        self._chat_states = {}
        self._view_actions = {}
        self._participant_spans = {}
        self._participant_texts = {}
        self._name_style_views = {}
        self._participant_paint_hook = False
        self._last_name_style_counts = {}
        self._participant_link_hooks = False
        self._native_click_hooks = (0,0)
        self._unread_java_class = None
        self._chat_hooks = []
        self._chat_observer_type = None
        self._chat_long_click_type = None
        self._chat_ui_paused = False
        self._workspace_surfaces={}
        self._workspace_touch_hook=False
        # Older factories cannot unregister themselves; do not register one on those SDKs.
        if SimpleSettingFactory is not None and callable(getattr(SimpleSettingFactory, "release", None)):
            try:
                self._header_factory = SimpleSettingFactory(self._create_header_view, self._bind_header_view, is_clickable=False)
            except Exception:
                self._event("header_fallback", "warning")
        self._migrate_settings()
        self._event("loaded")
        self._chat_menu_ids={}
        self._chat_menu_signature=None
        self._sync_chat_menu()
        self._install_view_actions()
        self._install_chat_ui()

    def _install_chat_ui(self):
        self._chat_observer_type=None
        self._chat_long_click_type=None
        plugin=self
        try:
            from java import dynamic_proxy
            from android.view import ViewTreeObserver
            class PreDraw(dynamic_proxy(ViewTreeObserver.OnPreDrawListener)):
                def __init__(self,state):
                    super().__init__();self.state=state
                def onPreDraw(self):
                    if plugin._loaded:
                        try:plugin._update_chat_control(self.state)
                        except Exception:plugin._event('chat_ui_failed','warning')
                    return True
            self._chat_observer_type=PreDraw
        except Exception:
            self._event('chat_ui_failed','warning')
        from hook_utils import find_class
        self._ui_hook_counts={}
        self._install_header_touch()
        cls=find_class('org.telegram.ui.ChatActivity')
        for name,action,before in [('onFragmentCreate','capture',False),('createView','capture',True),('createView','attach',False),('onResume','attach',False),('onPause','pause',True),('onFragmentDestroy','destroy',True)]:
            self._ui_hook_counts[name+('_before' if before else '_after')]=len(self._hook_java(cls,name,SummaryChatHook(self,action,before)))
        self._unread_java_class=find_class('org.telegram.ui.Cells.ChatUnreadCell')
        if self.get_setting('tap_unread_badge',True):
            self._ui_hook_counts['unread_constructors']=len(self._hook_java(self._unread_java_class,'',SummaryChatHook(self,'badge'),True))
        controller=find_class('org.telegram.messenger.MessagesController')
        self._ui_hook_counts['read_boundary']=len(self._hook_java(controller,'markDialogAsRead',SummaryChatHook(self,'read',True)))
        self._event('chat_ui_ready' if any(self._ui_hook_counts.values()) else 'chat_ui_failed','info' if any(self._ui_hook_counts.values()) else 'warning')
        run_on_ui_thread(self._attach_active_summary)

    def _chat_state(self, fragment):
        identity = summary_identity(fragment)
        key = int(fragment.hashCode())
        state = self._chat_states.get(key)
        if state is not None and state["identity"] != identity:
            self._detach_chat_control(state)
            state = None
        if state is None:
            state = {"fragment": fragment, "identity": identity, "bounds": None,
                     "root": None, "button": None, "observer": None, "cells": {}, "paused": False}
            if len(self._chat_states) >= 16:
                oldest = next(iter(self._chat_states))
                self._detach_chat_control(self._chat_states.pop(oldest))
            self._chat_states[key] = state
        if state["bounds"] is None:
            try:
                state["bounds"] = opening_unread_bounds(fragment, identity)
            except Exception:
                pass
        return state

    def _chat_hook(self, action, fragment):
        try:
            if action == "badge":
                from android_utils import R
                cell_ref = self._chat_view_ref(fragment)
                fragment.post(R(lambda ref=cell_ref: self._wire_active_unread_cell(ref())))
                return
            if action == "destroy":
                state = self._chat_states.pop(int(fragment.hashCode()), None)
                if state is not None:
                    self._detach_chat_control(state)
                return
            state = self._chat_state(fragment)
            if action == "capture":
                return
            if action == "pause":
                state["paused"] = True
                self._detach_chat_control(state)
            elif action == "attach":
                state["paused"] = False
                self._attach_chat_control(state)
        except Exception:
            self._event("chat_ui_failed", "warning")

    def _attach_active_summary(self):
        if not self._loaded or self._chat_ui_paused:
            return
        try:
            fragment = get_last_fragment()
            if fragment is not None and "ChatActivity" in class_name(fragment):
                self._chat_hook("attach", fragment)
        except Exception:
            self._event("chat_ui_failed", "warning")

    def _chat_is_current(self, state):
        if not self._loaded or self._chat_ui_paused or state.get("paused"):
            return False
        current = get_last_fragment()
        try:
            return current is not None and current.equals(state["fragment"]) and summary_identity(current) == state["identity"] and int(get_selected_account()) == state["identity"][0]
        except Exception:
            return False

    def _attach_chat_control(self, state):
        if not self._loaded or self._chat_ui_paused:
            return
        if not (self.get_setting('summary_header', True) or self.get_setting('tap_unread_badge', True) or getattr(self,'_job',None) is not None or getattr(self,'_summary_ready',{})):
            return
        fragment = state['fragment']
        root = fragment.getFragmentView()
        if root is None:
            return
        if state['root'] is not None and not state['root'].equals(root):
            self._detach_chat_control(state)
        state['root'] = root
        if state['observer'] is None and self._chat_observer_type is not None:
            observer = self._chat_observer_type(state)
            root.getViewTreeObserver().addOnPreDrawListener(observer)
            state['observer'] = observer
        if self.get_setting('summary_header', True):
            from org.telegram.messenger import AndroidUtilities
            state['header_bar'] = fragment.getActionBar()
            menu = state['header_bar'].createMenu()
            current = state.get('button')
            if current is not None:
                parent = current.getParent()
                same_parent = parent is menu
                if parent is not None and not same_parent:
                    try:
                        same_parent = bool(parent.equals(menu))
                    except Exception:
                        pass
                if not same_parent:
                    state['button'] = None
            if state['button'] is None:
                item = menu.getItem(SUMMARY_HEADER_ID)
                if item is not None:
                    description = str(item.getContentDescription() or '')
                    if not re.search(r'summary|сводк|сводка|підсум|стислий', description, re.I):
                        self._event('header_id_conflict', 'warning')
                        return
                    self._event('header_recovered')
                else:
                    activity = fragment.getParentActivity()
                    icon_id = int(activity.getResources().getIdentifier('msg_list', 'drawable', str(activity.getPackageName())))
                    if not icon_id:
                        from org.telegram.messenger import R
                        icon_id = int(R.drawable.msg_info)
                    try:
                        item = menu.addItemWithWidth(SUMMARY_HEADER_ID, icon_id, AndroidUtilities.dp(48), _tr('Сводка непрочитанных'))
                    except Exception:
                        item = menu.addItemWithWidth(SUMMARY_HEADER_ID, icon_id, AndroidUtilities.dp(48))
                state['button'], state['header_menu'] = item, menu
            state['header_menu'] = menu
            self._place_summary_before_menu(state)
            # Both a new item and an item left by a previous plugin instance must receive listeners.
            self._bind_header_control(state)
        self._update_chat_control(state)

    @staticmethod
    def _chat_view_ref(view):
        try:
            from java.lang.ref import WeakReference
            ref = WeakReference(view)
            return lambda ref=ref: ref.get()
        except Exception:
            import weakref
            ref = weakref.ref(view)
            return lambda ref=ref: ref()





    def _update_chat_control(self, state):
        from org.telegram.messenger import DialogObject
        root, button, fragment = state['root'], state['button'], state['fragment']
        if root is None:
            return
        now = time.monotonic()
        if state['bounds'] is None and now >= state.get('bounds_probe_at', 0):
            state['bounds_probe_at'] = now + 0.5
            try:
                state['bounds'] = opening_unread_bounds(fragment, state['identity']) or separator_unread_bounds(fragment)
            except Exception:
                pass
        show = self._chat_is_current(state) and self.get_setting('summary_header', True)
        try:
            show = show and not DialogObject.isEncryptedDialog(state['identity'][1])
            get_mode = getattr(fragment, 'getChatMode', None)
            mode = int(get_mode()) if callable(get_mode) else int(java_field(fragment, 'chatMode', 0) or 0)
            show = show and mode == 0 and not bool(java_field(fragment, 'searching', False))
            bar = fragment.getActionBar()
            selected = getattr(bar, 'isActionModeShowed', None)
            if callable(selected):
                show = show and not selected()
        except Exception:
            show = False
        if button is not None:
            self._place_summary_before_menu(state)
            if now>=state.get('header_icon_probe_at',0):
                state['header_icon_probe_at']=now+0.25;self._apply_header_icon(state)
            if show:
                self._raise_header_menu(state)
            recent = self._recent_summary(state['identity'])
            if now>=state.get('job_indicator_at',0):
                state['job_indicator_at']=now+0.20
                try:self._update_job_indicator(state)
                except Exception:pass
            label = self._header_job_label(state,recent)
            if state.get('button_label') != label:
                button.setContentDescription(label)
                state['button_label'] = label
            visibility = 0 if show else 8
            if button.getVisibility() != visibility:
                button.setVisibility(visibility)
        if self.get_setting('tap_unread_badge', True) and self._chat_is_current(state) and now >= state.get('scan_at', 0):
            state['scan_at'] = now + 0.25
            chat_list = java_field(fragment, 'chatListView')
            if chat_list is not None:
                for i in range(int(chat_list.getChildCount())):
                    cell = chat_list.getChildAt(i)
                    if self._is_unread_cell(cell):
                        self._wire_unread_cell(state, cell)

    def _open_chat_unread(self, state):
        self._summary_click(state)

    def _wire_active_unread_cell(self, cell):
        if not self._loaded or cell is None or not self.get_setting('tap_unread_badge',True):
            return
        try:
            fragment=get_last_fragment()
            if fragment is None:
                return
            state=self._chat_state(fragment)
            if state['root'] is None:
                state['root']=fragment.getFragmentView()
            if state['root'] is not None:
                self._wire_unread_cell(state,cell)
        except Exception:
            self._event('unread_bind_failed','warning')

    def _wire_unread_cell(self, state, cell):
        if not self._loaded or not self.get_setting('tap_unread_badge',True):
            return
        parent,belongs=cell,False
        for _ in range(40):
            if parent is None:
                break
            if parent is state['root'] or parent.equals(state['root']):
                belongs=True;break
            parent=parent.getParent()
        if not belongs:
            return
        # Same inner-target resolution as Unread Summary, including first-child fallback.
        inner=java_field(cell,'backgroundLayout')
        if inner is None:
            try:
                inner=cell.getChildAt(0) if int(cell.getChildCount()) else None
            except Exception:
                pass
        targets=[cell]
        if inner is not None and inner is not cell:
            targets.append(inner)
        added = False
        for view in targets:
            key=int(view.hashCode())
            if key in state['cells'] and key in self._view_actions:
                continue
            info=java_field(view,'mListenerInfo')
            previous,previous_touch=java_field(info,'mOnClickListener'),java_field(info,'mOnTouchListener')
            clickable,focusable=bool(view.isClickable()),bool(view.isFocusable())
            listener,_=self._bind_view_action(view,lambda:self._open_chat_unread(state),owner=state)
            added = True
            state['cells'][key]=(self._chat_view_ref(view),previous,listener,clickable,focusable,previous_touch,None)
            # Do not consume raw touches; RecyclerListView retains Android's scroll/cancel behavior.
        if added:
            self._event('unread_bound')

    def _detach_chat_control(self, state):
        self._detach_job_indicator(state)
        self._cancel_header_gesture(state)
        state["header_layout_requested"] = False
        self._clear_view_actions(state)
        for record in state['cells'].values():
            ref, previous, ours, clickable, focusable, previous_touch, ours_touch = record
            try:
                view = ref()
                info = java_field(view, 'mListenerInfo')
                current = java_field(info, 'mOnClickListener')
                current_touch = java_field(info, 'mOnTouchListener')
                if view is not None:
                    if current is not None and current.equals(ours):
                        view.setOnClickListener(previous)
                        view.setClickable(clickable)
                        view.setFocusable(focusable)
                    if current_touch is not None and current_touch.equals(ours_touch):
                        view.setOnTouchListener(previous_touch)
            except Exception:
                pass
        state['cells'].clear()
        root, observer, button = state['root'], state['observer'], state['button']
        if root is not None and observer is not None:
            try:
                tree = root.getViewTreeObserver()
                if tree.isAlive():
                    tree.removeOnPreDrawListener(observer)
            except Exception:
                pass
        for target in state.pop('header_targets', []):
            try:
                info = java_field(target,'mListenerInfo')
                ours_click, ours_long = state.get('click'),state.get('long_click')
                current_click,current_long = java_field(info,'mOnClickListener'),java_field(info,'mOnLongClickListener')
                if current_click is ours_click or (current_click is not None and current_click.equals(ours_click)):
                    target.setOnClickListener(None)
                if current_long is ours_long or (current_long is not None and current_long.equals(ours_long)):
                    target.setOnLongClickListener(None)
            except Exception:
                pass
        if button is not None:
            try:
                button.setOnClickListener(None)
                button.setOnLongClickListener(None)
                parent = button.getParent()
                if parent is not None:
                    parent.removeView(button)
                    parent.requestLayout()
            except Exception:
                pass
        for key in ('root', 'observer', 'button', 'icon', 'click', 'long_click', 'header_menu', 'header_bar', 'button_label'):
            state[key] = None
        state.pop('header_icon_signature',None);state.pop('header_icon_probe_at',None)
        state.pop('header_icon_failed_signature',None);state.pop('header_icon_retry_at',None)

    def _summary_ui_change(self, key, value):
        self.set_setting(key,bool(value))
        def refresh():
            if not self._loaded:
                return
            if key=='summary_menu':
                self._sync_chat_menu()
                return
            for state in self._chat_states.values():
                self._detach_chat_control(state)
            self._attach_active_summary()
        run_on_ui_thread(refresh)

    def on_app_event(self, event_type):
        if event_type == AppEvent.PAUSE:
            job=getattr(self,'_job',None)
            if job is not None and job.kind=='summary':run_on_ui_thread(lambda:self._minimize_job(job))
            self._chat_ui_paused = True
            def detach():
                if self._loaded and self._chat_ui_paused:
                    for state in self._chat_states.values():
                        self._detach_chat_control(state)
            run_on_ui_thread(detach)
        elif event_type == AppEvent.RESUME:
            self._chat_ui_paused = False
            run_on_ui_thread(self._attach_active_summary)

    def _sync_display_preferences(self):
        global _UI_LANGUAGE, _UI_THEME
        code = str(self.get_setting('ui_language', 'ru'))
        _UI_LANGUAGE = code if code in ('ru', 'uk', 'en') else 'ru'
        _UI_THEME = index_value(self.get_setting('ui_theme', 0), len(UI_THEMES))
        if self.get_setting('ui_language_index', None) is None:
            self.set_setting('ui_language_index', [v[0] for v in UI_LANGUAGES].index(_UI_LANGUAGE))

    def _apply_preferences(self, key, value):
        self.set_setting(key, value)
        if key == 'ui_language':
            self.set_setting('ui_language_index', [v[0] for v in UI_LANGUAGES].index(value))
        self._sync_display_preferences()
        if key=='ui_language':
            self._sync_chat_menu()
        if key=='ui_animations' and not value:
            for record in list(getattr(self,'_view_actions',{}).values()):
                self._reset_card_animation(record)
        if key == 'nick_text_colours':
            self._refresh_name_styles()
        self._refresh_settings()
        for state in getattr(self, '_chat_states', {}).values():
            button = state.get('button')
            if button is not None:
                button.setContentDescription(_tr(_tr('Сводка сообщений')))

    def _capture_before_read(self, controller, params):
        try:
            did = int(params.args[0])
            account = int(java_field(controller, 'currentAccount', -1))
            for state in list(self._chat_states.values()):
                if state['identity'][:2] == (account, did) and state['bounds'] is None:
                    state['bounds'] = opening_unread_bounds(state['fragment'], state['identity']) or separator_unread_bounds(state['fragment'])
        except Exception:
            self._event('chat_ui_failed', 'warning')

    def _open_source(self, transcript, mid):
        if int(mid) not in {entry[0] for entry in transcript.sources}:
            return
        if int(get_selected_account()) != transcript.account:
            self._notice(_tr('Переключитесь на исходный аккаунт, чтобы открыть сообщение.'))
            return
        try:
            from android.os import Bundle
            from org.telegram.ui import ChatActivity
            fragment = get_last_fragment()
            if fragment is None:
                return
            args = Bundle()
            args.putLong('user_id' if transcript.dialog_id > 0 else 'chat_id', abs(transcript.dialog_id))
            args.putInt('message_id', int(mid))
            if transcript.thread_id:
                args.putInt('topic_id', transcript.thread_id)
            dismiss_dialog(self._result_dialog)
            fragment.presentFragment(ChatActivity(args))
        except Exception:
            self._notice(_tr('Не удалось открыть сообщение в этой сборке клиента'), True)

    def _show_sources(self, transcript, summary_text, page=0):
        activity = self._compat_activity()
        if activity is None:
            return
        cited = source_ids(summary_text, [entry[0] for entry in transcript.sources])
        by_id = {entry[0]: entry for entry in transcript.sources}
        ordered = [by_id[mid] for mid in cited] + [entry for entry in transcript.sources if entry[0] not in cited]
        chunk = ordered[page*40:(page+1)*40]
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr(_tr('Источники · ') + str(len(ordered))))
        labels = [str(mid) + ' · ' + stamp + '\n' + excerpt[:100] for mid, stamp, excerpt in chunk]
        builder.set_items(labels, lambda b, index: (b.dismiss(), self._open_source(transcript, chunk[index][0])))
        if (page+1)*40 < len(ordered):
            builder.set_positive_button(_tr(_tr('Дальше')), lambda b,w:(b.dismiss(),self._show_sources(transcript,summary_text,page+1)))
        if page:
            builder.set_neutral_button(_tr(_tr('Назад')), lambda b,w:(b.dismiss(),self._show_sources(transcript,summary_text,page-1)))
        builder.set_negative_button(_tr(_tr('Закрыть')), lambda b,w:b.dismiss())
        self._show_picker(builder)

    def _recent_summary(self, identity):
        entry = getattr(self,'_summary_reopen',{}).get(identity)
        if entry is None:
            return None
        completed, data = entry
        if not 0 <= time.monotonic()-completed < self._summary_reopen_seconds():
            return None
        if int(get_selected_account()) != identity[0]:
            return None
        if not any(saved.data is data for saved in self._recent_by_account.get(identity[0],[])) and not any(saved.data is data for saved in self._chat_history_entries(identity)):
            return None
        return data

    def _summary_click(self, state, force=False):
        if not self._loaded:
            return
        try:
            current = get_last_fragment()
            if current is None:
                self._notice(_tr('Не найден открытый чат.'), True)
                return
            identity = summary_identity(current)
            if identity != state['identity'] or int(get_selected_account()) != identity[0]:
                self._event('header_context_changed', 'warning')
                self._notice(_tr('Чат или аккаунт сменился. Нажмите кнопку в текущем чате.'))
                return
            status=self._header_job_state(identity[0])
            if status=='busy' or status=='ready' and not force:
                self._open_job_indicator();return
            self._event('header_hold' if force else 'header_tap')
            # Resolve the actual visible fragment again. A stale proxy/paused flag must not swallow a visible tap.
            self.on_menu_click({'fragment': current, 'force_new': bool(force)})
        except Exception as error:
            self._notice(self._record_error(error), True)

    def _place_summary_before_menu(self, state):
        button, menu = state.get('button'), state.get('header_menu')
        if button is None or menu is None:
            return
        overflow = java_field(state['fragment'], 'headerItem')
        if overflow is None:
            return
        try:
            current, target = int(menu.indexOfChild(button)), int(menu.indexOfChild(overflow))
            if current < 0 or target < 0 or current == target-1:
                return
            params = button.getLayoutParams()
            menu.removeView(button)
            try:
                menu.addView(button, int(menu.indexOfChild(overflow)), params)
            except Exception:
                # Reordering must never strand a working button outside its parent.
                if button.getParent() is None:
                    try:
                        menu.addView(button, min(current, int(menu.getChildCount())), params)
                    except Exception:
                        menu.addView(button, params)
                self._event('header_order_fallback', 'warning')
            menu.requestLayout()
        except Exception:
            self._event('header_order_fallback', 'warning')

    def create_settings(self):
        self._sync_display_preferences()
        return self._settings_rows()

    def _appearance_rows(self):
        return [localized_setting(Selector,key='ui_language_index',text='Язык интерфейса',default=0,items=[name for code,name in UI_LANGUAGES],on_change=lambda index:self._apply_preferences('ui_language',UI_LANGUAGES[index][0])),
                localized_setting(Selector,key='ui_theme',text='Цвета интерфейса',default=0,items=[name for name,colors in UI_THEMES],on_change=lambda index:self._apply_preferences('ui_theme',index))]

    def _summary_long_click(self, state):
        self._summary_click(state, force=True)
        return True

    def _bind_header_control(self, state):
        item=state['button']
        if item is None:
            return
        listener,long_listener=self._bind_view_action(item,lambda:self._summary_click(state),lambda:self._summary_click(state,True),state)
        state['click'],state['long_click'],state['header_targets']=listener,long_listener,[item]
        icon=java_field(item,'iconView')
        if icon is not None:
            # Native touch and accessibility belong to the whole 48dp item, not two nested click targets.
            icon.setOnClickListener(None);icon.setOnLongClickListener(None)
            icon.setClickable(False);icon.setLongClickable(False)
            state['header_targets'].append(icon)
        state['button_label']=None
        item.setContentDescription(_tr('Сводка сообщений'))

    def _hook_java(self, cls, name, handler, constructors=False):
        if cls is None:
            return []
        try:
            value = self.hook_all_constructors(cls,handler) if constructors else self.hook_all_methods(cls,name,handler)
            handles = list_values(value)
            if handles:
                self._chat_hooks.extend(handles)
                return handles
        except Exception:
            pass
        result=[]
        try:
            members=cls.getDeclaredConstructors() if constructors else cls.getDeclaredMethods()
            for member in list_values(members):
                if not constructors and str(member.getName()) != name:
                    continue
                member.setAccessible(True)
                handle=self.hook_method(member,handler)
                if handle is not None:
                    result.append(handle)
            self._chat_hooks.extend(result)
        except Exception:
            pass
        return result

    def _install_view_actions(self):
        try:
            from hook_utils import find_class
            view_class=find_class('android.view.View')
            clicks=self._hook_java(view_class,'performClick',SummaryNativeViewHook(self))
            longs=self._hook_java(view_class,'performLongClick',SummaryNativeViewHook(self,True))
            self._native_click_hooks=(len(clicks),len(longs))
        except Exception:
            self._native_click_hooks=(0,0)
        self._participant_link_hooks=False
        try:
            from hook_utils import find_class
            spans=self._hook_java(find_class('android.text.style.URLSpan'),'onClick',SummaryParticipantSpanHook(self))
            try:spans+=self._hook_java(find_class('org.telegram.ui.Components.URLSpanNoUnderline'),'onClick',SummaryParticipantSpanHook(self))
            except Exception:pass
            texts=self._hook_java(find_class('android.widget.TextView'),'onTouchEvent',SummaryParticipantTextHook(self))
            self._participant_link_hooks=bool(spans and texts)
        except Exception:pass
        self._participant_paint_hook=False
        try:
            from hook_utils import find_class
            paint_hooks=[]
            for class_name in ('android.text.style.ClickableSpan','android.text.style.URLSpan','org.telegram.ui.Components.URLSpanNoUnderline'):
                try:paint_hooks+=self._hook_java(find_class(class_name),'updateDrawState',SummaryParticipantPaintHook(self))
                except Exception:pass
            self._participant_paint_hook=bool(paint_hooks)
        except Exception:pass
        self._event('native_click_ready'   if self._native_click_hooks[0] else 'native_click_unavailable','info' if self._native_click_hooks[0] else 'warning')

    def _bind_view_action(self, view, action, long_action=None, owner=None):
        ref=self._chat_view_ref(view)
        key=int(view.hashCode())
        record={'ref':ref,'action':action,'long_action':long_action,'owner':owner,'last':None}
        if not hasattr(self,'_view_actions'):
            self._view_actions={}
        self._view_actions[key]=record
        view.setEnabled(True);view.setClickable(True);view.setFocusable(True)
        view.setLongClickable(long_action is not None)
        def click(target=None,*args):
            self._native_view_action(target if target is not None else ref(),False)
        listener=None
        try:
            listener=OnClickListener(click)
            view.setOnClickListener(listener)
        except Exception:
            self._event('sdk_click_fallback','warning')
        record['click']=listener
        factory=getattr(_sdk_android,'OnLongClickListener',None)
        long_listener=None
        try:
            if callable(factory) and long_action is not None:
                long_listener=factory(lambda target=None,*args:self._native_view_action(target if target is not None else ref(),True))
            view.setOnLongClickListener(long_listener)
        except Exception:
            self._event('sdk_click_fallback','warning')
        record['long']=long_listener
        return listener,long_listener

    def _native_view_action(self, view, long_click=False):
        if not self._loaded or view is None:
            return False
        try:
            key=int(view.hashCode())
            record=getattr(self,'_view_actions',{}).get(key)
            if record is None:
                return False
            target=record['ref']()
            if target is None:
                self._view_actions.pop(key,None);return False
            if target is not view and not target.equals(view):
                return False
            callback=record['long_action'] if long_click else record['action']
            if callback is None:
                return False
            now=time.monotonic()
            if record['last'] is not None and 0 <= now-record['last'] < 0.25:
                return True
            record['last']=now
            def invoke():
                if not self._loaded:
                    return
                try:
                    self._event('native_hold' if long_click else 'native_tap')
                    callback()
                except Exception as error:
                    self._notice(self._record_error(error),True)
            run_on_ui_thread(invoke)
            return True
        except Exception:
            return False

    def _clear_view_actions(self, owner):
        self._clear_participant_links(owner)
        for key,record in list(getattr(self,'_view_actions',{}).items()):
            if record['owner'] is owner or record['ref']() is None:
                self._reset_card_animation(record)
                self._view_actions.pop(key,None)

    def _is_unread_cell(self, view):
        try:
            if self._unread_java_class is not None and self._unread_java_class.isInstance(view):
                return True
        except Exception:
            pass
        return class_name(view)=='ChatUnreadCell'

    def _open_bubble_sources(self, transcript, ids):
        valid = {entry[0] for entry in transcript.sources}
        for mid in ids:
            if mid in valid:
                self._open_source(transcript, mid)
                return

    def _bubble_content(self, activity, display, transcript, palette, owner):
        entries=summary_narrative_entries(display,transcript)
        return self._render_summary_cards(activity,entries,palette,owner,lambda mid:self._open_source(transcript,mid),transcript)

    def _install_header_touch(self):
        from hook_utils import find_class
        cls = find_class('org.telegram.ui.ActionBar.ActionBar')
        self._ui_hook_counts['header_dispatch'] = len(self._hook_java(cls, 'dispatchTouchEvent', SummaryHeaderTouchHook(self)))
        if not self._ui_hook_counts['header_dispatch']:
            # Telegram 12.5.1 inherits dispatchTouchEvent, but declares both methods below.
            # Keep hooks in the app class instead of relying on boot-framework methods.
            self._ui_hook_counts['header_intercept'] = len(self._hook_java(cls, 'onInterceptTouchEvent', SummaryHeaderInterceptHook(self)))
            self._ui_hook_counts['header_touch'] = len(self._hook_java(cls, 'onTouchEvent', SummaryHeaderTouchHook(self)))
        self._header_touch_stats = {'down': 0, 'tap': 0, 'hold': 0, 'cancel': 0}

    def _header_should_intercept(self, bar, event):
        try:
            if int(event.getActionMasked()) != 0:
                return False
            for state in self._chat_states.values():
                target = state.get('header_bar')
                if target is not None and (target is bar or target.equals(bar)) and self._chat_is_current(state):
                    return self._header_contains(state, float(event.getRawX()), float(event.getRawY()))
        except Exception:
            pass
        return False

    def _header_rect(self, view):
        try:
            from android.graphics import Rect
            if view is None or int(view.getVisibility()) != 0 or not view.isShown() or float(view.getAlpha()) <= 0:
                return None
            rect = Rect()
            if not view.getGlobalVisibleRect(rect) or rect.width() <= 0 or rect.height() <= 0:
                return None
            return (int(rect.left), int(rect.top), int(rect.right), int(rect.bottom))
        except Exception:
            return None

    def _header_contains(self, state, x, y):
        if bool(java_field(state['fragment'], 'searching', False)):
            return False
        try:
            if state['header_bar'].isActionModeShowed():
                return False
        except Exception:
            pass
        rect = self._header_rect(state.get('button'))
        if rect is None or not (rect[0] <= x < rect[2] and rect[1] <= y < rect[3]):
            return False
        overflow = self._header_rect(java_field(state['fragment'], 'headerItem'))
        # A native overflow hit must stay native even if a client has laid out overlapping rectangles.
        return overflow is None or not (overflow[0] <= x < overflow[2] and overflow[1] <= y < overflow[3])

    def _cancel_header_gesture(self, state):
        gesture = state.pop('header_gesture', None)
        if gesture is not None:
            gesture['cancelled'] = True
        try:
            state['button'].setPressed(False)
        except Exception:
            pass

    def _header_touch(self, bar, event):
        # Intercept only this plugin's visible 48dp item, before ActionBar's child/glass hit testing.
        try:
            state = next((s for s in self._chat_states.values()
                          if s.get('header_bar') is not None and
                          (s['header_bar'] is bar or s['header_bar'].equals(bar))), None)
            if state is None:
                return False
            action = int(event.getActionMasked())
            gesture = state.get('header_gesture')
            if action == 0:
                self._cancel_header_gesture(state)
                if not self._chat_is_current(state) or not self._header_contains(state, float(event.getRawX()), float(event.getRawY())):
                    return False
                slop, timeout = 12, 500
                try:
                    from android.view import ViewConfiguration
                    slop = int(ViewConfiguration.get(state['button'].getContext()).getScaledTouchSlop())
                    timeout = int(ViewConfiguration.getLongPressTimeout())
                except Exception:
                    from org.telegram.messenger import AndroidUtilities
                    slop = AndroidUtilities.dp(12)
                gesture = {'x': float(event.getRawX()), 'y': float(event.getRawY()),
                           'time': int(event.getEventTime()), 'slop': slop, 'timeout': timeout,
                           'held': False, 'cancelled': False}
                state['header_gesture'] = gesture
                state['button'].setPressed(True)
                self._header_touch_stats['down'] += 1
                self._event('header_touch_down')
                def hold():
                    if state.get('header_gesture') is not gesture or gesture['cancelled'] or gesture['held']:
                        return
                    if not self._chat_is_current(state) or self._header_rect(state.get('button')) is None:
                        return
                    gesture['held'] = True
                    self._header_touch_stats['hold'] += 1
                    try: state['button'].performHapticFeedback(0)
                    except Exception: pass
                    self._summary_click(state, True)
                run_on_ui_thread(hold, timeout)
                return True
            if gesture is None:
                return False
            if action == 3 or int(event.getPointerCount()) != 1 or not self._chat_is_current(state):
                gesture['cancelled'] = True
            elif action in (1, 2):
                dx, dy = float(event.getRawX())-gesture['x'], float(event.getRawY())-gesture['y']
                if dx*dx + dy*dy > gesture['slop']**2 or not self._header_contains(state, float(event.getRawX()), float(event.getRawY())):
                    gesture['cancelled'] = True
            if gesture['cancelled']:
                state['button'].setPressed(False)
            if action in (1, 3):
                state.pop('header_gesture', None)
                state['button'].setPressed(False)
                if not gesture['cancelled'] and not gesture['held'] and action == 1:
                    force = int(event.getEventTime())-gesture['time'] >= gesture['timeout']
                    self._header_touch_stats['hold' if force else 'tap'] += 1
                    self._summary_click(state, force)
                elif gesture['cancelled']:
                    self._header_touch_stats['cancel'] += 1
            return True
        except Exception:
            self._event('header_touch_failed', 'warning')
            return False

    def _raise_header_menu(self, state):
        menu = state.get('header_menu')
        if menu is None:
            return
        try:
            parent = menu.getParent()
            # Restore normal native z order, leaving native search/action-mode visibility intact.
            if parent is not None and int(parent.indexOfChild(menu)) != int(parent.getChildCount())-1:
                menu.bringToFront()
            if not state.get('header_layout_requested'):
                menu.requestLayout()
                state['header_bar'].requestLayout()
                state['header_layout_requested'] = True
            self._last_header_geometry = {'button': self._header_rect(state.get('button')),
                                          'overflow': self._header_rect(java_field(state['fragment'], 'headerItem'))}
        except Exception:
            pass

    def _detail_is_current(self, context):
        try:
            identity = context['detail_identity']
            return self._loaded and int(get_selected_account()) == identity[0] and summary_identity(get_last_fragment()) == identity
        except Exception:
            return False

    def _detail_defaults(self, identity):
        key = 'detailed_options_' + str(identity[0])
        try:
            raw = json.loads(str(self.get_setting(key, '{}') or '{}'))
            options=DetailedOptions(bool(raw.get('include_unread', True)), max(0, int(raw.get('prior_count', 0))),
                str(raw.get('prompt', '')), index_value(raw.get('style', 1), len(STYLES), 1),
                index_value(raw.get('language', self.get_setting('lang',0)), len(LANGS)),
                index_value(raw.get('output_index', self.get_setting('output_index',1)), len(OUTPUT_LIMITS),1),
                str(raw.get('period','')) if str(raw.get('period','')) in dict(SUMMARY_PERIODS) else '',False)
            records=self._style_catalog();key=str(raw.get('style_key','') or '')
            if key:
                chosen=next((record for record in records if record['id']==key),self._selected_style())
            elif 'style' in raw:chosen=resolve_style(records,'',options.style)
            else:chosen=self._selected_style()
            return with_detail_style(options,chosen)
        except Exception:
            return with_detail_style(DetailedOptions(),self._selected_style())


    def _save_detail_defaults(self, context, options):
        values = {name:getattr(options,name) for name in ('include_unread','prior_count','prompt','style','language','output_index','period','style_key','style_prompt','style_name')}
        self.set_setting('detailed_options_' + str(context['detail_identity'][0]), json.dumps(values, ensure_ascii=False))

    def _show_detailed(self, context=None, options=None):
        try:self._show_workspace(context,options,tab=0)
        except Exception as error:self._notice(self._record_error(error),True)






    def _detail_from_result(self, transcript):
        fragment = get_last_fragment()
        identity = (transcript.account,transcript.dialog_id,transcript.thread_id)
        if fragment is None or summary_identity(fragment) != identity:
            self._notice(_tr('Откройте исходный чат для новой сводки.')); return
        bounds = UnreadBounds(transcript.unread_read_max,transcript.unread_upper_id,transcript.unread_expected)
        self._show_detailed({'fragment':fragment,'unread_bounds':bounds if bounds.upper_id>0 else None},transcript.detail)

    def _detail_before_upload(self, job):
        if not self._loaded or self._job is not job or job.cancel.is_set() or job.approved.is_set():
            return
        fragment = get_last_fragment()
        identity = (job.account,job.dialog_id,job.thread_id)
        if fragment is None or int(get_selected_account()) != job.account or summary_identity(fragment) != identity:
            self._notice(_tr('Чат или аккаунт сменился. Откройте подробную сводку заново.'))
            return
        job.next_detail = ({'fragment':fragment,'detail_identity':identity,'unread_bounds':job.unread_bounds},job.detail)
        # The old worker must finish before a new request can be configured and started.
        self.cancel_job(job,notify=False)

    def _resume_detail_after_cancel(self, job):
        history=getattr(job,'next_history',None);job.next_history=None
        pending=getattr(job,'next_detail',None);job.next_detail=None
        if not self._loaded:return
        if history is not None:
            if self._detail_is_current(history):self._show_chat_history(history)
            return
        if pending is not None:
            context,options=pending
            if self._detail_is_current(context):self._show_detailed(context,options)

    def _share_result(self, activity, display, transcript):
        from android.content import Intent
        plain, rich = shared_summary_formats(display,transcript)
        intent = Intent(Intent.ACTION_SEND)
        # text/plain keeps Telegram and plain-text targets visible in the system chooser.
        intent.setType('text/plain')
        intent.putExtra(Intent.EXTRA_TEXT,plain)
        intent.putExtra(Intent.EXTRA_HTML_TEXT,rich)
        intent.putExtra(Intent.EXTRA_SUBJECT,_tr('Сводка сообщений'))
        activity.startActivity(Intent.createChooser(intent,_tr('Поделиться')))

    def _render_summary_cards(self, activity, entries, palette, owner, open_source, transcript=None, preview=False, query="", animate=True):
        from android.text import Html
        from org.telegram.messenger import AndroidUtilities
        design = index_value(self.get_setting('summary_design',0),len(SUMMARY_DESIGNS))
        spec = summary_design_spec(design)
        root = ui_stack(activity)
        def inactive(view):
            view.setClickable(False);view.setLongClickable(False);view.setFocusable(False)
            return view
        for number,(title,explanation,mid) in enumerate(entries,1):
            if mid is None:
                plain=ui_text(activity,title+'\n'+explanation,15,palette['text'],translate=False)
                ui_mark_matches(plain,query,palette)
                ui_add(root,plain,bottom=12);continue
            card=ui_stack(activity,spec['padding'],horizontal=design==1)
            if design==4:
                glass_background(card,palette)
            elif spec['fill']:
                ui_background(card,palette[spec['fill']],spec['radius'],palette['border'] if spec['stroke'] else None,
                              ripple=ui_mix(palette['background'],palette['accent'],0.16))
            content=card
            if design==1:
                marker=inactive(ui_text(activity,str(number).zfill(2),12,palette['muted']))
                marker.setGravity(17)
                ui_background(marker,palette['soft'],8)
                ui_add(card,marker,32,32,right=12)
                content=inactive(ui_stack(activity))
                ui_add(card,content,0,-2,weight=1)
            elif design==2:
                label=inactive(ui_text(activity,str(number).zfill(2),12,palette['accent']))
                ui_add(card,label,bottom=8)
            heading=inactive(ui_text(activity,title,spec['title'],palette['text'],True,translate=False))
            body=inactive(ui_text(activity,explanation,spec['body'],palette['text'],translate=False))
            # The card opens its source; owned name spans open participant profiles.
            names=bool(True);coloured=bool(self.get_setting('nick_text_colours',True))
            self._style_name_text(heading,Html.fromHtml(participant_markup(title,transcript,palette,coloured,names)),transcript,palette,owner,design,preview)
            self._style_name_text(body,Html.fromHtml(participant_markup(explanation,transcript,palette,coloured,names)),transcript,palette,owner,design,preview)
            heading.setLinkTextColor(palette['text']);body.setLinkTextColor(palette['text'])
            body.setLineSpacing(AndroidUtilities.dp(4),1.08)
            ui_add(content,heading,bottom=4 if design==3 else 8)
            if not preview:self._wire_name_links(heading,transcript,owner,palette,design);self._wire_name_links(body,transcript,owner,palette,design)
            ui_mark_matches(heading,query,palette);ui_mark_matches(body,query,palette)
            ui_add(content,body)
            self._bind_view_action(card,lambda mid=mid:open_source(mid),owner=owner)
            card.setFocusable(False);card.setFocusableInTouchMode(False)
            card.setContentDescription(_tr('Открыть сообщение')+': '+title+' — '+explanation[:160])
            ui_add(root,card,bottom=spec['gap'])
            if not query and animate:self._animate_card(card,number)
            if design in (1,3) and number<len(entries):
                from android.view import View
                divider=inactive(View(activity));divider.setBackgroundColor(palette['border'])
                ui_add(root,divider,-1,1,bottom=spec['gap'],left=56 if design==1 else 8,right=8)
        return root

    def _show_design_preview(self, mode='design'):
        activity=self._compat_activity()
        if activity is None:
            return
        owner=object()
        design=index_value(self.get_setting('summary_design',0),len(SUMMARY_DESIGNS))
        theme=index_value(self.get_setting('ui_theme',0),len(UI_THEMES))
        palette=ui_palette()
        root=ui_stack(activity,(20,8,20,8))
        self._summary_surface(root,palette)
        ui_add(root,ui_text(activity,_tr('Предпросмотр без запроса к AI')+' · '+_tr(SUMMARY_DESIGNS[design])+' · '+_tr(UI_THEMES[theme][0]),12,palette['muted'],translate=False),bottom=12)
        entries=[(_tr('Обсуждение лошадей'),_tr('Дима и Максим обсуждали лошадей. Договорились выбрать маршрут для прогулки.'),1),
                 (_tr('Планы на выходные'),_tr('Максим предложил встретиться в субботу. Дима уточнит время завтра.'),2)]
        preview_transcript=replace(Transcript('',0,0,0,0,0),participants=(('preview1',_tr('Дима'),'preview',0),('preview2',_tr('Максим'),'preview',0)),source_senders=((1,'preview1'),(2,'preview2')))
        content=self._render_summary_cards(activity,entries,palette,owner,lambda mid:self._notice(_tr('Это пример оформления.')),preview_transcript,preview=True)
        ui_add(root,ui_dialog_scroll(activity,content,420,0.52))
        builder=SummaryDialogBuilder(activity)
        builder.set_title((_tr('Цвета интерфейса')+' · '+_tr(UI_THEMES[theme][0])) if mode=='colors' else (_tr('Дизайн сводки')+' · '+_tr(SUMMARY_DESIGNS[design])))
        builder.set_view(root)
        def next_variant(b,w):
            b.dismiss()
            if mode=='colors':
                self._apply_preferences('ui_theme',(theme+1)%len(UI_THEMES))
            else:
                self._apply_preferences('summary_design',(design+1)%len(SUMMARY_DESIGNS))
            self._show_design_preview(mode)
        builder.set_positive_button(_tr('Следующие цвета' if mode=='colors' else 'Следующий вариант'),next_variant)
        builder.set_negative_button(_tr('Закрыть'),lambda b,w:b.dismiss())
        self._show_picker(builder,cleanup=lambda:self._clear_view_actions(owner))

    def _sync_chat_menu(self):
        if not getattr(self,'_loaded',False):
            return
        enabled=bool(self.get_setting('summary_menu',True))
        signature=(enabled,_UI_LANGUAGE)
        if getattr(self,'_chat_menu_signature',None)==signature:
            return
        ids=getattr(self,'_chat_menu_ids',{})
        # Touch only IDs owned by this plugin. Keep failures tracked to avoid duplicates.
        for slot,item_id in list(ids.items()):
            try:
                if self.remove_menu_item(item_id) is not False:
                    ids.pop(slot,None)
            except Exception:
                pass
        self._chat_menu_ids=ids
        complete=not bool(ids)
        if enabled:
            for slot,title,subtitle,icon,callback in (
                ('quick','Сводка чата','Все непрочитанные сообщения через AI','msg_info',self.on_menu_click),
                ('detail','Подробная сводка','Промпт и прочитанный контекст','msg_list',self._show_detailed),
                ('history','Сводки этого чата','Последние результаты этого чата и темы','msg_recent',self._show_chat_history)):
                if slot in ids:
                    continue
                try:
                    item_id='chat_summary_'+slot
                    result=self.add_menu_item(MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU,
                        item_id=item_id,text=_tr(title),subtext=_tr(subtitle),icon=native_icon(icon),on_click=callback))
                    if result:
                        ids[slot]=result
                    else:
                        complete=False
                except Exception:
                    complete=False
        self._chat_menu_signature=signature if complete else None

    def _summary_reopen_seconds(self):
        try:
            index=int(self.get_setting('summary_reopen_index',3))
            if not 0<=index<len(REOPEN_SECONDS):
                index=3
        except (AttributeError,TypeError,ValueError):
            index=3
        return REOPEN_SECONDS[index]

    def _summary_surface(self, root, palette):
        if index_value(self.get_setting('summary_design',0),len(SUMMARY_DESIGNS))==4:
            return glass_background(root,palette,panel=True)
        ui_background(root,palette['background'],20)
        return False

    def _animations_allowed(self):
        if not self.get_setting('ui_animations',True):
            return False
        try:
            from android.animation import ValueAnimator
            return bool(ValueAnimator.areAnimatorsEnabled())
        except Exception:
            # If the system preference cannot be read, leave content fully visible.
            return False

    def _animate_card(self, view, number):
        if number > 6 or not self._animations_allowed():
            return
        record=getattr(self,'_view_actions',{}).get(int(view.hashCode()))
        if record is None:
            return
        key=int(view.hashCode())
        def enter():
            if not getattr(self,'_loaded',False) or self._view_actions.get(key) is not record or not self._animations_allowed():
                return
            target=record['ref']()
            if target is None:
                return
            try:
                if not target.isAttachedToWindow():
                    return
                from org.telegram.messenger import AndroidUtilities
                record['animated']=True
                target.setAlpha(0.0);target.setTranslationY(float(AndroidUtilities.dp(8)))
                target.animate().alpha(1.0).translationY(0.0).setDuration(180).setStartDelay(min(max(0,number-1),5)*40).start()
            except Exception:
                self._reset_card_animation(record)
        run_on_ui_thread(enter,32)

    def _reset_card_animation(self, record):
        if not record.pop('animated',False):
            return
        target=record['ref']()
        if target is None:
            return
        try:target.animate().cancel()
        except Exception:pass
        try:target.setAlpha(1.0);target.setTranslationY(0.0)
        except Exception:pass

    def _chat_history_entries(self, identity):
        self._load_history_account(identity[0])
        store=getattr(self,'_history_store',None);owner=summary_history_owner(identity[0])
        if store is not None and owner and (identity not in self._history_chat_loaded or identity not in self._chat_history):
            try:
                entries,more=store.load(owner,identity[0],identity[1],identity[2],self._history_page_limits.get(identity,20))
                self._chat_history[identity]=[self._intern_history(item) for item in entries]
                self._history_more[identity]=more;self._history_chat_loaded.add(identity)
            except Exception:self._event('history_store_failed','warning')
        values=getattr(self,'_chat_history',{}).get(identity,())
        if values:return list(values)
        return [saved for saved in getattr(self,'_recent_by_account',{}).get(identity[0],())
                if (saved.data[1].account,saved.data[1].dialog_id,saved.data[1].thread_id)==identity]


    def _show_chat_history(self, context=None):
        try:self._show_workspace(context,tab=1,history=True)
        except Exception as error:self._notice(self._record_error(error),True)


    def _show_read_setup(self, context, bounds=None):
        fragment=context.get('fragment') or get_last_fragment()
        identity=summary_identity(fragment)
        options=self._detail_defaults(identity)
        options=replace(options,include_unread=False,style=index_value(self.get_setting('style',0),len(STYLES)),
            language=index_value(self.get_setting('lang',0),len(LANGS)),
            output_index=index_value(self.get_setting('output_index',1),len(OUTPUT_LIMITS),1))
        options=with_detail_style(options,self._selected_style())
        self._show_detailed(dict(context,fragment=fragment,detail_identity=identity,unread_bounds=bounds,
                                 focus_read_count=True,read_setup=True),options)


    def _focus_detail_count(self, context, field, owner):
        def focus():
            if not self._detail_is_current(context):return
            if not any(record['owner'] is owner for record in getattr(self,'_view_actions',{}).values()):return
            try:
                if not field.isAttachedToWindow():return
                field.requestFocus();field.setSelection(len(str(field.getText())))
                from org.telegram.messenger import AndroidUtilities
                AndroidUtilities.showKeyboard(field)
            except Exception:pass
        run_on_ui_thread(focus,80)

    def _detail_form(self, activity, context, options, owner, builder, embedded=False):
        from android.widget import EditText
        from android.text import InputType
        from org.telegram.messenger import AndroidUtilities
        palette=ui_palette();root=ui_stack(activity,(16,0,16,12));content=ui_stack(activity)
        root.setFocusableInTouchMode(True);root.requestFocus()
        bounds=context.get('unread_bounds')
        has_unread=bool(bounds is not None and bounds.upper_id>bounds.read_max)
        state={'mode':initial_detail_mode(options,has_unread),'closed':False,
               'period_choice':options.period or 'day'}
        catalog=self._style_catalog() or [neutral_style()]
        selected_style=resolve_style(catalog,options.style_key,options.style)
        selections={name:getattr(options,name) for name in ('style','language','output_index')}
        selections['catalog']=tuple(dict(record) for record in catalog)
        selections['style']=next(i for i,record in enumerate(catalog) if record['id']==selected_style['id'])
        children=[];fields={}
        def heading(title,top=16):
            ui_add(content,ui_text(activity,title,13,palette['muted']),top=top,bottom=8)
        def input_style(field):
            field.setTextSize(15.0);field.setTextColor(palette['text']);field.setHintTextColor(palette['muted'])
            field.setPadding(*(AndroidUtilities.dp(12) for _ in range(4)))
            field.setMinimumHeight(AndroidUtilities.dp(48));ui_background(field,palette['soft'],12)
        heading('Режим сводки',top=4)
        mode_row=ui_stack(activity,(16,12,12,12),horizontal=True)
        mode_labels=ui_stack(activity)
        mode_title=ui_text(activity,'',15,palette['text'],True,translate=False)
        mode_description=ui_text(activity,'',13,palette['muted'],translate=False)
        ui_add(mode_labels,mode_title);ui_add(mode_labels,mode_description,top=4)
        ui_add(mode_row,mode_labels,0,-2,weight=1)
        arrow=ui_text(activity,'›',20,palette['muted']);arrow.setGravity(17);ui_add(mode_row,arrow,24,-2,left=8)
        ui_background(mode_row,palette['soft'],12,ripple=ui_mix(palette['soft'],palette['text'],0.1))
        mode_row.setMinimumHeight(AndroidUtilities.dp(56));ui_add(content,mode_row)
        count_holder=ui_stack(activity)
        count_title=ui_text(activity,'Прочитанных сообщений',13,palette['muted'])
        ui_add(count_holder,count_title,top=16,bottom=8)
        count=EditText(activity);count.setInputType(InputType.TYPE_CLASS_NUMBER);count.setSingleLine(True)
        count.setText(str(options.prior_count or 100));count.setHint(_tr('Например: 100'));input_style(count)
        ui_add(count_holder,count)
        count_hint=ui_text(activity,'Все непрочитанные и выбранное число прочитанных перед ними.' if has_unread else
            'Непрочитанных нет: будут взяты последние прочитанные сообщения.',12,palette['muted'])
        ui_add(count_holder,count_hint,top=8);ui_add(content,count_holder)
        period_holder=ui_stack(activity)
        period_row=ui_stack(activity,(16,12,12,12),horizontal=True)
        ui_add(period_row,ui_text(activity,'Период',13,palette['muted']),0,-2,weight=1)
        period_value=ui_text(activity,'',15,palette['text'],translate=False);ui_add(period_row,period_value,-2,-2,left=8)
        arrow=ui_text(activity,'›',20,palette['muted']);arrow.setGravity(17);ui_add(period_row,arrow,24,-2,left=8)
        ui_background(period_row,palette['soft'],12,ripple=ui_mix(palette['soft'],palette['text'],0.1))
        period_row.setMinimumHeight(AndroidUtilities.dp(56));ui_add(period_holder,period_row,top=12)
        if context['detail_identity'][2]:
            ui_add(period_holder,ui_text(activity,'В открытой теме анализируется история этой темы.',12,palette['muted']),top=8)
        ui_add(content,period_holder)
        def update_modes():
            key,title,description=next(item for item in DETAIL_MODES if item[0]==state['mode'])
            if key=='with_read' and not has_unread:
                description='Непрочитанных нет: будут взяты последние прочитанные сообщения.'
            mode_title.setText(_tr(title));mode_description.setText(_tr(description))
            mode_row.setContentDescription(_tr('Режим сводки')+': '+_tr(title))
            count_holder.setVisibility(0 if key=='with_read' else 8)
            period_holder.setVisibility(0 if key=='period' else 8)
            period_value.setText(period_label(state['period_choice']))
            if key!='with_read':
                try:count.clearFocus();AndroidUtilities.hideKeyboard(count)
                except Exception:pass
        def choose_mode():
            if state['closed']:return
            dialog=SummaryDialogBuilder(activity);dialog.set_title(_tr('Режим сводки'))
            def selected(b,index):
                b.dismiss()
                if not state['closed']:
                    state['mode']=DETAIL_MODES[int(index)][0];error.setText('');update_modes()
            dialog.set_items([('✓  ' if key==state['mode'] else '')+_tr(title) for key,title,_ in DETAIL_MODES],selected)
            dialog.set_negative_button(_tr('Отмена'),lambda b,w:b.dismiss());children.append(dialog);dialog.show()
        self._bind_view_action(mode_row,choose_mode,owner=owner)
        def choose_period():
            if state['closed'] or state['mode']!='period':return
            dialog=SummaryDialogBuilder(activity);dialog.set_title(_tr('Период'))
            def selected(b,index):
                b.dismiss()
                if not state['closed'] and state['mode']=='period':
                    state['period_choice']=SUMMARY_PERIODS[int(index)][0];update_modes()
            dialog.set_items([('✓  ' if key==state['period_choice'] else '')+_tr(label) for key,label in SUMMARY_PERIODS],selected)
            dialog.set_negative_button(_tr('Отмена'),lambda b,w:b.dismiss());children.append(dialog);dialog.show()
        self._bind_view_action(period_row,choose_period,owner=owner)
        heading('Что выделить в сводке')
        prompt=EditText(activity);prompt.setSingleLine(False)
        prompt.setInputType(InputType.TYPE_CLASS_TEXT|InputType.TYPE_TEXT_FLAG_MULTI_LINE|InputType.TYPE_TEXT_FLAG_CAP_SENTENCES)
        prompt.setText(options.prompt);prompt.setHint(_tr('Необязательно: решения, задачи или причины спора'))
        input_style(prompt);prompt.setMinLines(2);prompt.setMaxLines(4);prompt.setGravity(48)
        ui_add(content,prompt)
        heading('Ответ')
        answer=self._menu_group(activity,palette)
        choices_list=[('style','Стиль сводки',[style_title(record) for record in catalog]),('language','Язык ответа',LANGS),('output_index','Объём ответа',['Небольшой','Обычный','Большой','Максимальный'])]
        for number,(name,title,choices) in enumerate(choices_list):
            row=ui_stack(activity,(16,12,12,12),horizontal=True)
            labels=ui_stack(activity)
            ui_add(labels,ui_text(activity,title,13,palette['muted']))
            value=ui_text(activity,choices[selections[name]],15,palette['text'],translate=name!='style')
            ui_add(labels,value,top=4);ui_add(row,labels,0,-2,weight=1)
            arrow=ui_text(activity,'›',20,palette['muted']);arrow.setGravity(17);ui_add(row,arrow,24,-2,left=8)
            row.setMinimumHeight(AndroidUtilities.dp(56))
            ui_background(row,palette['soft'],12,ripple=ui_mix(palette['soft'],palette['text'],0.1))
            def choose(name=name,title=title,choices=choices,value=value):
                if state['closed']:return
                dialog=SummaryDialogBuilder(activity);dialog.set_title(_tr(title))
                labels=[('✓  ' if i==selections[name] else '')+(label if name=='style' else _tr(label)) for i,label in enumerate(choices)]
                def selected(b,index):
                    b.dismiss()
                    if not state['closed']:
                        selections[name]=int(index);value.setText(choices[int(index)] if name=='style' else _tr(choices[int(index)]))
                dialog.set_items(labels,selected)
                dialog.set_negative_button(_tr('Отмена'),lambda b,w:b.dismiss())
                children.append(dialog);dialog.show()
            self._bind_view_action(row,choose,owner=owner);ui_add(answer,row);fields[name]=row
            if number<2:self._menu_divider(activity,answer,palette)
        ui_add(content,answer)
        error=ui_text(activity,'',13,palette['warning'],translate=False);ui_add(content,error,top=8)
        if embedded:ui_add(root,ui_reading_scroll(activity,content),-1,0,weight=1)
        else:ui_add(root,ui_dialog_scroll(activity,content,480,0.58))
        def create():
            try:
                if state['closed']:return
                if not self._detail_is_current(context):raise SummaryError('detail_context','Чат или аккаунт сменился. Откройте подробную сводку заново.')
                selected=selected_detail_options(options,state['mode'],has_unread,count.getText(),prompt.getText(),
                    selections,state['period_choice'],False)
                self._save_detail_defaults(context,selected)
                try:AndroidUtilities.hideKeyboard(count);AndroidUtilities.hideKeyboard(prompt)
                except Exception:pass
                builder.dismiss();self.on_menu_click(dict(context,detail=selected,force_new=True))
            except Exception as exception:
                error.setText(_tr(self._record_error(exception)))
                if getattr(exception,'code','') in ('detail_count','detail_empty'):count.setError(_tr('Введите количество'));count.requestFocus()
        create_button=ui_text(activity,'Создать сводку',15,ui_contrast(palette['accent']),True)
        create_button.setGravity(17);create_button.setPadding(*(AndroidUtilities.dp(12) for _ in range(4)))
        create_button.setMinimumHeight(AndroidUtilities.dp(48));ui_background(create_button,palette['accent'],12)
        self._bind_view_action(create_button,create,owner=owner);ui_add(root,create_button,top=12)
        def cleanup():
            state['closed']=True
            for dialog in children:dismiss_dialog(dialog)
            try:AndroidUtilities.hideKeyboard(count);AndroidUtilities.hideKeyboard(prompt)
            except Exception:pass
        update_modes()
        fields.update(prior_count=count,prompt=prompt,create=create_button,error=error,cleanup=cleanup,
                      selections=selections,state=state,mode=mode_row,mode_title=mode_title,mode_description=mode_description,
                      count_holder=count_holder,period_holder=period_holder,period=period_row)
        return root,fields



    def _open_participant(self, account, participant):
        if not self._loaded:return
        if int(get_selected_account())!=account:
            self._notice(_tr('Переключитесь на исходный аккаунт, чтобы открыть профиль.'));return
        key,name,kind,number=participant
        if number<=0 or kind not in ('user_id','channel_id','chat_id'):return
        try:
            from android.os import Bundle
            from org.telegram.ui import ProfileActivity
            fragment=get_last_fragment()
            if fragment is None:return
            args=Bundle();args.putLong('user_id' if kind=='user_id' else 'chat_id',number)
            dismiss_dialog(getattr(self,'_result_dialog',None))
            fragment.presentFragment(ProfileActivity(args))
        except Exception:self._notice(_tr('Не удалось открыть профиль в этой сборке клиента.'),True)

    def _wire_name_links(self, view, transcript, owner, palette=None, design=0):
        if transcript is None or not getattr(self,'_participant_link_hooks',False):return
        try:
            from android.text.style import URLSpan
            from android.text.method import LinkMovementMethod
            text=view.getText();spans=list_values(text.getSpans(0,int(text.length()),URLSpan))
            people={p[0]:p for p in transcript.participants}
            owned={}
            for span in spans:
                url=str(span.getURL())
                if not url.startswith('summary-user:'):continue
                participant=people.get(url[len('summary-user:'):])
                if participant is None:continue
                key=int(span.hashCode());owned[key]=span
                self._participant_spans[key]={'ref':self._chat_view_ref(span),'owner':owner,'account':transcript.account,'participant':participant,'transcript':transcript,'palette':palette or ui_palette(),'design':design}
            if not owned:return
            self._participant_texts[int(view.hashCode())]={'ref':self._chat_view_ref(view),'owner':owner,'spans':owned,'gesture':None}
            view.setMovementMethod(LinkMovementMethod.getInstance());view.setLinksClickable(True)
            view.setClickable(False);view.setLongClickable(False);view.setFocusable(False)
        except Exception:
            # Preserve native text if the client cannot register span metadata.
            pass

    def _participant_span_action(self, span):
        try:
            record=getattr(self,'_participant_spans',{}).get(int(span.hashCode()))
            if record is None:return False
            target=record['ref']()
            if target is None or (target is not span and not target.equals(span)):return False
            if self._loaded:
                run_on_ui_thread(lambda:self._open_participant(record['account'],record['participant']))
            return True
        except Exception:return False

    def _participant_span_at(self, view, event, record):
        try:
            from android.text.style import URLSpan
            layout=view.getLayout()
            x=float(event.getX())-int(view.getTotalPaddingLeft())+int(view.getScrollX())
            y=float(event.getY())-int(view.getTotalPaddingTop())+int(view.getScrollY())
            if layout is None or x<0 or y<0 or y>=layout.getHeight():return None
            line=layout.getLineForVertical(int(y))
            if x<layout.getLineLeft(line) or x>=layout.getLineRight(line):return None
            # Replacement spans can map their right half to the exclusive end offset.
            # Test the full visual link rectangle before the character-offset fallback.
            text=view.getText()
            for key,span in record['spans'].items():
                try:
                    start,end=text.getSpanStart(span),text.getSpanEnd(span)
                    if layout.getLineForOffset(start)!=line:continue
                    first=float(layout.getPrimaryHorizontal(start))
                    last=float(layout.getPrimaryHorizontal(end)) if layout.getLineForOffset(end)==line else float(layout.getLineRight(line))
                    if min(first,last)<=x<max(first,last):return key
                except Exception:pass
            offset=layout.getOffsetForHorizontal(line,x)
            text=view.getText()
            for span in list_values(text.getSpans(offset,offset,URLSpan)):
                key=int(span.hashCode())
                if key in record['spans'] and text.getSpanStart(span)<=offset<text.getSpanEnd(span):return key
        except Exception:pass
        return None

    def _participant_text_touch(self, view, event):
        try:
            record=getattr(self,'_participant_texts',{}).get(int(view.hashCode()))
            if record is None:return None
            target=record['ref']()
            if target is None or (target is not view and not target.equals(view)):return None
            action=int(event.getActionMasked());gesture=record.get('gesture')
            if not self._loaded:record['gesture']=None;return False
            if action==0:
                record['gesture']=None
                key=self._participant_span_at(view,event,record)
                if key is None:return False
                record['gesture']={'key':key,'x':float(event.getX()),'y':float(event.getY()),'cancel':False}
                return True
            if gesture is None:return False
            if action==2:
                from org.telegram.messenger import AndroidUtilities
                if abs(float(event.getX())-gesture['x'])+abs(float(event.getY())-gesture['y'])>AndroidUtilities.dp(8):gesture['cancel']=True
                return True
            if action in (3,5,6):record['gesture']=None;return True
            if action==1:
                record['gesture']=None
                if not gesture['cancel'] and self._participant_span_at(view,event,record)==gesture['key']:
                    self._participant_span_action(record['spans'][gesture['key']])
                return True
            return True
        except Exception:return False

    def _clear_participant_links(self, owner):
        for mapping in (getattr(self,'_participant_spans',{}),getattr(self,'_participant_texts',{}),getattr(self,'_name_style_views',{})):
            for key,record in list(mapping.items()):
                if record['owner'] is owner or record['ref']() is None:mapping.pop(key,None)

    def _menu_group(self, activity, palette):
        group=ui_stack(activity)
        ui_background(group,palette['soft'],12)
        try:group.setClipToOutline(True)
        except Exception:pass
        return group

    def _menu_row(self, activity, title, subtitle, palette, action, owner):
        from org.telegram.messenger import AndroidUtilities
        row=ui_stack(activity,(16,12,16,12),horizontal=True)
        labels=ui_stack(activity)
        heading=ui_text(activity,title,15,palette['text'],True,translate=False)
        ui_add(labels,heading)
        if subtitle:ui_add(labels,ui_text(activity,subtitle,12,palette['muted'],translate=False),top=4)
        ui_add(row,labels,0,-2,weight=1)
        arrow=ui_text(activity,'›',22,palette['muted'],translate=False)
        arrow.setGravity(17);ui_add(row,arrow,20,-1,left=12)
        row.setMinimumHeight(AndroidUtilities.dp(52))
        for child in (labels,heading,arrow):child.setClickable(False);child.setFocusable(False)
        self._bind_view_action(row,action,owner=owner)
        row.setContentDescription(title+('. '+subtitle if subtitle else ''))
        return row

    def _menu_divider(self, activity, parent, palette):
        from android.view import View
        line=View(activity);line.setBackgroundColor(palette['border'])
        ui_add(parent,line,-1,1,left=16,right=16)

    def _history_before_upload(self, job):
        if not self._loaded or self._job is not job or job.cancel.is_set() or job.approved.is_set():return
        fragment=get_last_fragment();identity=(job.account,job.dialog_id,job.thread_id)
        if fragment is None or int(get_selected_account())!=job.account or summary_identity(fragment)!=identity:
            self._notice(_tr('Чат или аккаунт сменился. Откройте историю заново.'));return
        job.next_history={'fragment':fragment,'detail_identity':identity}
        self.cancel_job(job,notify=False)

    def _participant_span_paint(self, span, paint):
        try:
            record=getattr(self,'_participant_spans',{}).get(int(span.hashCode()))
            if record is None or not self._loaded:return False
            target=record['ref']()
            if target is None or (target is not span and not target.equals(span)):return False
            palette=record.get('palette') or ui_palette()
            style=name_span_style(record['participant'],record.get('transcript') or Transcript('',0,0,0,0,0),palette,
                record.get('design',0),bool(self.get_setting('nick_text_colours',True)),False)
            paint.setColor(style['ink']);paint.setUnderlineText(False)
            return True
        except Exception:return False

    def _style_name_text(self, view, source, transcript, palette, owner, design=0, preview=False):
        view.setText(source)
        if transcript is None:return
        try:
            from android.text import SpannableStringBuilder,Spanned
            from android.text.style import URLSpan,ForegroundColorSpan
            from org.telegram.ui.Components import URLSpanNoUnderline
            value=SpannableStringBuilder(source);people={p[0]:p for p in transcript.participants};ranges=[]
            for span in list_values(value.getSpans(0,int(value.length()),URLSpan)):
                url=str(span.getURL())
                person=people.get(url[len('summary-user:'):]) if url.startswith('summary-user:') else None
                if person is None:continue
                start,end=value.getSpanStart(span),value.getSpanEnd(span)
                # Telegram's own span clears the underline AFTER Android paints the link.
                try:replacement=URLSpanNoUnderline(url,True)
                except Exception:replacement=URLSpanNoUnderline(url)
                value.removeSpan(span)
                value.setSpan(replacement,start,end,Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
                ranges.append((start,end,person))
            if preview:
                plain=str(value.toString())
                for person in transcript.participants:
                    for found in re.finditer(r'(?<!\w)'+re.escape(participant_label(person,transcript,True))+r'(?!\w)',plain):
                        ranges.append((utf16_offset(plain,found.start()),utf16_offset(plain,found.end()),person))
            for start,end,person in ranges:
                style=name_span_style(person,transcript,palette,design,bool(self.get_setting('nick_text_colours',True)),False)
                value.setSpan(ForegroundColorSpan(style['ink']),start,end,Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
            view.setText(value)
            self._last_name_style_counts={'names':len(ranges),'clouds':0,'span_fallback':False}
        except Exception:
            self._last_name_style_counts={'span_fallback':True}
        if not hasattr(self,'_name_style_views'):self._name_style_views={}
        self._name_style_views[int(view.hashCode())]={'ref':self._chat_view_ref(view),'source':source,'transcript':transcript,
            'palette':palette,'owner':owner,'design':design,'preview':preview}

    def _refresh_name_styles(self):
        for key,record in list(getattr(self,'_name_style_views',{}).items()):
            view=record['ref']()
            if view is None:self._name_style_views.pop(key,None);continue
            self._style_name_text(view,record['source'],record['transcript'],record['palette'],record['owner'],record['design'],record['preview'])
            if not record['preview']:self._wire_name_links(view,record['transcript'],record['owner'],record['palette'],record['design'])
            try:view.invalidate()
            except Exception:pass

    def _migrate_settings(self):
        if self.get_setting("settings_schema", 0) == 3:
            return
        p = index_value(self.get_setting("provider", 0), len(PROVIDERS))
        prefix = PROVIDER_KEYS[p]
        old_key = str(self.get_setting("api_key", "") or "").strip()
        old_model = str(self.get_setting("model", "") or "").strip()
        if old_key and p != PROVIDER_OLLAMA:
            if self.get_setting(prefix + "_api_key", None) is None:
                self.set_setting(prefix + "_api_key", old_key)
            self.set_setting("api_key", "")
        # A shared key left over while Ollama was selected is not sent to Ollama automatically.
        if old_model and self.get_setting(prefix + "_model", None) is None:
            if p == PROVIDER_GEMINI and old_model.removeprefix("models/") in RETIRED_GEMINI:
                old_model = ""
                self.set_setting("model_migration_notice", True)
            self.set_setting(prefix + "_model", old_model)
        self.set_setting("settings_schema", 3)

    def on_plugin_unload(self):
        self._event("disabled")
        self._loaded = False
        states = list(self._chat_states.values())
        self._chat_states.clear()
        for handle in self._chat_hooks:
            try:
                self.unhook_method(handle)
            except Exception:
                pass
        self._chat_hooks.clear()
        with self._lock:
            job = self._job
        if job is not None:
            self._event_cancel_requested(job)
            job.cancel.set()
            cancel_telegram(job)
        picker, result_dialog = self._picker, self._result_dialog
        self._picker = self._result_dialog = None
        self._result_dialog_account = None
        self._last_by_account.clear()
        self._recent_by_account.clear()
        self._summary_reopen.clear()
        getattr(self,'_chat_history',{}).clear()
        getattr(self,'_workspace_surfaces',{}).clear()
        getattr(self,'_summary_ready',{}).clear()
        getattr(self,'_history_ids',{}).clear()
        animation_records=list(self._view_actions.values())
        self._view_actions.clear()
        getattr(self,'_participant_spans',{}).clear()
        getattr(self,'_participant_texts',{}).clear()
        getattr(self,'_name_style_views',{}).clear()
        getattr(self,'_header_bitmaps',{}).clear()
        self._connection_checks.clear()
        factory, self._header_factory = self._header_factory, None

        def cleanup():
            for record in animation_records:
                self._reset_card_animation(record)
            for state in states:
                self._detach_chat_control(state)
            dismiss_dialog(picker)
            dismiss_dialog(result_dialog)
            if job is not None:
                self._close_job_dialog(job)
                job.activity = None
            if factory is not None:
                try:
                    factory.release()
                except Exception:
                    pass
        run_on_ui_thread(cleanup)

    def _reasoning_rows(self, provider, model):
        levels=reasoning_levels(provider,model)
        if not levels:return []
        value=str(self.get_setting(reasoning_setting_key(provider,model),'') or '')
        return [localized_setting(Text,text='Рассуждения',subtext=reasoning_label(value),icon=native_icon('msg_settings'),
            on_click=lambda view:self._show_reasoning(provider,model))]

    def _show_reasoning(self, provider, model):
        activity=self._compat_activity()
        if activity is None:return
        levels=('',)+reasoning_levels(provider,model)
        key=reasoning_setting_key(provider,model);value=str(self.get_setting(key,'') or '')
        builder=SummaryDialogBuilder(activity);builder.set_title(_tr('Рассуждения'))
        builder.set_message(model)
        def selected(dialog,index):
            index=int(index)
            if not 0<=index<len(levels):return
            self.set_setting(key,levels[index],reload_settings=True);dialog.dismiss()
        builder.set_items([('✓  ' if level==value else '')+reasoning_label(level) for level in levels],selected)
        builder.set_negative_button(_tr('Отмена'),lambda b,w:b.dismiss());self._show_picker(builder)


    def _init_history_store(self):
        self._history_store=None;self._history_accounts={};self._history_chat_loaded=set();self._history_page_limits={};self._history_more={}
        self._history_ids={}
        try:self._history_store=SummaryHistoryStore(summary_history_root())
        except Exception:self._event('history_store_failed','warning')
        self._load_history_account(int(get_selected_account()))

    def _load_history_account(self,account):
        store=getattr(self,'_history_store',None);owner=summary_history_owner(account)
        if store is None or not owner:return
        accounts=self._history_accounts
        if accounts.get(account)==owner:return
        # A Telegram account slot may be reused after logout: never reuse another user's cache.
        if account in accounts:
            self._recent_by_account.pop(account,None);self._last_by_account.pop(account,None)
            for identity in list(self._chat_history):
                if identity[0]==account:self._chat_history.pop(identity,None)
            for identity in list(self._summary_reopen):
                if identity[0]==account:self._summary_reopen.pop(identity,None)
            self._history_chat_loaded={key for key in self._history_chat_loaded if key[0]!=account}
        try:
            entries,_=store.load(owner,account,limit=HISTORY_LIMIT)
            entries=[self._intern_history(item) for item in entries]
            self._recent_by_account[account]=entries
            if entries:self._last_by_account[account]=entries[0].data
            for saved in entries:
                tr=saved.data[1];age=time.time()-saved.created_epoch
                if 0<=age<self._summary_reopen_seconds():self._summary_reopen[(account,tr.dialog_id,tr.thread_id)]=(time.monotonic()-age,saved.data)
            accounts[account]=owner
        except Exception:self._event('history_store_failed','warning')

    def _intern_history(self,saved):
        key=(saved.owner_uid,saved.record_id,saved.data[1].account)
        cache=self._history_ids
        previous=cache.get(key)
        if previous is not None:return previous
        cache[key]=saved
        if len(cache)>1000:cache.pop(next(iter(cache)))
        return saved

    def _history_has_more(self,identity):
        return bool(getattr(self,'_history_more',{}).get(identity,False))

    def _load_more_history(self,identity):
        self._history_page_limits[identity]=self._history_page_limits.get(identity,20)+20
        self._history_chat_loaded.discard(identity)

    def _save_completed_summary(self,job,result,transcript):
        check_cancel(job.cancel)
        saved=SavedSummary((result,replace(transcript,text='',chunks=()),job.config.provider,job.config.model),
            datetime.now().astimezone().strftime('%d.%m.%Y · %H:%M'),uuid.uuid4().hex,
            getattr(job,'owner_uid',0),time.time())
        store=getattr(self,'_history_store',None)
        if store is not None and saved.owner_uid:
            try:
                store.put(saved);job.history_saved=True
                if job.cancel.is_set():store.remove(saved.owner_uid,saved.record_id)
            except Exception:job.history_failed=True;self._event('history_store_failed','warning')
        else:job.history_failed=True
        return saved

    def _forget_saved_summary(self,account,data):
        saved=next((entry for entry in self._recent_by_account.get(account,()) if entry.data is data),None)
        store=getattr(self,'_history_store',None)
        if store is not None and saved is not None and saved.owner_uid and saved.record_id:
            store.remove(saved.owner_uid,saved.record_id)
        for identity,entries in list(getattr(self,'_chat_history',{}).items()):
            if identity[0]==account:entries[:]=[entry for entry in entries if entry.data is not data]
        for identity,item in list(getattr(self,'_summary_reopen',{}).items()):
            if item[1] is data:self._summary_reopen.pop(identity,None)
        ready=getattr(self,'_summary_ready',{}).get(account)
        if ready is not None and (ready.data is data or saved is not None and ready.record_id==saved.record_id):
            self._summary_ready.pop(account,None)
        self._invalidate_history_account(account)

    def _invalidate_history_account(self,account):
        if hasattr(self,'_history_chat_loaded'):self._history_chat_loaded={key for key in self._history_chat_loaded if key[0]!=account}
        if hasattr(self,'_history_ids'):self._history_ids={key:item for key,item in self._history_ids.items() if item.data[1].account!=account}

    def _minimize_job(self,job):
        if not self._loaded or self._job is not job or job.cancel.is_set():return
        job.background=True;job.suppress_auto_result=True
        self._close_job_dialog(job);job.activity=None;self._refresh_job_indicator()

    def _resume_job(self,job):
        if self._job is not job or job.cancel.is_set() or int(get_selected_account())!=job.account:return
        if getattr(job,'owner_uid',0) and summary_history_owner(job.account)!=job.owner_uid:return
        fragment=get_last_fragment();activity=fragment.getParentActivity() if fragment is not None else None
        if not activity_alive(activity):return
        job.activity=activity;job.background=False
        self._show_progress(job,getattr(job,'progress_text','Готовлю сводку…'))


    def _open_job_indicator(self):
        account=int(get_selected_account());job=getattr(self,'_job',None)
        if job is not None and job.kind=='summary' and job.account==account:self._resume_job(job);return
        ready=getattr(self,'_summary_ready',{}).pop(account,None)
        if ready is None:return
        if ready.owner_uid and ready.owner_uid!=summary_history_owner(account):return
        fragment=get_last_fragment();activity=fragment.getParentActivity() if fragment is not None else None
        if activity_alive(activity):self._show_result(activity,*ready.data)
        self._refresh_job_indicator()

    def _refresh_job_indicator(self):
        if not getattr(self,'_loaded',False):return
        self._attach_active_summary()
        for state in list(getattr(self,'_chat_states',{}).values()):
            try:self._update_job_indicator(state)
            except Exception:pass

    def _detach_job_indicator(self,state):
        record=state.pop('header_job_indicator',None)
        if record is not None:
            for child in (record['spinner'],record['check']):
                try:
                    parent=child.getParent()
                    if parent is not None:parent.removeView(child)
                except Exception:pass
            icon=record.get('icon')
            if icon is not None:
                try:icon.setVisibility(record.get('icon_visibility',0))
                except Exception:pass
        item=state.get('button')
        if item is not None:
            try:item.setAlpha(1.0);item.setActivated(False)
            except Exception:pass
        # Clean up a stale 3.28 chat overlay if a fork retained its state.
        previous=state.pop('job_indicator',None)
        if previous is not None:
            try:
                parent=previous['view'].getParent()
                if parent is not None:parent.removeView(previous['view'])
            except Exception:pass


    def _update_job_indicator(self,state):
        item=state.get('button')
        if item is None:return
        status=self._header_job_state(state['identity'][0]) if self._chat_is_current(state) else 'idle'
        record=state.get('header_job_indicator')
        if record is not None and record['item']!=item:
            self._detach_job_indicator(state);record=None
        label=self._header_job_label(state,self._recent_summary(state['identity']))
        if state.get('button_label')!=label:
            item.setContentDescription(label);state['button_label']=label
        if status=='idle':
            if record is not None:
                record['spinner'].setVisibility(8);record['check'].setVisibility(8)
                if record['icon'] is not None:record['icon'].setVisibility(record['icon_visibility'])
            self._header_status_fallback(state,'idle');return
        if record is None and time.monotonic()<state.get('header_status_retry_at',0):
            self._header_status_fallback(state,status);return
        if record is None:
            added=[]
            try:
                from android.widget import FrameLayout,ProgressBar
                from org.telegram.messenger import AndroidUtilities
                activity=state['fragment'].getParentActivity();dp=AndroidUtilities.dp
                spinner=ProgressBar(activity);spinner.setIndeterminate(True)
                spinner.setMinimumWidth(0);spinner.setMinimumHeight(0)
                check=ui_text(activity,'✓',10,ui_contrast(ui_palette()['accent']),True)
                check.setGravity(17);ui_background(check,ui_palette()['accent'],7)
                for child in (spinner,check):
                    child.setClickable(False);child.setLongClickable(False);child.setFocusable(False)
                    child.setImportantForAccessibility(2)
                item.addView(spinner,FrameLayout.LayoutParams(dp(22),dp(22),17));added.append(spinner)
                params=FrameLayout.LayoutParams(dp(14),dp(14),85);params.rightMargin=dp(3);params.bottomMargin=dp(4)
                item.addView(check,params);added.append(check)
                icon=java_field(item,'iconView')
                record={'item':item,'spinner':spinner,'check':check,'icon':icon,
                        'icon_visibility':int(icon.getVisibility()) if icon is not None else 0,'colour':None}
                state['header_job_indicator']=record;state.pop('header_status_retry_at',None)
            except Exception:
                for child in added:
                    try:item.removeView(child)
                    except Exception:pass
                state['header_status_retry_at']=time.monotonic()+5.0
                self._event('header_status_fallback','warning');self._header_status_fallback(state,status);return
        try:
            accent=ui_palette()['accent']
            if record.get('accent')!=accent:
                record['check'].setTextColor(ui_contrast(accent));ui_background(record['check'],accent,7);record['accent']=accent
            colour=header_theme_colour(state['fragment'])
            if colour is None:colour=ui_palette()['text']
            if record['colour']!=colour:
                from android.content.res import ColorStateList
                record['spinner'].setIndeterminateTintList(ColorStateList.valueOf(ui_signed(colour)))
                record['colour']=colour
        except Exception:pass
        record['spinner'].setVisibility(0 if status=='busy' else 8)
        record['check'].setVisibility(0 if status=='ready' else 8)
        if record['icon'] is not None:record['icon'].setVisibility(4 if status=='busy' else record['icon_visibility'])
        item.setAlpha(1.0);item.setActivated(status=='ready')


    def _job_dialog_dismissed(self,job,dialog):
        if job.dialog is dialog and not getattr(job,'closing_dialog',False):self._minimize_job(job)



    def _header_job_state(self,account):
        owner=summary_history_owner(account);job=getattr(self,'_job',None)
        if job is not None and job.kind=='summary' and job.account==account and not job.cancel.is_set():
            if not getattr(job,'owner_uid',0) or job.owner_uid==owner:return 'busy'
        ready=getattr(self,'_summary_ready',{}).get(account)
        if ready is not None:
            if not ready.owner_uid or ready.owner_uid==owner:return 'ready'
            self._summary_ready.pop(account,None)
        return 'idle'

    def _header_job_label(self,state,recent=None):
        status=self._header_job_state(state['identity'][0])
        if status=='busy':return _tr('Сводка в процессе · открыть прогресс')
        if status=='ready':return _tr('Сводка готова · открыть')
        return _tr('Последняя сводка · удерживайте для новой') if recent is not None else _tr('Сводка сообщений')

    def _header_status_fallback(self,state,status):
        item=state.get('button')
        if item is None:return
        try:
            item.setAlpha(0.55 if status=='busy' else 1.0);item.setActivated(status=='ready')
            if status=='ready':item.setIconColor(ui_palette()['accent']);state['header_status_tinted']=True
            elif state.pop('header_status_tinted',False):
                colour=header_theme_colour(state['fragment'])
                if colour is not None:item.setIconColor(colour)
        except Exception:pass


    def _config(self, provider=None):
        chosen_style=self._selected_style()
        raw_provider = self.get_setting("provider", 0) if provider is None else provider
        p = index_value(raw_provider, len(PROVIDERS), -1)
        if p < 0:
            raise SummaryError("provider", "Настройка провайдера повреждена. Выберите его заново.")
        prefix = PROVIDER_KEYS[p]
        model = str(self.get_setting(prefix + "_model", "") or "").strip() or DEFAULT_MODELS[p]
        endpoint = str(self.get_setting("ollama_endpoint", "http://127.0.0.1:11434") if p == PROVIDER_OLLAMA else self.get_setting("custom_endpoint", "") or "").strip()
        return AIConfig(
            provider=p, api_key=str(self.get_setting(prefix + "_api_key", "") or "").strip(),
            model=model, endpoint=endpoint,
            api_mode=index_value(self.get_setting(prefix + "_api_mode", 1 if p == PROVIDER_CUSTOM else 0), 2),
            timeout=TIMEOUTS[index_value(self.get_setting("timeout_index", 1), len(TIMEOUTS), 1)],
            max_tokens=OUTPUT_LIMITS[index_value(self.get_setting("output_index", 1), len(OUTPUT_LIMITS), 1)],
            input_chars=INPUT_LIMITS[index_value(self.get_setting("input_index", 1), len(INPUT_LIMITS), 1)],
            anonymize=bool(self.get_setting("anonymize", True)),
            style=style_legacy_index(chosen_style),style_prompt=chosen_style["prompt"],style_key=chosen_style["id"],style_name=chosen_style["name"],
            language=index_value(self.get_setting("lang", 0), len(LANGS)),
            allow_http=bool(self.get_setting(prefix + "_allow_http", False)),
            ollama_context=OLLAMA_CONTEXTS[index_value(self.get_setting("ollama_context_index", 2), len(OLLAMA_CONTEXTS), 2)],
            custom_modern_tokens=bool(self.get_setting("custom_modern_tokens", False)),
            reasoning_effort=str(self.get_setting(reasoning_setting_key(p,model),"") or ""),
        )

    def _notice(self, message, error=False):
        def show():
            if self._loaded:
                (BulletinHelper.show_error if error else BulletinHelper.show_info)(message)
        run_on_ui_thread(show)

    def _record_error(self, error):
        code, message = safe_error(error)
        if not isinstance(code, str) or code not in SAFE_ERROR_CODES:
            code, message = safe_error(RuntimeError())
        self.last_error = code + ": " + message
        hints = {"internal": "Внутренняя ошибка плагина.", "key_missing": "Не задан ключ.", "key_format": "Некорректный формат ключа.", "http_disabled": "HTTP без шифрования не разрешён.", "api_error": "API вернул ошибку внутри ответа.", "quota": "Квота или оплата API.", "timeout": "Таймаут; запрос мог быть принят.", "connection": "Нет соединения.", "tls": "Не прошла проверка TLS.", "telegram_flood": "Ограничение частоты Telegram.", "telegram_timeout": "Таймаут истории Telegram."}
        hint = hints.get(code, "Ошибка API (HTTP " + code[5:] + ")." if code.startswith("http_") and code[5:].isdigit() else "Ошибка плагина; подробности показаны в уведомлении.")
        self._safe_error_text = code + ": " + hint
        self._event("operation_error", "error", code, emit=False)
        self._safe_engine_log("error", "Operation failed: " + code)
        return message

    def _ui(self, job, callback):
        def guarded():
            if self._loaded and self._job is job and not job.cancel.is_set():
                if not activity_alive(job.activity):
                    if job.kind=='summary' and getattr(job,'background',False):
                        self._refresh_job_indicator();return
                    self.cancel_job(job, notify=False)
                    return
                try:
                    callback()
                except Exception as error:
                    message = self._record_error(error)
                    self.cancel_job(job, notify=False)
                    self._notice(message, True)
        run_on_ui_thread(guarded)

    def _busy(self):
        with self._lock:
            busy = self._job is not None
        if busy:
            self._notice("Операция уже выполняется. После отмены активный HTTP-запрос должен завершиться или достичь таймаута.")
        return busy

    def on_menu_click(self, context):
        context=dict(context or {})
        def begin():
            if not self._loaded:return
            try:
                fragment=context.get('fragment') or get_last_fragment()
                if fragment is None:raise SummaryError('fragment','Не найден открытый чат.')
                state=self._chat_state(fragment);account,did,thread=state['identity']
                if int(get_selected_account())!=account:return
                expected=context.get('detail_identity')
                if expected is not None and expected!=state['identity']:
                    raise SummaryError('detail_context','Чат или аккаунт сменился. Откройте подробную сводку заново.')
                activity=fragment.getParentActivity()
                if not activity_alive(activity):return
                if context.get('detail') is None and getattr(self,'_job',None) is not None and self._job.kind=='summary' and self._job.account==account:
                    self._resume_job(self._job);return
                if context.get('detail') is None:
                    cached=self._recent_summary(state['identity']) if not context.get('force_new') else None
                    if cached is not None:self._show_result(activity,*cached)
                    else:self._show_workspace(dict(context,fragment=fragment),tab=0)
                    return
                cached=self._recent_summary(state['identity'])
                if cached is not None and not context.get('force_new') and context.get('detail') is None:
                    self._show_result(activity,*cached);return
                if self._busy():return
                from org.telegram.messenger import DialogObject
                if DialogObject.isEncryptedDialog(did):raise SummaryError('secret','Секретные чаты не поддерживаются.')
                get_mode=getattr(fragment,'getChatMode',None)
                mode=int(get_mode()) if callable(get_mode) else int(java_field(fragment,'chatMode',0) or 0)
                if mode!=0 or thread<0:raise SummaryError('chat_mode','Откройте обычный чат или тему форума.')
                try:
                    from org.telegram.messenger import ChatObject
                    chat=fragment.getCurrentChat()
                    if chat is not None and callable(getattr(ChatObject,'isMonoForum',None)) and ChatObject.isMonoForum(chat):
                        raise SummaryError('monoforum','Поддиалоги каналов пока не поддерживаются.')
                except (ImportError,AttributeError):pass
                fresh=opening_unread_bounds(fragment,state['identity'])
                bounds=context.get('unread_bounds') or choose_unread_bounds(state['bounds'],fresh,separator_unread_bounds(fragment))
                options=context.get('detail')
                if options is None and (bounds is None or bounds.upper_id<=bounds.read_max):
                    self._show_read_setup(dict(context,fragment=fragment),read_only_bounds(fragment,state['identity']));return
                if options is not None and options.period:
                    validate_detailed(options);bounds=UnreadBounds(0,0,0,'period')
                elif options is not None:
                    validate_detailed(options)
                    if options.prior_count and (bounds is None or bounds.upper_id<=bounds.read_max):
                        bounds=read_only_bounds(fragment,state['identity']) or bounds
                    if options.include_unread and not options.prior_count and (bounds is None or bounds.upper_id<=bounds.read_max):
                        self._show_read_setup(dict(context,fragment=fragment),bounds);return
                if bounds is None:raise SummaryError('history_empty','Не удалось определить границу прочитанных в этом чате.')
                if not self.get_setting('welcome_seen_v1',False):
                    self._show_welcome(activity,on_continue=lambda:self.on_menu_click(context));return
                config=self._config()
                if options is not None:
                    if options.style_prompt is None:
                        options=with_detail_style(options,resolve_style(self._style_catalog(),options.style_key,options.style))
                    config=replace(config,style=options.style,style_prompt=options.style_prompt,style_key=options.style_key,
                        style_name=options.style_name,language=options.language,max_tokens=OUTPUT_LIMITS[options.output_index])
                validate_config(config)
                if bounds.upper_id>bounds.read_max:state['bounds']=bounds
                self._start_job(Job('summary',activity,config,account,did,thread,0,bounds,options))
            except Exception as error:self._notice(self._record_error(error),True)
        run_on_ui_thread(begin)



    def _show_picker(self, builder, cleanup=None):
        dismiss_dialog(self._picker)
        self._picker = builder

        def dismissed(b):
            if cleanup is not None:
                cleanup()
            if self._picker is b:
                self._picker = None
        builder.set_on_dismiss_listener(dismissed)
        builder.show()

    def _close_job_dialog(self, job):
        job.closing_dialog=True
        self._clear_view_actions(job)
        dialog, job.dialog = job.dialog, None
        job.status_view = None
        if dialog is not None:
            try:
                dialog.set_on_cancel_listener(None)
            except Exception:
                pass
            try:dialog.set_on_dismiss_listener(None)
            except Exception:pass
            dismiss_dialog(dialog)
        job.closing_dialog=False

    def _show_progress(self, job, text):
        from android.widget import ProgressBar
        job.progress_text=text
        if job.kind=='summary' and getattr(job,'background',False):self._refresh_job_indicator();return
        self._close_job_dialog(job);palette=ui_palette();root=ui_stack(job.activity,(20,4,20,12))
        panel=ui_stack(job.activity,(16,12,16,12),horizontal=True);ui_background(panel,palette['soft'],12)
        spinner=ProgressBar(job.activity);ui_add(panel,spinner,24,24)
        status=ui_text(job.activity,text,15,palette['text'],True);ui_add(panel,status,0,-2,left=12,weight=1);ui_add(root,panel)
        builder=SummaryDialogBuilder(job.activity);builder.set_title(_tr('Готовим сводку' if job.kind=='summary' else 'Подключение'))
        builder.set_view(root)
        if job.kind=='summary':
            builder.set_negative_button(_tr('Свернуть'),lambda b,w:self._minimize_job(job))
            builder.set_on_cancel_listener(lambda b:self._minimize_job(job))
            builder.set_on_dismiss_listener(lambda b:self._job_dialog_dismissed(job,b))
        else:
            builder.set_negative_button(_tr('Отменить'),lambda b,w:self.cancel_job(job))
            builder.set_on_cancel_listener(lambda b:self.cancel_job(job))
        builder.create();builder.set_cancelable(True);builder.set_canceled_on_touch_outside(False)
        job.dialog,job.status_view=builder,status;builder.show();self._refresh_job_indicator()


    def _progress(self, job, text):
        job.progress_text=text
        if text.startswith("API занят."):
            self._event("retry", "warning")
        def update():
            if job.status_view is not None:
                job.status_view.setText(_tr(text))
        self._ui(job, update)

    def cancel_job(self, job=None, notify=True):
        job = job or self._job
        if job is None:
            return
        self._event_cancel_requested(job)
        job.cancel.set()
        cancel_telegram(job)

        def close():
            self._close_job_dialog(job)
            job.activity = None
            if notify and self._loaded:
                BulletinHelper.show_info(_tr("Отменено. Уже отправленный HTTP-запрос нельзя отозвать у провайдера; его ответ будет проигнорирован."))
        run_on_ui_thread(close)

    def _start_job(self, job):
        if not self._loaded or self._busy():
            return
        with self._lock:
            self._job = job
        job.owner_uid=summary_history_owner(job.account)
        getattr(self,"_summary_ready",{}).pop(job.account,None)
        self._event(job.kind + "_start")
        try:
            self._show_progress(job, "Загружаю историю…" if job.kind == "summary" else "Подключаюсь к API…")
            thread = threading.Thread(target=lambda: self._worker(job), name="chat-summary-worker", daemon=True)
            thread.start()
        except Exception as error:
            self._finish(job, None, error)

    def _confirm_upload(self,job,transcript):
        # Creation is authorized by the existing Create summary action in the form.
        check_cancel(job.cancel)
        if not self._loaded or self._job is not job:raise Cancelled()
        if getattr(job,'owner_uid',0) and summary_history_owner(job.account)!=job.owner_uid:
            job.cancel.set();raise Cancelled()
        job.consent_transcript=None;job.phase='generation';job.approved.set()
        self._progress(job,'Готовлю сводку…')



    def _worker(self, job):
        outcome, error = None, None
        try:
            if job.kind == "summary":
                messages, users, chats = fetch_history(job, lambda text: self._progress(job, text))
                system = detailed_system_prompt(job.config,job.detail)
                prefix = "Summarize only these JSONL chat records:\n"
                max_bytes = None
                if job.config.provider == PROVIDER_OLLAMA:
                    # UTF-8 bytes conservatively upper-bound byte-level text token counts.
                    # Also reserve space for chat templates, output and the system prompt.
                    max_bytes = job.config.ollama_context - job.config.max_tokens - len((system + prefix).encode("utf-8")) - 1024
                transcript = complete_transcript(messages, users, chats, job.config, max_bytes, account=job.account)
                if job.detail is not None:
                    transcript = mark_detailed_transcript(transcript,job,max_bytes)
                self._last_unread_counts = dict(getattr(job,"history_counts",{}), text=transcript.used)
                transcript = replace(transcript, unread_expected=job.unread_bounds.count, unread_read_max=job.unread_bounds.read_max, unread_upper_id=job.unread_bounds.upper_id)
                chat = chats.get(abs(job.dialog_id))
                is_channel = bool(getattr(chat, 'broadcast', False) or getattr(chat, 'megagroup', False)) or 'channel' in class_name(chat).lower()
                transcript = replace(transcript, account=job.account, dialog_id=job.dialog_id, thread_id=job.thread_id, is_channel=is_channel)
                # Release Java history objects before waiting for consent or the external API.
                del messages, users, chats
                self._event("history_ready")
                self._confirm_upload(job, transcript)
                self._event("api_sending")
                with new_http_session() as session:
                    result = summarize_complete(session, job.config, system, transcript, job.cancel, lambda text: self._progress(job, text))
                check_cancel(job.cancel)
                job.saved_summary=self._save_completed_summary(job,result,transcript)
                check_cancel(job.cancel)
                outcome = (result, transcript)
            elif job.kind == "models":
                with new_http_session() as session:
                    outcome = list_models(session, job.config, job.cancel, lambda text: self._progress(job, text))
            else:
                test_config = replace(job.config, max_tokens=min(1024, job.config.max_tokens))
                with new_http_session() as session:
                    outcome = call_ai(session, test_config, "Respond with the single word OK.", "Connection test. No conversation data is included.", job.cancel, lambda text: self._progress(job, text))
        except Cancelled:
            pass
        except Exception as caught:
            error = caught
        finally:
            cancel_telegram(job)
            # Bind values now: Python clears `except ... as ...` variables after an except block.
            run_on_ui_thread(lambda j=job, value=outcome, err=error: self._finish(j, value, err))

    def _finish(self, job, outcome, error):
        if self._job is not job:
            return
        self._close_job_dialog(job)
        with self._lock:
            if self._job is job:
                self._job = None
        if not self._loaded or job.cancel.is_set():
            if job.cancel.is_set():
                self._event("cancelled")
            job.activity = None
            self._resume_detail_after_cancel(job)
            self._refresh_job_indicator()
            return
        if job.kind == "test" and (outcome is not None or error is not None):
            self._connection_checks[job.config.provider] = (config_ui_signature(job.config), error is None)
            self._refresh_settings()
        if error is not None:
            self._notice(self._record_error(error), True)
        elif outcome is not None:
            self._event(job.kind + "_success")
            try:
                if job.kind == "summary":
                    result, transcript = outcome
                    owner=getattr(job,'owner_uid',0)
                    if owner and owner!=summary_history_owner(job.account):
                        job.activity=None;self._refresh_job_indicator();return
                    saved=getattr(job,'saved_summary',None)
                    if saved is not None:self._remember_result(job.account,result,transcript,job.config.provider,job.config.model,saved=saved)
                    else:self._remember_result(job.account,result,transcript,job.config.provider,job.config.model)
                    self._refresh_settings()
                    if not getattr(job,'suppress_auto_result',False) and int(get_selected_account())==job.account and activity_alive(job.activity):
                        self._show_result(job.activity,result,transcript,job.config.provider,job.config.model)
                    else:
                        if not hasattr(self,'_summary_ready'):self._summary_ready={}
                        self._summary_ready[job.account]=self._recent_by_account[job.account][0]
                        if int(get_selected_account())==job.account:self._notice(_tr('Сводка готова'))
                    if getattr(job,'history_failed',False):self._notice(_tr('Не удалось сохранить историю. Эта сводка пока только в памяти.'),True)
                elif job.kind == "models":
                    if activity_alive(job.activity):
                        self._show_models(job.activity, job.config, outcome)
                else:
                    BulletinHelper.show_success(_tr("API вернул текстовый ответ. Подключение работает."))
            except Exception as caught:
                self._notice(self._record_error(caught), True)
        if outcome is None and error is None and not job.cancel.is_set():
            self._event("no_result", "warning")
        job.activity = None
        self._refresh_job_indicator()

    def _show_result(self, activity, result, transcript, provider, model):
        ready=getattr(self,'_summary_ready',{}).get(transcript.account)
        if ready is not None and ready.data[0] is result:
            self._summary_ready.pop(transcript.account,None);self._refresh_job_indicator()
        display_text = local_summary_text(result.text, transcript, bool(True))
        try:
            self._show_result_rich(activity, result, transcript, provider, model)
        except Exception:
            pending=getattr(self,'_pending_result_owner',None)
            if pending is not None:
                self._clear_view_actions(pending)
                self._pending_result_owner=None
            cards_owner=getattr(self,'_pending_result_cards_owner',None)
            if cards_owner is not None:
                self._clear_view_actions(cards_owner);self._pending_result_cards_owner=None
            # Keep a usable copy action even if a client fork/OEM breaks the custom Android view.
            self._event("result_fallback", "warning")
            builder = SummaryDialogBuilder(activity)
            builder.set_title(_tr("Сводка · " + str(transcript.used) + " сообщений"))
            builder.set_message('\n\n'.join(title+'\n'+body for title,body,mid in summary_narrative_entries(display_text,transcript)) + ("\n\n[Ответ может быть неполным: достигнут лимит генерации.]" if result.truncated else "") + ("\n\n" + usage_text(result.usage) if result.usage != TokenUsage() else ""))
            builder.set_negative_button(_tr('Закрыть'),lambda b,w:b.dismiss())
            builder.set_neutral_button(_tr('Создать'),lambda b,w:(b.dismiss(),self._detail_from_result(transcript)))
            self._track_result_dialog(builder)

    def _workspace_touch(self, root, event):
        record=getattr(self,'_workspace_surfaces',{}).get(int(root.hashCode()))
        if record is None or record['ref']()!=root or record['closed'] or record.get('dispatching_cancel'):
            return False
        from android.view import MotionEvent
        from org.telegram.messenger import AndroidUtilities
        action=int(event.getActionMasked());pager=record['pager']
        if action==MotionEvent.ACTION_DOWN:
            try:
                from android.view import ViewConfiguration
                threshold=float(ViewConfiguration.get(root.getContext()).getScaledTouchSlop())
            except Exception:threshold=float(AndroidUtilities.dp(12))
            record['gesture']={'x':float(event.getRawX()),'y':float(event.getRawY()),'blocked':False,
                'dragging':False,'swallowed':False,'threshold':threshold,'samples':[(float(event.getEventTime()),float(event.getRawX()))]}
            gesture=record['gesture']
            for field in record['editables']:
                if field.getVisibility()!=0 or not field.isShown():continue
                rect=self._header_rect(field)
                if rect and rect[0]<=gesture['x']<rect[2] and rect[1]<=gesture['y']<rect[3]:gesture['blocked']=True;break
            return False
        gesture=record.get('gesture')
        if gesture is None:return False
        if action in (MotionEvent.ACTION_CANCEL,MotionEvent.ACTION_POINTER_DOWN):
            consumed=gesture['dragging'] or gesture['swallowed']
            if gesture['dragging']:pager.release(cancelled=True)
            gesture.update(blocked=True,dragging=False,swallowed=consumed)
            if action==MotionEvent.ACTION_CANCEL:record['gesture']=None
            return consumed
        if gesture['swallowed']:
            if action==MotionEvent.ACTION_UP:record['gesture']=None
            return True
        x=float(event.getRawX());now=float(event.getEventTime());dx=x-gesture['x'];dy=float(event.getRawY())-gesture['y']
        samples=gesture['samples'];samples.append((now,x))
        while len(samples)>2 and now-samples[0][0]>100:samples.pop(0)
        if action==MotionEvent.ACTION_MOVE and not gesture['blocked']:
            if not gesture['dragging']:
                direction=workspace_swipe(dx,dy,gesture['threshold'])
                if direction==2:gesture['blocked']=True
                elif direction and (pager.index+direction in (0,1) or abs(pager.position-pager.index)>0.01):
                    cancel=MotionEvent.obtain(event);cancel.setAction(MotionEvent.ACTION_CANCEL)
                    record['dispatching_cancel']=True
                    try:root.dispatchTouchEvent(cancel)
                    finally:record['dispatching_cancel']=False;cancel.recycle()
                    pager.begin();gesture['dragging']=True
            if gesture['dragging']:pager.drag(dx);return True
        if action==MotionEvent.ACTION_UP:
            record['gesture']=None
            if gesture['dragging']:
                elapsed=max(1.0,now-samples[0][0]);velocity=(x-samples[0][1])*1000.0/elapsed
                pager.drag(dx);pager.release(dx,velocity);return True
        return False


    def _show_workspace(self, context=None, options=None, data=None, tab=0, history=False, activity=None):
        from android.widget import FrameLayout
        from android.view import View
        from org.telegram.messenger import AndroidUtilities
        context=dict(context or {});fragment=context.get('fragment') or get_last_fragment()
        identity=context.get('detail_identity')
        if identity is None:
            if fragment is None:raise SummaryError('fragment','Не найден открытый чат.')
            identity=summary_identity(fragment)
        identity=tuple(identity);context.update(fragment=fragment,detail_identity=identity)
        if identity[0]!=int(get_selected_account()):
            raise SummaryError('detail_context','Чат или аккаунт сменился. Нажмите кнопку в текущем чате.')
        if activity is None:activity=fragment.getParentActivity() if fragment is not None else None
        if not activity_alive(activity):return
        can_create=self._detail_is_current(context)
        if data is not None and workspace_identity(data)!=identity:
            raise SummaryError('detail_context','Чат или аккаунт сменился. Нажмите кнопку в текущем чате.')
        saved=workspace_history(self._chat_history_entries(identity),identity)
        if data is None and saved:data=saved[0].data
        if can_create:
            chat_state=self._chat_state(fragment)
            if context.get('unread_bounds') is None:
                context['unread_bounds']=choose_unread_bounds(chat_state['bounds'],opening_unread_bounds(fragment,identity),
                    separator_unread_bounds(fragment)) or read_only_bounds(fragment,identity)
            bounds=context.get('unread_bounds');options=options or self._detail_defaults(identity)
            if bounds is None or bounds.upper_id<=bounds.read_max:
                options=replace(options,include_unread=False,prior_count=options.prior_count or 100);context['focus_read_count']=True
        palette=ui_palette();owner=object();cards_owner=object()
        self._pending_result_owner=owner;self._pending_result_cards_owner=cards_owner
        root=ui_stack(activity,(0,8,0,0));ui_background(root,palette['background'],20,stroke=palette['border'])
        root.setClipToOutline(True);root.setFocusableInTouchMode(True);root.requestFocus()
        handle=SummarySheetHandle(SummaryWorkspaceDialog(activity))
        state={'closed':False,'tab':-1,'history':bool(history),'data':data,'rendered':False,
               'viewport':None,'content_key':None,'scroll':{},'revision':0}
        tabs=ui_stack(activity,horizontal=True);labels=[]
        for index,label in enumerate(('Создать','Сводки')):
            cell=ui_text(activity,label,15,palette['muted'],True);cell.setGravity(17)
            self._bind_view_action(cell,lambda index=index:switch(index),owner=owner)
            cell.setContentDescription(_tr(label));ui_add(tabs,cell,0,44,weight=1);labels.append(cell)
        ui_add(root,tabs)
        track=FrameLayout(activity);track.setBackgroundColor(palette['border'])
        indicator=View(activity);indicator.setBackgroundColor(palette['accent'])
        track.addView(indicator,FrameLayout.LayoutParams(1,-1));ui_add(root,track,-1,2)
        pages=FrameLayout(activity);pages.setClipChildren(True);pages.setClipToPadding(True);ui_add(root,pages,-1,0,weight=1)
        if can_create:create_page,fields=self._detail_form(activity,context,options,owner,handle,embedded=True)
        else:
            create_page=ui_stack(activity,(16,20,16,16));fields={'cleanup':lambda:None}
            ui_add(create_page,ui_text(activity,'Откройте исходный чат для новой сводки.',14,palette['muted']))
        reading=ui_stack(activity,(16,0,16,0));date=ui_text(activity,'',13,palette['muted'],translate=False)
        date.setGravity(16);date.setMinimumHeight(AndroidUtilities.dp(44));ui_add(reading,date)
        self._bind_view_action(date,lambda:toggle_history(),owner=owner)
        status=ui_text(activity,'',12,palette['muted'],translate=False);status.setVisibility(8);ui_add(reading,status,bottom=8)
        content_host=FrameLayout(activity);content_host.setClipChildren(True);ui_add(reading,content_host,-1,0,weight=1)
        pages.addView(create_page,FrameLayout.LayoutParams(-1,-1));pages.addView(reading,FrameLayout.LayoutParams(-1,-1))
        try:density=float(activity.getResources().getDisplayMetrics().density)
        except Exception:density=1.0
        content_motion=WorkspaceContentMotion(content_host,self._animations_allowed,density)
        def render(direction=0):
            if state['closed']:return
            if state['viewport'] is not None:
                try:state['scroll'][state['content_key']]=int(state['viewport'].getChildAt(0).getScrollY())
                except Exception:pass
            self._clear_view_actions(cards_owner);content=ui_stack(activity);selected=state['data']
            entries=workspace_history(self._chat_history_entries(identity),identity)
            if state['history']:
                date.setText(_tr('История сводок')+'  ▴');date.setContentDescription(_tr('История сводок'))
                for item in entries:
                    title,preview=history_card_text(item)
                    row=ui_stack(activity,16);ui_background(row,palette['soft'],12,ripple=ui_mix(palette['soft'],palette['text'],0.10))
                    ui_add(row,ui_text(activity,item.created_at,12,palette['muted'],translate=False),bottom=8)
                    ui_add(row,ui_text(activity,title,15,palette['text'],True,translate=False),bottom=4)
                    if preview:ui_add(row,ui_text(activity,preview,14,palette['muted'],lines=2,translate=False))
                    self._bind_view_action(row,lambda item=item:select(item),owner=cards_owner);ui_add(content,row,bottom=12)
                if self._history_has_more(identity):
                    more=ui_text(activity,'Показать ещё',14,palette['accent']);more.setGravity(17)
                    more.setMinimumHeight(AndroidUtilities.dp(44))
                    self._bind_view_action(more,lambda:more_history(),owner=cards_owner);ui_add(content,more)
                if not entries:ui_add(content,ui_text(activity,'В этом чате пока нет сводок',14,palette['muted']),top=16)
                status.setVisibility(8)
            elif selected is not None:
                result,transcript,provider,model=selected
                stamp=next((item.created_at for item in entries if item.data is selected),_tr('Последняя сводка'))
                date.setText(stamp+'  ▾');date.setContentDescription(stamp+'. '+_tr('История сводок'))
                display=local_summary_text(result.text,transcript,True)
                ui_add(content,self._render_summary_cards(activity,summary_narrative_entries(display,transcript),palette,cards_owner,
                    lambda mid:self._open_source(transcript,mid),transcript,animate=False))
                status.setText(_tr('Ответ может быть неполным: достигнут лимит генерации.') if result.truncated else '')
                status.setVisibility(0 if result.truncated else 8)
            else:
                date.setText(_tr('История сводок')+'  ▾');status.setVisibility(8)
                ui_add(content,ui_text(activity,'В этом чате пока нет сводок',14,palette['muted']),top=16)
            viewport=ui_reading_scroll(activity,content);state['viewport']=viewport
            state['content_key']=('history',) if state['history'] else ('result',id(selected))
            content_motion.replace(viewport,direction);state['rendered']=True;state['revision']+=1
            revision=state['revision'];position=state['scroll'].get(state['content_key'],0)
            def restore_scroll():
                if state['closed'] or revision!=state['revision']:return
                try:viewport.getChildAt(0).scrollTo(0,position)
                except Exception:pass
            run_on_ui_thread(restore_scroll,32)
        def more_history():
            if state['closed']:return
            self._load_more_history(identity);render(1)
        def select(item):
            if state['closed']:return
            if not any(item is current for current in workspace_history(self._chat_history_entries(identity),identity)):
                self._notice(_tr('Этот результат уже очищен или вытеснен новым.'));render();return
            state['data']=item.data;state['history']=False;render(-1)
        def toggle_history():
            if state['closed']:return
            state['history']=not state['history'];render(1 if state['history'] else -1)
        def selected_tab(index):
            if state['closed']:return
            changed=index!=state['tab'];state['tab']=index
            if changed:
                try:
                    for key in ('prior_count','prompt'):
                        if key in fields:fields[key].clearFocus();AndroidUtilities.hideKeyboard(fields[key])
                    root.requestFocus()
                except Exception:pass
            for number,label in enumerate(labels):
                label.setTextColor(palette['accent'] if number==index else palette['muted']);label.setSelected(number==index)
            if index==1 and not state['rendered']:render()
        render()  # Prepare the neighbouring page before the first finger-tracked drag.
        pager=WorkspacePagerMotion(pages,(create_page,reading),indicator,self._animations_allowed,selected_tab,density)
        def switch(index):
            if not state['closed']:pager.select(index)
        layout_listener=None
        try:
            from java import dynamic_proxy
            class Layout(dynamic_proxy(View.OnLayoutChangeListener)):
                def onLayoutChange(self,view,left,top,right,bottom,*previous):
                    if not state['closed']:pager.resize(float(right-left))
            layout_listener=Layout();pages.addOnLayoutChangeListener(layout_listener)
        except Exception:pass
        def measure():
            if not state['closed']:pager.measure()
        pager.select(int(tab),False);run_on_ui_thread(measure,80)
        surfaces=getattr(self,'_workspace_surfaces',None)
        if surfaces is None:self._workspace_surfaces={};surfaces=self._workspace_surfaces
        if not getattr(self,'_workspace_touch_hook',False):
            try:
                from hook_utils import find_class
                handles=self._hook_java(find_class('android.view.ViewGroup'),'dispatchTouchEvent',SummaryWorkspaceTouchHook(self))
            except Exception:handles=[]
            self._workspace_touch_hook=bool(handles)
            if not handles:self._event('workspace_swipe_unavailable','warning')
        key=int(root.hashCode())
        surfaces[key]={'ref':self._chat_view_ref(root),'closed':False,'tab':lambda:state['tab'],'switch':switch,'pager':pager,
                       'editables':[fields[k] for k in ('prior_count','prompt') if k in fields]}
        def cleanup():
            state['closed']=True;state['revision']+=1;surfaces.pop(key,None)
            pager.dispose();content_motion.dispose();fields['cleanup']()
            if layout_listener is not None:
                try:pages.removeOnLayoutChangeListener(layout_listener)
                except Exception:pass
            self._clear_view_actions(cards_owner)
        handle.sheet.setCustomView(root);handle.sheet.setBackgroundColor(palette['background'])
        try:self._track_result_dialog(handle,owner,cleanup)
        except Exception:
            cleanup();self._clear_view_actions(owner);raise
        self._pending_result_owner=None;self._pending_result_cards_owner=None
        if tab==0 and can_create and context.get('focus_read_count'):self._focus_detail_count(context,fields['prior_count'],owner)



    def _show_result_rich(self, activity, result, transcript, provider, model):
        self._show_workspace({'detail_identity':(transcript.account,transcript.dialog_id,transcript.thread_id)},
                             data=(result,transcript,provider,model),tab=1,activity=activity)


    def _track_result_dialog(self, builder, action_owner=None, cleanup=None):
        dismiss_dialog(self._result_dialog)
        self._result_dialog=builder
        self._result_dialog_account=int(get_selected_account())
        def dismissed(b):
            if cleanup is not None:cleanup()
            if action_owner is not None:
                self._clear_view_actions(action_owner)
            if self._result_dialog is b:
                self._result_dialog=None;self._result_dialog_account=None
        builder.set_on_dismiss_listener(dismissed)
        builder.show()

    def _show_models(self, activity, config, models):
        # Limit a native dialog's size; the full set remains selectable by typing its ID.
        shown = models[:120]
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr("Модели · " + PROVIDERS[config.provider]))
        builder.set_message(_tr("Список сервера. Наличие ID не гарантирует поддержку выбранного API; после выбора проверьте подключение." + (" Показаны первые 120 моделей." if len(models) > 120 else "")))

        def choose(b, index):
            if 0 <= index < len(shown):
                self.set_setting(PROVIDER_KEYS[config.provider] + "_model", shown[index], reload_settings=True)
            b.dismiss()
        builder.set_items(shown, choose)
        builder.set_negative_button(_tr("Отмена"), lambda b, w: b.dismiss())
        self._show_picker(builder)

    def _open_key_editor(self, provider, on_return=None):
        if not getattr(self, "_loaded", False):
            BulletinHelper.show_info(_tr("Сначала включите плагин, чтобы изменить API-ключ."))
            return
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if not activity_alive(activity):
            return
        from android.widget import EditText, LinearLayout
        from android.text import InputType
        from org.telegram.messenger import AndroidUtilities
        key = PROVIDER_KEYS[provider] + "_api_key"
        field = EditText(activity)
        field.setSingleLine(True)
        field.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS)
        field.setText(str(self.get_setting(key, "") or ""))
        palette = ui_palette()
        field.setTextColor(palette["text"])
        field.setHint(_tr("Вставьте API-ключ"))
        field.setPadding(AndroidUtilities.dp(14), AndroidUtilities.dp(14), AndroidUtilities.dp(14), AndroidUtilities.dp(14))
        ui_background(field, palette["soft"], 14, palette["accent_border"])
        root = ui_stack(activity, (24, 8, 24, 8))
        root.addView(field, LinearLayout.LayoutParams(-1, -2))
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr("API-ключ · " + PROVIDERS[provider]))
        builder.set_message(_tr("Ключ используется только для этого сервиса. Хранится в обычных настройках SDK, без обещания шифрования."))
        builder.set_view(ui_dialog_scroll(activity, root, 220, 0.34))
        def portal():
            builder.dismiss()
            self._open_provider_portal(provider)
        ui_add(root, ui_action(activity, "Где получить ключ?" if provider != PROVIDER_OLLAMA else "Установить Ollama", "Открыть страницу сервиса · ключ не передаётся", palette, portal), top=12)
        def returned():
            if getattr(self, "_loaded", False) and callable(on_return):
                on_return()

        def save(b, w):
            value = str(field.getText()).strip()
            if value and (len(value) > 4096 or re.search(r"[\x00-\x20\x7f]", value)):
                self._notice("Ключ не сохранён: удалите пробелы и управляющие символы.", True)
            else:
                self.set_setting(key, value, reload_settings=True)
                field.setText("")
            b.dismiss()
            returned()
        builder.set_positive_button(_tr("Сохранить"), save)
        builder.set_negative_button(_tr("Отмена"), lambda b, w: (field.setText(""), b.dismiss(), returned()))
        builder.set_neutral_button(_tr("Удалить ключ"), lambda b, w: (self.set_setting(key, "", reload_settings=True), field.setText(""), b.dismiss(), returned()))
        self._show_picker(builder, cleanup=lambda: field.setText(""))

    def _start_api_action(self, kind, provider=None):
        if not getattr(self, "_loaded", False):
            BulletinHelper.show_info(_tr("Сначала включите плагин, затем проверьте подключение."))
            return
        if self._busy():
            return
        try:
            config = self._config(provider)
            validate_config(config, need_model=kind != "models")
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment is not None else None
            if activity_alive(activity):
                self._start_job(Job(kind, activity, config, int(get_selected_account())))
        except Exception as error:
            self._notice(self._record_error(error), True)

    def _show_last_result(self):
        self._load_history_account(int(get_selected_account()))
        value = getattr(self, "_last_by_account", {}).get(int(get_selected_account()))
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if value is None:
            self._notice("В этом аккаунте пока нет сохранённой сводки.")
        elif activity_alive(activity):
            self._show_result(activity, *value)

    def _safe_engine_log(self, level, message):
        # New SDK: logger. Old SDK: BasePlugin.log/android_utils.log. Never crash the job.
        try:
            logger = getattr(self, "logger", None)
            method = getattr(logger, level, None)
            if callable(method):
                method(message)
                self._diag_sink = "logger (call accepted)"
                return
        except Exception:
            pass
        line = "[" + level.upper() + "] " + message
        try:
            legacy = getattr(self, "log", None)
            if callable(legacy):
                legacy(line)
                self._diag_sink = "BasePlugin.log (call accepted)"
                return
        except Exception:
            pass
        try:
            method = getattr(_sdk_android, "log", None)
            if callable(method):
                method("Сводка сообщений " + line)
                self._diag_sink = "android_utils.log (call accepted)"
                return
        except Exception:
            pass
        self._diag_sink = "RAM only; no logcat sink accepted"

    def _event(self, event_key, level="info", error_code="", emit=True):
        event_key = event_key if isinstance(event_key, str) and event_key in EVENT_MESSAGES else "internal_event"
        level = level if level in ("info", "warning", "error") else "info"
        error_code = error_code if isinstance(error_code, str) and error_code in SAFE_ERROR_CODES else ("internal" if error_code else "")
        if getattr(self, "_diag_lock", None) is None:
            self._diag_lock = threading.Lock()
            self._diag_events = deque(maxlen=60)
        entry = (datetime.now().astimezone().strftime("%d.%m %H:%M:%S"), level.upper(), event_key, error_code)
        with self._diag_lock:
            self._diag_events.append(entry)
        if emit:
            text = EVENT_MESSAGES[event_key] + (" · " + error_code if error_code else "")
            self._safe_engine_log(level, text)

    def _events_snapshot(self):
        lock = getattr(self, "_diag_lock", None)
        if lock is None:
            return []
        with lock:
            return list(self._diag_events)

    def _event_cancel_requested(self, job):
        with job.lock:
            fresh = not getattr(job, "_cancel_event_logged", False)
            job._cancel_event_logged = True
        if fresh:
            self._event("cancel_requested")

    def _note_icon_fallbacks(self):
        with _ICON_LOCK:
            changed = any(value in ("fallback", "missing") for value in _ICON_AUDIT.values()) or any(value == "fallback" for value in _GLYPH_AUDIT.values())
        if changed and not getattr(self, "_diag_icons_warned", False):
            self._diag_icons_warned = True
            self._event("icons_fallback", "warning")

    def _diagnostics_text(self):
        self._note_icon_fallbacks()
        def version_only(value):
            match = re.match(r"^\d+(?:\.\d+){1,4}", str(value))
            return match.group(0) if match else "не определён"
        try:
            import _sdk_version
            sdk = version_only(_sdk_version.__version__)
        except Exception:
            sdk = "не определён"
        try:
            from org.telegram.messenger import BuildVars
            app = version_only(BuildVars.BUILD_VERSION_STRING)
        except Exception:
            app = "не определён"
        provider = index_value(self.get_setting("provider", 0), len(PROVIDERS), -1)
        prefix = PROVIDER_KEYS[provider] if provider >= 0 else None
        config = None
        try:
            config = self._config()
            validate_config(config)
            valid = True
        except Exception:
            valid = False
        checked = getattr(self, "_connection_checks", {}).get(provider)
        verification = "not_checked"
        if config is not None and isinstance(checked, tuple) and len(checked) == 2 and checked[0] == config_ui_signature(config):
            verification = "passed" if checked[1] else "failed"
        if provider in (PROVIDER_OPENAI, PROVIDER_ANTHROPIC, PROVIDER_GEMINI):
            endpoint_configured = True  # Built-in endpoint, never print its URL.
        elif provider == PROVIDER_OLLAMA:
            endpoint_configured = bool(str(self.get_setting("ollama_endpoint", "http://127.0.0.1:11434") or "").strip())
        elif provider == PROVIDER_CUSTOM:
            endpoint_configured = bool(str(self.get_setting("custom_endpoint", "") or "").strip())
        else:
            endpoint_configured = False
        with _ICON_LOCK:
            counts = {status: list(_ICON_AUDIT.values()).count(status) for status in ("checked", "fallback", "missing", "unverified")}
            glyph_counts = {status: list(_GLYPH_AUDIT.values()).count(status) for status in ("checked", "fallback", "unverified")}
        lines = [
            "СВОДКА СООБЩЕНИЙ SAFE DIAGNOSTICS", "Plugin: " + __version__,
            "App actual: " + app, "App minimum: " + __min_version__,
            "SDK actual: " + sdk, "SDK minimum: " + __sdk_version__,
            "Python: " + sys.version.split()[0], "requests: " + str(requests.__version__),
            "Provider: " + (PROVIDERS[provider] if provider >= 0 else "Invalid"),
            "Key configured: " + str(bool(prefix and str(self.get_setting(prefix + "_api_key", "") or "").strip())),
            "Model configured: " + str(bool(prefix and (str(self.get_setting(prefix + "_model", "") or "").strip() or DEFAULT_MODELS[provider]))),
            "Endpoint configured: " + str(endpoint_configured),
            "Config valid: " + str(valid),
            "Config valid checks local syntax/limits, not API authorization.",
            "Connection test (current config): " + verification,
            "Enabled: " + str(bool(getattr(self, "_loaded", False))),
            "Busy: " + str(getattr(self, "_job", None) is not None),
            "Log sink: " + getattr(self, "_diag_sink", "not used yet"),
            "Event times: device-local clock",
            "Icons (native runtime check): " + ", ".join(key + "=" + str(value) for key, value in counts.items()),
            "Glyphs (native runtime check): " + ", ".join(key + "=" + str(value) for key, value in glyph_counts.items()),
            "Last error: " + getattr(self, "_safe_error_text", "Нет ошибок"),
            "Last error is historical; it is not a statement about the current connection.",
            "", "SESSION EVENTS · RAM ONLY (up to 60)",
        ]
        entries = self._events_snapshot()
        lines += [stamp + " " + level + " · " + EVENT_MESSAGES[key] + (" [" + code + "]" if code else "") for stamp, level, key, code in entries]
        if not entries:
            lines.append("Событий пока нет.")
        lines.append('Нативные нажатия / удержания: ' + str(getattr(self,'_native_click_hooks',(0,0))))
        lines.append('Подключения интерфейса: ' + str(getattr(self,'_ui_hook_counts',{})))
        lines.append('Выбор значка: '+str(getattr(self,'_last_header_picker_status',{})))
        lines.append('Значок шапки: '+str(getattr(self,'_last_header_icon_status',{})))
        lines.append('Отрисовка имён: paint_hook='+str(getattr(self,'_participant_paint_hook',False))+'; last='+str(getattr(self,'_last_name_style_counts',{})))
        lines.append('Активных действий интерфейса: ' + str(len(getattr(self,'_view_actions',{}))))
        lines.append('Касания шапки за сеанс: ' + str(getattr(self,'_header_touch_stats',{})))
        lines.append('Последняя геометрия кнопки / меню: ' + str(getattr(self,'_last_header_geometry',{})))
        lines.append('Последний диапазон: ' + str(getattr(self,'_last_unread_counts',{})))
        return "\n".join(lines)

    def _copy_debug(self):
        copy_to_clipboard(self._diagnostics_text())

    def _show_diagnostics(self):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if not activity_alive(activity):
            BulletinHelper.show_info(_tr("Не найден активный экран Telegram."))
            return
        if not hasattr(self, "_picker"):
            self._picker = None
        text = self._diagnostics_text()
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr("Диагностика и события"))
        try:
            root = ui_stack(activity, (20, 4, 20, 8))
            view = ui_text(activity, text, 12, ui_palette()["text"])
            view.setTextIsSelectable(True)
            ui_add(root, view)
            builder.set_view(ui_dialog_scroll(activity, root, 460, 0.60))
        except Exception:
            builder.set_message(_tr(text))
        builder.set_positive_button(_tr("Копировать"), lambda b, w: self._copy_debug_with_notice())
        builder.set_negative_button(_tr("Закрыть"), lambda b, w: b.dismiss())
        builder.set_neutral_button(_tr("Очистить журнал"), lambda b, w: (b.dismiss(), self._clear_event_log()))
        self._show_picker(builder)

    def _clear_event_log(self):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if not activity_alive(activity):
            return
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr("Очистить журнал событий?"))
        builder.set_message(_tr("Удаляются только события плагина из памяти. Ключи, настройки и история сводок останутся. Системный logcat это не очищает."))
        def clear(b, w):
            lock = getattr(self, "_diag_lock", None)
            if lock is not None:
                with lock:
                    self._diag_events.clear()
            b.dismiss()
            self._show_diagnostics()
        builder.set_positive_button(_tr("Очистить"), clear)
        builder.set_negative_button(_tr("Отмена"), lambda b, w: b.dismiss())
        self._show_picker(builder)



    def _connection_state(self):
        """UI hints are configuration/test states, never an implicit network request."""
        try:
            config = self._config()
            validate_config(config)
        except SummaryError as error:
            titles = {"key_missing": "Добавьте API-ключ", "model": "Выберите модель", "url": "Добавьте адрес сервера", "http_disabled": "Проверьте адрес сервера"}
            return titles.get(error.code, "Завершите настройку"), "warning", "Пара шагов — и можно начинать"
        job = getattr(self, "_job", None)
        if job is not None:
            return ("Запрос завершается" if job.cancel.is_set() else "Выполняется запрос"), "accent", "Настройки применятся к следующему запуску"
        previous = getattr(self, "_connection_checks", {}).get(config.provider)
        if previous is not None and previous[0] == config_ui_signature(config):
            if previous[1]:
                return "Подключение проверено", "success", "В чате: ⋮ → Сводка чата"
            return "Проверьте подключение", "warning", "Проверьте ключ, модель и адрес сервера"
        return "Готово к проверке", "accent", "Проверьте подключение перед первым запуском"

    def _refresh_settings(self):
        if getattr(self, "_loaded", False):
            revision = index_value(self.get_setting("ui_revision", 0), 1000000000) + 1
            self.set_setting("ui_revision", revision, reload_settings=True)

    def _show_welcome(self, activity=None, on_continue=None):
        if not getattr(self, "_loaded", False):
            BulletinHelper.show_info(_tr("Сначала включите плагин, чтобы открыть приветствие."))
            return
        activity = activity or self._compat_activity()
        if not activity_alive(activity):
            return
        ready = False
        try:
            validate_config(self._config())
            ready = True
        except SummaryError:
            pass
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr("Как начать"))
        try:
            palette = ui_palette()
            root = ui_stack(activity, (20, 4, 20, 8))
            hero = ui_stack(activity, 16)
            ui_background(hero, palette["soft"], 16)
            ui_add(hero, ui_text(activity, "Сводка сообщений", 13, palette["muted"]))
            ui_add(hero, ui_text(activity, "Длинная переписка.\nКороткий вывод.", 23, palette["text"], True), top=12)
            ui_add(hero, ui_text(activity, "Главное, решения и задачи — без перечитывания всего чата.", 14, palette["muted"]), top=8)
            ui_add(root, hero, bottom=12)
            for number, title, description in [
                (1, "Подключите AI", "Выберите сервис и добавьте свой API-ключ."),
                (2, "Выберите фрагмент", "В чате: кнопка сводки или ⋮ → Сводка чата. Берутся все непрочитанные."),
                (3, "Создайте сводку", "Выберите сообщения и нажмите «Создать сводку». Прогресс можно свернуть."),
            ]:
                ui_add(root, ui_step(activity, number, title, description, palette), bottom=2)
            ui_add(root, ui_text(activity, "Открытие этого экрана ничего не отправляет в AI. Запрос может тарифицироваться; псевдонимы не очищают личные данные внутри текста.", 12, palette["muted"]), top=10, bottom=12)
            builder.set_view(ui_dialog_scroll(activity, root, 480, 0.60))
        except Exception:
            builder.set_message(_tr("Главное из длинной переписки.\n\n1. Выберите AI-сервис и добавьте ключ.\n2. В чате: ⋮ → Сводка чата → все непрочитанные.\n3. Проверьте получателя и подтвердите отправку.\n\nЗапрос может тарифицироваться. Псевдонимы не удаляют личные данные внутри текста. "))

        def seen():
            if getattr(self, "_loaded", False):
                self.set_setting("welcome_seen_v1", True)

        completed = [False]
        def begin(b, w):
            if completed[0]:
                return
            completed[0] = True
            if not getattr(self, "_loaded", False):
                b.dismiss()
                return
            seen()
            b.dismiss()
            if not ready:
                self._open_compat_page("Подключение", self._connection_settings)
            elif callable(on_continue):
                on_continue()

        builder.set_positive_button(_tr("Продолжить" if ready else "Настроить AI"), begin)
        builder.set_negative_button(_tr("Позже"), lambda b, w: (seen(), b.dismiss()))
        builder.set_on_cancel_listener(lambda b: seen())
        self._show_picker(builder)

    def _connection_settings(self):
        # Reuse the real controls, so the onboarding dialog cannot drift from main settings.
        result, active = [], False
        provider = index_value(self.get_setting("provider", 0), len(PROVIDERS))
        for row in self._settings_rows():
            if isinstance(row, Header) and row.text == _tr("Подключение"):
                active = True
                continue
            if active and isinstance(row, (Header, Divider)):
                break
            if active:
                if getattr(row, "text", "") in (_tr("API-ключ"), _tr("Ключ сервера")):
                    result.append(localized_setting(Text, text=row.text, subtext=row.subtext, icon=native_icon("msg_secret"),
                        on_click=lambda view, p=provider: self._open_key_editor(p, on_return=lambda: self._open_compat_page("Подключение", self._connection_settings))))
                else:
                    result.append(row)
        return result





    def _open_external_url(self, url):
        try:
            parts = urlsplit(url)
        except (ValueError, TypeError):
            self._event("link_blocked", "warning")
            BulletinHelper.show_error(_tr("Небезопасная или неизвестная ссылка не открыта."))
            return
        allowed = {"t.me", "platform.openai.com", "console.anthropic.com", "platform.claude.com", "aistudio.google.com", "ollama.com"}
        if parts.scheme != "https" or parts.hostname not in allowed or parts.username or parts.password or parts.query or parts.fragment:
            self._event("link_blocked", "warning")
            BulletinHelper.show_error(_tr("Небезопасная или неизвестная ссылка не открыта."))
            return
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        if not activity_alive(activity):
            BulletinHelper.show_info(_tr("Не найден активный экран. Откройте Telegram и повторите."))
            return
        try:
            from android.content import Intent
            from android.net import Uri
            activity.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(url)))
            self._event("link_open")
        except Exception:
            self._event("link_failed", "warning")
            BulletinHelper.show_error(_tr("Не удалось открыть ссылку. Повторите переход позже."))

    def _open_provider_portal(self, provider=None):
        provider = index_value(self.get_setting("provider", 0) if provider is None else provider, len(PROVIDERS))
        url = PROVIDER_PORTALS[provider]
        if url:
            self._open_external_url(url)
        else:
            self._show_information("Ключ своего API", "Ключ и точный URL выдаёт владелец вашего сервера. Универсальной страницы получения ключа нет. Не используйте ключ от другого сервиса без необходимости.")

    def _copy_debug_with_notice(self):
        self._copy_debug()
        BulletinHelper.show_success(_tr("Диагностика скопирована. Ключей и переписки в ней нет."))

    def _show_information(self, title, text, on_back=None):
        activity = self._compat_activity()
        if activity is None:
            return
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr(title))
        try:
            root = ui_stack(activity, (20, 4, 20, 8))
            ui_add(root, ui_text(activity, text, 14, ui_palette()["text"]))
            builder.set_view(ui_dialog_scroll(activity, root, 360, 0.48))
        except Exception:
            builder.set_message(_tr(text))
        builder.set_positive_button(_tr("Понятно"), lambda b, w: b.dismiss())
        if callable(on_back):
            builder.set_negative_button(_tr("Назад"), lambda b, w: (b.dismiss(), on_back()))
        self._show_picker(builder)

    def _show_faq(self):
        activity = self._compat_activity()
        if activity is None:
            return
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr("Частые вопросы"))
        def open_answer(index):
            if getattr(self, "_loaded", False) and 0 <= index < len(FAQ_ITEMS):
                builder.dismiss()
                title, text = FAQ_ITEMS[index]
                self._show_information(title, text, self._show_faq)
        try:
            palette = ui_palette()
            root = ui_stack(activity, (20, 4, 20, 4))
            for index, (title, text) in enumerate(FAQ_ITEMS):
                ui_add(root, ui_action(activity, title, "Открыть ответ", palette, lambda i=index: open_answer(i), "?"), bottom=8)
            builder.set_view(ui_dialog_scroll(activity, root, 420, 0.56))
        except Exception:
            builder.set_items([title for title, text in FAQ_ITEMS], lambda b, index: open_answer(index))
        builder.set_negative_button(_tr("Закрыть"), lambda b, w: b.dismiss())
        self._show_picker(builder)

    def _show_about(self):
        self._show_information(_tr('О плагине'), 'Сводка сообщений ' + __version__ + '\n\n' + _tr('Сводка сообщений со ссылками на источники.') + '\n\n' + _tr('Приложение от 12.5.1 · SDK от 1.4.3.3') + '\n\n' + 'Design workflow: unslop by Damir Sokolovsky (@heydamir), CC BY 4.0\nhttps://github.com/heydamir/unslop')

    def _clear_last_result(self):
        activity = self._compat_activity()
        if activity is None:
            return
        account = int(get_selected_account())
        captured_owner=summary_history_owner(account)
        cache = self._last_by_account
        original = cache.get(account)
        if original is None:
            BulletinHelper.show_info(_tr("В этом аккаунте пока нечего очищать."))
            return
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr("Очистить последнюю сводку?"))
        builder.set_message(_tr("Удалится сохранённая сводка этого аккаунта на устройстве. Ключи и настройки останутся. Данные у провайдера и отправленные копии это не удаляет."))
        def clear(b, w):
            b.dismiss()
            if captured_owner and summary_history_owner(account)!=captured_owner:
                BulletinHelper.show_info(_tr('Аккаунт сменился. Очистка отменена.'));return
            if not getattr(self, "_loaded", False):
                return
            if int(get_selected_account()) != account:
                BulletinHelper.show_info(_tr("Аккаунт сменился. Очистка отменена."))
                return
            if cache.get(account) is not original:
                BulletinHelper.show_info(_tr("Результат обновился. Откройте очистку заново."))
                return
            try:self._forget_saved_summary(account,original)
            except Exception:self._notice(_tr('Не удалось очистить историю на устройстве.'),True);return
            cache.pop(account, None)
            entries = self._recent_by_account.get(account, [])
            entries[:] = [entry for entry in entries if entry.data is not original]
            if entries:
                cache[account] = entries[0].data
            if getattr(self, "_result_dialog_account", None) == account:
                dismiss_dialog(self._result_dialog)
            self._refresh_settings()
            self._event("last_clear")
            BulletinHelper.show_success(_tr("Последняя сводка этого аккаунта очищена."))
        builder.set_positive_button(_tr("Очистить"), clear)
        builder.set_negative_button(_tr("Отмена"), lambda b, w: b.dismiss())
        self._show_picker(builder)



    def _show_presets(self):
        rows=[self._default_style_row(),
              localized_setting(Selector,key='output_index',text='Максимум для ответа',default=1,items=[str(n)+' токенов' for n in OUTPUT_LIMITS])]
        self._open_compat_page('Как отвечать',lambda:rows)



    def _remember_result(self, account, result, transcript, provider, model, saved=None):
        self._load_history_account(account)
        data = (result,replace(transcript,text='',chunks=()),provider,model) if saved is None else saved.data
        if saved is None:
            saved=SavedSummary(data,datetime.now().astimezone().strftime('%d.%m.%Y · %H:%M'),uuid.uuid4().hex,summary_history_owner(account),time.time())
            store=getattr(self,'_history_store',None)
            if store is not None and saved.owner_uid:
                try:store.put(saved)
                except Exception:self._event('history_store_failed','warning')
        if getattr(self,'_history_store',None) is not None:saved=self._intern_history(saved)
        data=saved.data;self._last_by_account[account]=data
        entries=self._recent_by_account.setdefault(account,[])
        entries[:]=[entry for entry in entries if not saved.record_id or entry.record_id!=saved.record_id]
        entries.insert(0,saved);del entries[HISTORY_LIMIT:]
        identity=(account,transcript.dialog_id,transcript.thread_id)
        if not hasattr(self,'_chat_history'):self._chat_history={}
        values=self._chat_history.pop(identity,[])
        values[:]=[entry for entry in values if not saved.record_id or entry.record_id!=saved.record_id]
        values.insert(0,saved);del values[CHAT_HISTORY_LIMIT:];self._chat_history[identity]=values
        if hasattr(self,'_history_chat_loaded'):self._history_chat_loaded.discard(identity)
        while len(self._chat_history)>CHAT_HISTORY_CHATS:del self._chat_history[next(iter(self._chat_history))]
        if not hasattr(self,'_summary_reopen'):self._summary_reopen={}
        self._summary_reopen[identity]=(time.monotonic(),data)
        for key in list(self._summary_reopen):
            if time.monotonic()-self._summary_reopen[key][0]>=max(REOPEN_SECONDS):del self._summary_reopen[key]
        while len(self._summary_reopen)>16:del self._summary_reopen[next(iter(self._summary_reopen))]


    def _show_history(self):
        self._load_history_account(int(get_selected_account()))
        activity = self._compat_activity()
        if activity is None:
            return
        account = int(get_selected_account())
        entries = list(self._recent_by_account.get(account, []))
        if not entries:
            self._show_information("История сводок", "Здесь появятся последние результаты этого аккаунта. История сохраняется на устройстве после обновлений плагина. Новых запросов для просмотра нет.")
            return
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr("История · " + str(len(entries)) + "/5"))
        labels = [entry.created_at + " · " + str(entry.data[1].used) + " сообщений · " + PROVIDERS[entry.data[2]] for entry in entries]
        def choose(b, index):
            if not getattr(self, "_loaded", False) or not 0 <= index < len(entries):
                return
            if int(get_selected_account()) != account:
                BulletinHelper.show_info(_tr("Аккаунт сменился. Откройте историю заново."))
                return
            entry = entries[index]
            if not any(item is entry for item in self._recent_by_account.get(account, [])):
                BulletinHelper.show_info(_tr("Этот результат уже очищен или вытеснен новым."))
                return
            b.dismiss()
            self._show_result(activity, *entry.data)
        builder.set_message(_tr("Сохранено на устройстве. Полная история чата открывается через дату во вкладке «Сводки»."))
        builder.set_items(labels, choose)
        builder.set_negative_button(_tr("Закрыть"), lambda b, w: b.dismiss())
        builder.set_neutral_button(_tr("Очистить историю"), lambda b, w: (b.dismiss(), self._clear_history()))
        self._show_picker(builder)

    def _clear_history(self):
        activity = self._compat_activity()
        if activity is None:
            return
        account = int(get_selected_account())
        captured_owner=summary_history_owner(account)
        original = self._last_by_account.get(account)
        snapshot = tuple(self._recent_by_account.get(account, []))
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr("Очистить историю этого аккаунта?"))
        builder.set_message(_tr("Исчезнут локальные результаты и сопоставления имён. Ключи и настройки останутся. Данные у провайдера и в буфере обмена это не удаляет."))
        def clear(b, w):
            b.dismiss()
            if captured_owner and summary_history_owner(account)!=captured_owner:
                BulletinHelper.show_info(_tr('Аккаунт сменился. Очистка отменена.'));return
            if not getattr(self, "_loaded", False):
                return
            current = tuple(self._recent_by_account.get(account, []))
            if int(get_selected_account()) != account or self._last_by_account.get(account) is not original or len(current) != len(snapshot) or any(a is not b for a, b in zip(current, snapshot)):
                BulletinHelper.show_info(_tr("Аккаунт или история изменились. Откройте очистку заново."))
                return
            store=getattr(self,'_history_store',None);owner=summary_history_owner(account)
            if store is not None and owner:
                try:store.remove(owner)
                except Exception:self._notice(_tr('Не удалось очистить историю на устройстве.'),True);return
            self._invalidate_history_account(account)
            getattr(self,'_summary_ready',{}).pop(account,None)
            self._recent_by_account.pop(account, None)
            self._last_by_account.pop(account, None)
            for identity in list(getattr(self,'_chat_history',{})):
                if identity[0]==account:self._chat_history.pop(identity,None)
            for identity in list(getattr(self,'_summary_reopen',{})):
                if identity[0]==account:self._summary_reopen.pop(identity,None)
            if getattr(self, "_result_dialog_account", None) == account:
                dismiss_dialog(self._result_dialog)
            self._refresh_settings()
            self._event("history_clear")
            BulletinHelper.show_success(_tr("Локальная история этого аккаунта очищена."))
        builder.set_positive_button(_tr("Очистить"), clear)
        builder.set_negative_button(_tr("Отмена"), lambda b, w: b.dismiss())
        self._show_picker(builder)







    def _create_header_view(self, context, list_view, current_account, class_guid, resources_provider):
        return ui_stack(context, (16, 12, 16, 8))

    def _bind_header_view(self, view, item, divider, adapter, list_view):
        context = view.getContext()
        view.removeAllViews()
        try:
            ui_add(view, self._settings_hero(context))
        except Exception:
            # Decoration is optional; a fork-specific graphics problem must not hide settings.
            ui_add(view, ui_text(context, "Сводка сообщений · " + self._connection_state()[0], 16))

    def _settings_hero(self, context):
        palette = ui_palette()
        card = ui_stack(context, 16)
        ui_background(card, palette['soft'], 16)
        ui_add(card, ui_text(context, 'Сводка сообщений', 20, palette['text'], True))
        ui_add(card, ui_text(context, 'Главное, решения и задачи', 14, palette['muted']), top=8)
        provider = index_value(self.get_setting('provider', 0), len(PROVIDERS))
        model = str(self.get_setting(PROVIDER_KEYS[provider] + '_model', '') or '').strip() or DEFAULT_MODELS[provider]
        label = PROVIDERS[provider] + (' · ' + model if model else '')
        ui_add(card, ui_text(context, label, 13, palette['muted'], lines=2, translate=False), top=16)
        state, tone, hint = self._connection_state()
        status = ui_stack(context, horizontal=True)
        # A small status mark is the only semantic colour in the settings header.
        dot = ui_text(context, '●', 12, palette.get(tone, palette['muted']))
        ui_add(status, dot, 16, -2, right=4)
        ui_add(status, ui_text(context, state, 13, palette['text']), 0, -2, weight=1)
        ui_add(card, status, top=8)
        ui_add(card, ui_text(context, hint, 13, palette['muted']), top=8)
        return card


    def _hero_setting(self):
        if Custom is not None:
            if getattr(self, "_header_factory", None) is not None:
                try:
                    return Custom(factory=self._header_factory.instance.java)
                except Exception:
                    pass
            try:
                fragment = get_last_fragment()
                activity = fragment.getParentActivity() if fragment is not None else None
                if activity_alive(activity):
                    view = self._create_header_view(activity, None, 0, 0, None)
                    self._bind_header_view(view, None, False, None, None)
                    return Custom(view=view)
            except Exception:
                pass
        return localized_setting(Text, text="Главное из переписки", subtext=self._connection_state()[0], icon=native_icon("msg_info"), accent=True)

    def _supports_settings_pages(self):
        # Probe a plain data object, not a registered native factory. Old forks differ.
        known = getattr(self, "_settings_pages_supported", None)
        if known is None:
            try:
                probe = localized_setting(Text, text="", create_sub_fragment=lambda: [])
                known = callable(getattr(probe, "create_sub_fragment", None))
            except (TypeError, AttributeError):
                known = False
            self._settings_pages_supported = known
        return known

    def _settings_link(self, text, subtext, icon, rows):
        if self._supports_settings_pages():
            return localized_setting(Text, text=text, subtext=subtext, icon=native_icon(icon), create_sub_fragment=rows)
        return localized_setting(Text, text=text, subtext=subtext, icon=native_icon(icon),
                    on_click=lambda view: self._open_compat_page(text, rows))

    def _compat_activity(self):
        if not getattr(self, "_loaded", False):
            BulletinHelper.show_info(_tr("Сначала включите плагин, чтобы открыть этот раздел."))
            return None
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment is not None else None
        return activity if activity_alive(activity) else None

    def _open_compat_page(self, title, rows_factory):
        """Native-dialog subpages for SDKs without Text.create_sub_fragment."""
        activity = self._compat_activity()
        if activity is None:
            return
        rows = rows_factory()
        actions, labels, notes = [], [], []
        for row in rows:
            text = str(getattr(row, "text", "") or "")
            subtext = str(getattr(row, "subtext", "") or "")
            if isinstance(row, (Header, Divider)):
                if text:
                    notes.append(text)
                continue
            is_action = hasattr(row, "key") or callable(getattr(row, "on_click", None)) or callable(getattr(row, "create_sub_fragment", None))
            if not is_action:
                notes.append(text + (": " + subtext if subtext else ""))
                continue
            value = ""
            if isinstance(row, Selector):
                choices = list(row.items)
                if choices:
                    value = str(choices[index_value(self.get_setting(row.key, row.default), len(choices))])
            elif isinstance(row, Switch):
                value = "Включено" if self.get_setting(row.key, row.default) else "Выключено"
            elif isinstance(row, Input):
                value = str(self.get_setting(row.key, row.default) or "")
            labels.append(text + (" · " + value if value else ""))
            actions.append(row)
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr(title))
        if notes:
            builder.set_message(_tr("\n\n".join(notes)))

        def selected(b, index):
            if not getattr(self, "_loaded", False) or not 0 <= index < len(actions):
                return
            b.dismiss()
            row = actions[index]
            if isinstance(row, Selector):
                self._compat_select(title, row, rows_factory)
            elif isinstance(row, Switch):
                self._compat_save(row, not bool(self.get_setting(row.key, row.default)))
                self._open_compat_page(title, rows_factory)
            elif isinstance(row, Input):
                self._compat_input(title, row, rows_factory)
            elif callable(getattr(row, "create_sub_fragment", None)):
                self._open_compat_page(row.text, row.create_sub_fragment)
            elif callable(getattr(row, "on_click", None)):
                row.on_click(None)
        if actions:
            builder.set_items(labels, selected)
        builder.set_negative_button(_tr("Закрыть"), lambda b, w: b.dismiss())
        self._show_picker(builder)

    def _compat_save(self, row, value):
        callback = getattr(row, "on_change", None)
        if callable(callback):
            callback(value)
        else:
            self.set_setting(row.key, value, reload_settings=True)

    def _compat_select(self, title, row, rows_factory):
        activity = self._compat_activity()
        if activity is None:
            return
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr(row.text))

        def selected(b, index):
            if not getattr(self, "_loaded", False) or not 0 <= index < len(row.items):
                return
            self._compat_save(row, index)
            b.dismiss()
            self._open_compat_page(title, rows_factory)
        builder.set_items(list(row.items), selected)
        builder.set_negative_button(_tr("Назад"), lambda b, w: (b.dismiss(), self._open_compat_page(title, rows_factory)))
        self._show_picker(builder)

    def _compat_input(self, title, row, rows_factory):
        activity = self._compat_activity()
        if activity is None:
            return
        from android.widget import EditText
        from org.telegram.messenger import AndroidUtilities
        field = EditText(activity)
        field.setSingleLine(True)
        field.setText(str(self.get_setting(row.key, row.default) or ""))
        palette = ui_palette()
        field.setTextColor(palette["text"])
        field.setHint(_tr(str(getattr(row, "subtext", "") or row.text)))
        field.setPadding(*(AndroidUtilities.dp(14) for _ in range(4)))
        ui_background(field, palette["soft"], 14, palette["accent_border"])
        root = ui_stack(activity, (22, 8, 22, 8))
        ui_add(root, field)
        builder = SummaryDialogBuilder(activity)
        builder.set_title(_tr(row.text))
        builder.set_view(root)

        def save(b, w):
            if getattr(self, "_loaded", False):
                self._compat_save(row, str(field.getText()).strip())
            b.dismiss()
            self._open_compat_page(title, rows_factory)
        builder.set_positive_button(_tr("Сохранить"), save)
        builder.set_negative_button(_tr("Отмена"), lambda b, w: (b.dismiss(), self._open_compat_page(title, rows_factory)))
        self._show_picker(builder, cleanup=lambda: field.setText(""))


    def _model_settings(self, provider=None):
        provider = index_value(self.get_setting("provider", 0) if provider is None else provider, len(PROVIDERS))
        prefix = PROVIDER_KEYS[provider]
        default = DEFAULT_MODELS[provider]
        items = [
            localized_setting(Header, text="Модель · " + PROVIDERS[provider]),
            localized_setting(Text, text="Выбрать из списка", subtext="Получить доступные модели сервиса", icon=native_icon("msg_list"), accent=True,
                 on_click=lambda v, p=provider: self._start_api_action("models", provider=p)),
            localized_setting(Input, key=prefix + "_model", text="Название модели вручную", default="", subtext="Пустое поле → " + default if default else "Укажите точный ID модели вашего сервера", icon=native_icon("msg_edit"),
                  on_change=lambda value, key=prefix + "_model": self.set_setting(key, value.strip(), reload_settings=True)),
        ]
        if default:
            items.append(localized_setting(Text, text="Использовать по умолчанию", subtext=default, icon=native_icon("msg_reset"),
                 on_click=lambda v, key=prefix + "_model": self.set_setting(key, "", reload_settings=True)))
        items.append(localized_setting(Divider, text="Список моделей не передаёт переписку. После смены модели проверьте подключение."))
        return items

    def _advanced_settings(self):
        p = index_value(self.get_setting("provider", 0), len(PROVIDERS))
        prefix = PROVIDER_KEYS[p]
        items = [
            localized_setting(Header, text="Длина и ожидание"),
            localized_setting(Selector, key="input_index", text="Размер одной части", default=1, items=[str(n // 1000) + " тыс. символов" + (" · обычно достаточно" if n == 48000 else "") for n in INPUT_LIMITS], icon=native_icon("msg_list")),
            localized_setting(Selector, key="output_index", text="Максимум для ответа", default=1, items=[str(n) + " токенов" + (" · рекомендуется" if n == 4096 else "") for n in OUTPUT_LIMITS], icon=native_icon("msg_list")),
            localized_setting(Selector, key="timeout_index", text="Сколько ждать сервис", default=1, items=[str(n // 60) + " мин" for n in TIMEOUTS], icon=native_icon("msg_recent")),
            localized_setting(Divider, text="Лимит ответа включает reasoning, если модель его использует. Больший объём может стоить дороже."),
        ]
        if p in (PROVIDER_OPENAI, PROVIDER_CUSTOM):
            items += [localized_setting(Header, text="Совместимость сервиса"),
                localized_setting(Selector, key=prefix + "_api_mode", text="Формат API", default=1 if p == PROVIDER_CUSTOM else 0,
                         items=["Responses · современный", "Chat Completions · совместимый"], icon=native_icon("msg_settings")),
            ]
        if p == PROVIDER_CUSTOM:
            items.append(localized_setting(Switch, key="custom_modern_tokens", text="Новый параметр лимита", default=False,
                                subtext="max_completion_tokens вместо max_tokens. Только если этого требует сервер.", icon=native_icon("msg_settings")))
        if p == PROVIDER_OLLAMA:
            items += [localized_setting(Header, text="Локальная модель"),
                localized_setting(Selector, key="ollama_context_index", text="Размер контекста Ollama", default=2, items=[str(n) + " токенов" for n in OLLAMA_CONTEXTS], icon=native_icon("msg_list")),
                localized_setting(Divider, text="Большой контекст требует больше памяти. Модель и сервер должны его поддерживать."),
            ]
        items += [localized_setting(Header, text="Информация"),
            localized_setting(Text, text="Сводка сообщений " + __version__, subtext="SDK ≥1.4.3.3 · приложение ≥12.5.1", icon=native_icon("msg_info")),
        ]
        return items

    def _privacy_settings(self):
        rows = [
            localized_setting(Header, text="Что получает AI"),
            localized_setting(Divider, text="Выбранные сообщения отправляются настроенному AI-сервису после нажатия «Создать сводку»."),
            localized_setting(Header, text="Имена и личные данные"),
            localized_setting(Divider, text="Псевдонимы заменяют имя отправителя, но не удаляют телефоны, имена и секреты внутри текста. Не передавайте то, чем не готовы поделиться."),
            localized_setting(Header, text="Ключи и результаты"),
            localized_setting(Divider, text="Ключи хранятся в обычных настройках SDK. Готовые сводки, имена и ссылки сохраняются в закрытой папке приложения; исходная переписка и ключи в архив не записываются."),
            localized_setting(Header, text="Отмена и оплата"),
            localized_setting(Divider, text="AI-запрос может тарифицироваться. Отмена не отзывает запрос, уже принятый сервером. Условия хранения данных определяет провайдер."),
        ]
        if getattr(self, "_last_by_account", {}).get(int(get_selected_account())) is not None:
            rows += [localized_setting(Header, text="Локальные данные"), localized_setting(Text, text="Очистить последнюю сводку", subtext="Удалить сохранённую сводку этого аккаунта. Ключи останутся.", icon=native_icon("msg_delete"), red=True, on_click=lambda view: self._clear_last_result())]
        if getattr(self, "_recent_by_account", {}).get(int(get_selected_account())):
            rows.append(localized_setting(Text, text="Очистить всю историю", subtext="Только этот аккаунт. Ключи останутся.", icon=native_icon("msg_delete"), red=True, on_click=lambda view: self._clear_history()))
        return rows

    def _help_settings(self):
        items = [
            localized_setting(Header, text="Помощь рядом"),
            localized_setting(Text, text="Как начать", subtext="Приветствие и три простых шага", icon=native_icon("msg_info"), on_click=lambda view: self._show_welcome()),
            localized_setting(Text, text="Где получить API-ключ", subtext="Открыть страницу выбранного сервиса", icon=native_icon("msg_link"), on_click=lambda view: self._open_provider_portal()),
            localized_setting(Text, text="Частые вопросы", subtext="Подключение, оплата, отмена и Ollama", icon=native_icon("msg_info"), on_click=lambda view: self._show_faq()),
            localized_setting(Divider, ), localized_setting(Header, text="Данные и диагностика"),
            self._settings_link("Приватность и оплата", "Что отправляется и как работает отмена", "msg_secret", self._privacy_settings),
            localized_setting(Text, text="Диагностика и события", subtext="Посмотреть журнал или скопировать безопасный отчёт", icon=native_icon("msg_settings"), on_click=lambda view: self._show_diagnostics()),
            localized_setting(Text, text="История сводок", subtext="Последние пять результатов этого аккаунта", icon=native_icon("msg_recent"), on_click=lambda view: self._show_history()),
            localized_setting(Text, text="О плагине", subtext="Сводка сообщений " + __version__ + "", icon=native_icon("msg_info"), on_click=lambda view: self._show_about()),
            localized_setting(Divider, text="Секретные чаты, голосовые, OCR и специальные режимы истории не поддерживаются. Медиа без подписей пропускаются."),
        ]
        if self.get_setting("model_migration_notice", False):
            items.append(localized_setting(Divider, text="Модель Gemini 2.0 из старых настроек заменена моделью по умолчанию. При необходимости выберите другую."))
        return items

    def _settings_rows(self):
        self._load_history_account(int(get_selected_account()))
        p = index_value(self.get_setting("provider", 0), len(PROVIDERS))
        prefix = PROVIDER_KEYS[p]
        model = str(self.get_setting(prefix + "_model", "") or "").strip() or DEFAULT_MODELS[p]
        has_key = bool(self.get_setting(prefix + "_api_key", ""))
        optional = p in (PROVIDER_OLLAMA, PROVIDER_CUSTOM)
        items = [
            self._hero_setting(),
            localized_setting(Selector, key='ui_language_index', text='Язык интерфейса', default=0, items=[name for code,name in UI_LANGUAGES],
                     on_change=lambda index: self._apply_preferences('ui_language', UI_LANGUAGES[index][0])),
            localized_setting(Text, text="Как начать", subtext="Три шага до первой сводки", icon=native_icon("msg_info"), on_click=lambda view: self._show_welcome()),
            localized_setting(Text, text="Стиль и длина ответа", subtext="Настроить результат сводки", icon=native_icon("msg_settings"), on_click=lambda view: self._show_presets()),
            localized_setting(Divider, ), localized_setting(Header, text='Оформление и язык'),
            localized_setting(Selector, key='ui_theme', text='Цвета интерфейса', default=0, items=[name for name,colors in UI_THEMES],
                     on_change=lambda index: self._apply_preferences('ui_theme', index)),
            localized_setting(Selector,key='summary_design',text='Дизайн сводки',default=0,items=SUMMARY_DESIGNS,
                     on_change=lambda index:self._apply_preferences('summary_design',index)),
            localized_setting(Text,text='Посмотреть варианты',subtext='Предпросмотр без запроса к AI',icon=native_icon('msg_palette'),on_click=lambda view:self._show_design_preview()),
            localized_setting(Text,text='Посмотреть цвета',subtext='Предпросмотр без запроса к AI',icon=native_icon('msg_palette'),on_click=lambda view:self._show_design_preview('colors')),
            localized_setting(Switch,key='ui_animations',text='Анимации сводки',default=True,
                     subtext='Плавное появление. Учитывает отключение анимаций в Android.',
                     on_change=lambda value:self._apply_preferences('ui_animations',bool(value))),
            localized_setting(Divider, ), localized_setting(Header, text="Подключение"),
            localized_setting(Selector, key="provider", text="AI-сервис", default=0, items=PROVIDERS, icon=native_icon("msg_bots"), on_change=lambda i: self.set_setting("provider", i, reload_settings=True)),
            localized_setting(Text, text="Ключ сервера" if optional else "API-ключ", subtext="Ключ сохранён · скрыт" if has_key else ("Необязателен для этого сервера" if optional else "Нажмите, чтобы добавить"), icon=native_icon("msg_secret"), on_click=lambda v: self._open_key_editor(p)),
        ]
        if p in (PROVIDER_CUSTOM, PROVIDER_OLLAMA):
            items.append(localized_setting(Input, key="ollama_endpoint" if p == PROVIDER_OLLAMA else "custom_endpoint", text="Адрес сервера",
                default="http://127.0.0.1:11434" if p == PROVIDER_OLLAMA else "",
                subtext="Для ПК укажите его IP в вашей сети; 127.0.0.1 — телефон" if p == PROVIDER_OLLAMA else "Например: https://server.example/v1", icon=native_icon("msg_link")))
            items.append(localized_setting(Switch, key=prefix + "_allow_http", text="Разрешить HTTP", default=False,
                                subtext="Без шифрования. Только для доверенной сети и сервера.", icon=native_icon("msg_info")))
        items += [
            self._settings_link("Модель", model or "Нажмите, чтобы выбрать", "msg_topics", lambda provider=p: self._model_settings(provider)),
            *self._reasoning_rows(p,model),
            localized_setting(Text, text="Проверить подключение", subtext="Короткий тест без переписки; возможна оплата API", icon=native_icon("msg_pin_code"), accent=True, on_click=lambda v: self._start_api_action("test")),
            localized_setting(Divider, ), localized_setting(Header, text="Как отвечать"),
            self._default_style_row(),
            localized_setting(Text,text='Стили сводок',subtext='Добавить, изменить и удалить',icon=native_icon('msg_edit'),on_click=lambda view:self._show_styles()),
            localized_setting(Selector, key="lang", text="Язык ответа", default=0, items=LANGS, icon=native_icon("msg_translate")),
            localized_setting(Switch, key="anonymize", text="Скрывать имена", default=True, subtext="AI получает Telegram ID вместо имён. Имена внутри текста не удаляются.", icon=native_icon("msg_secret")),
            localized_setting(Switch,key='nick_text_colours',text='Разные цвета имён',default=True,
                   subtext='Выделять имена в тексте сводки.',on_change=lambda value:self._apply_preferences('nick_text_colours',bool(value))),
            localized_setting(Divider, ), localized_setting(Header, text="Кнопки в чате"),
            localized_setting(Switch, key="summary_header", text="Кнопка в шапке чата", default=True,
                   subtext="Есть непрочитанные — сводка всех. Нет — выбор прочитанных. Удержание — новая.", icon=native_icon("msg_list"),
                   on_change=lambda value: self._summary_ui_change("summary_header", value)),
            localized_setting(Text,text='Значок кнопки в шапке',subtext=_tr(HEADER_ICONS[index_value(self.get_setting('summary_header_icon',0),len(HEADER_ICONS))]['name']),icon=native_icon('msg_list'),on_click=lambda view:self._show_header_icons()),
            localized_setting(Switch,key='summary_menu',text='Сводка в меню ⋮',default=True,
                   subtext='Обычная, подробная сводка и история текущего чата.',icon=native_icon('msg_list'),
                   on_change=lambda value:self._summary_ui_change('summary_menu',value)),
            localized_setting(Switch, key="tap_unread_badge", text="Нажатие на разделитель непрочитанных", default=True,
                   subtext="Открывать сводку по плашке «Непрочитанные сообщения».", icon=native_icon("msg_message"),
                   on_change=lambda value: self._summary_ui_change("tap_unread_badge", value)),
            localized_setting(Selector,key='summary_reopen_index',text='Повторно открывать готовую сводку',default=3,
                   items=REOPEN_LABELS,on_change=lambda index:self._apply_preferences('summary_reopen_index',index)),
            localized_setting(Divider,text='Срок отсчитывается от готовности. Затем откроется окно новой сводки. История сохраняется на устройстве после обновления плагина.'),
        ]
        if getattr(self, "_last_by_account", {}).get(int(get_selected_account())) is not None:
            items.append(localized_setting(Text, text="Последняя сводка", subtext="Открыть результат в этом аккаунте", icon=native_icon("msg_recent"), on_click=lambda v: self._show_last_result()))
        if getattr(self, "_recent_by_account", {}).get(int(get_selected_account())):
            items.append(localized_setting(Text, text="История сводок", subtext="Последние пять · сохранены на устройстве", icon=native_icon("msg_recent"), on_click=lambda view: self._show_history()))
        if getattr(self, "_job", None) is not None:
            items.append(localized_setting(Text, text="Отменить текущий запрос", subtext="Уже принятый сервером запрос отозвать нельзя", red=True, icon=native_icon("msg_warning"), on_click=lambda v: self.cancel_job()))
        items += [
            self._settings_link("Дополнительно", "Длина ответа, ожидание и формат API", "msg_settings", self._advanced_settings),
            self._settings_link("Помощь", "FAQ, поддержка и безопасная диагностика", "msg_info", self._help_settings),
            localized_setting(Divider, text="Удерживайте кнопку в шапке, чтобы сделать новую сводку раньше выбранного срока.\n\n"),
        ]
        self._note_icon_fallbacks()
        return items

    def _style_catalog(self):
        return parse_style_catalog(self.get_setting('summary_styles_v1',None))

    def _selected_style(self):
        return resolve_style(self._style_catalog(),str(self.get_setting('summary_style_id','') or ''),self.get_setting('style',0))

    def _store_styles(self, records):
        current=self._selected_style()
        self.set_setting('summary_styles_v1',json.dumps(records,ensure_ascii=False))
        chosen=resolve_style(records,current['id'],style_legacy_index(current))
        self.set_setting('summary_style_id',chosen['id']);self.set_setting('style',style_legacy_index(chosen))
        self._refresh_settings()

    def _default_style_row(self):
        return Text(text=_tr('Стиль сводки'),subtext=style_title(self._selected_style()),icon=native_icon('msg_list'),
                    on_click=lambda view:self._choose_default_style())

    def _choose_default_style(self):
        activity=self._compat_activity()
        if activity is None:return
        records=self._style_catalog() or [neutral_style()];current=self._selected_style()['id']
        builder=SummaryDialogBuilder(activity);builder.set_title(_tr('Стиль сводки'))
        def select(b,index):
            if not self._loaded:return
            record=records[int(index)]
            self.set_setting('summary_style_id',record['id']);self.set_setting('style',style_legacy_index(record))
            b.dismiss();self._refresh_settings()
        builder.set_items([('✓  ' if r['id']==current else '')+style_title(r) for r in records],select)
        builder.set_negative_button(_tr('Отмена'),lambda b,w:b.dismiss());self._show_picker(builder)

    def _show_styles(self):
        if not self._loaded:return
        activity=self._compat_activity()
        if activity is None:return
        records=self._style_catalog();palette=ui_palette();owner=object();builder=SummaryDialogBuilder(activity)
        builder.set_title(_tr('Стили сводок'));root=ui_stack(activity,(20,0,20,12));content=ui_stack(activity)
        if not records:ui_add(content,ui_text(activity,'Стили не добавлены',14,palette['muted']),bottom=12)
        for record in records:
            def edit(record=dict(record)):builder.dismiss();self._show_style_editor(record)
            row=self._menu_row(activity,style_title(record),_tr('Предустановленный' if record['id'] in BUILTIN_STYLE_IDS else 'Свой стиль'),palette,edit,owner)
            ui_add(content,row,bottom=6)
        ui_add(root,ui_dialog_scroll(activity,content,360,0.48))
        add=self._menu_row(activity,_tr('Добавить стиль'),'',palette,lambda:(builder.dismiss(),self._add_style_picker()),owner)
        ui_add(root,add,top=8);builder.set_view(root)
        builder.set_negative_button(_tr('Закрыть'),lambda b,w:b.dismiss())
        self._show_picker(builder,cleanup=lambda:self._clear_view_actions(owner))

    def _add_style_picker(self):
        if not self._loaded:return
        activity=self._compat_activity()
        if activity is None:return
        present={r['id'] for r in self._style_catalog()}
        missing=[r for r in builtin_styles() if r['id'] not in present]
        builder=SummaryDialogBuilder(activity);builder.set_title(_tr('Добавить стиль'))
        def selected(b,index):
            b.dismiss()
            if not self._loaded:return
            if int(index)==0:self._show_style_editor();return
            record=missing[int(index)-1];records=self._style_catalog()
            if not any(r['id']==record['id'] for r in records):self._store_styles(records+[dict(record)])
            self._show_styles()
        builder.set_items([_tr('Свой стиль')]+[style_title(r) for r in missing],selected)
        builder.set_negative_button(_tr('Назад'),lambda b,w:(b.dismiss(),self._show_styles()));self._show_picker(builder)

    def _save_style(self, original, name, prompt):
        name,prompt=validate_style_draft(name,prompt)
        record={'id':original['id'] if original else 'custom:'+uuid.uuid4().hex,'name':name,'prompt':prompt}
        records=self._style_catalog();position=next((i for i,r in enumerate(records) if r['id']==record['id']),None)
        if position is None:records.append(record)
        else:records[position]=record
        self._store_styles(records);return record

    def _delete_style(self, key):
        self._store_styles([record for record in self._style_catalog() if record['id']!=key])

    def _show_style_editor(self, record=None):
        if not self._loaded:return
        activity=self._compat_activity()
        if activity is None:return
        from android.widget import EditText
        from android.text import InputType
        from org.telegram.messenger import AndroidUtilities
        palette=ui_palette();owner=object();builder=SummaryDialogBuilder(activity)
        builder.set_title(_tr('Редактировать стиль' if record else 'Свой стиль'))
        root=ui_stack(activity,(20,0,20,12));content=ui_stack(activity)
        def field(label,value,multiline=False):
            ui_add(content,ui_text(activity,label,13,palette['muted']),top=12,bottom=8)
            view=EditText(activity);view.setSingleLine(not multiline)
            view.setInputType(InputType.TYPE_CLASS_TEXT|(InputType.TYPE_TEXT_FLAG_MULTI_LINE if multiline else 0))
            view.setText(value);view.setTextSize(15.0);view.setTextColor(palette['text']);view.setHintTextColor(palette['muted'])
            view.setPadding(*(AndroidUtilities.dp(12) for _ in range(4)));ui_background(view,palette['soft'],12)
            if multiline:view.setMinLines(4);view.setMaxLines(8);view.setGravity(48)
            ui_add(content,view);return view
        name=field('Название стиля',record['name'] if record else '')
        prompt=field('Промпт стиля',record['prompt'] if record else '',True)
        ui_add(content,ui_text(activity,'Описывает подачу. Имена, карточки и ссылки сохраняются автоматически.',12,palette['muted']),top=8)
        error=ui_text(activity,'',13,palette['warning'],translate=False);ui_add(content,error,top=8)
        ui_add(root,ui_dialog_scroll(activity,content,380,0.50));state={'closed':False}
        def save():
            if state['closed'] or not self._loaded:return
            try:self._save_style(record,name.getText(),prompt.getText())
            except SummaryError as exception:error.setText(_tr(exception.message));return
            builder.dismiss();self._show_styles()
        save_button=self._menu_row(activity,_tr('Сохранить'),'',palette,save,owner);ui_add(root,save_button,top=8)
        def delete(b,w):
            draft=dict(record,name=str(name.getText()),prompt=str(prompt.getText()));b.dismiss()
            dialog=SummaryDialogBuilder(activity);dialog.set_title(_tr('Удалить стиль?'));dialog.set_message(draft['name'])
            dialog.set_positive_button(_tr('Удалить'),lambda d,i:(d.dismiss(),self._delete_style(record['id']),self._show_styles()) if self._loaded else d.dismiss())
            dialog.set_negative_button(_tr('Отмена'),lambda d,i:(d.dismiss(),self._show_style_editor(draft)))
            self._show_picker(dialog)
        if record:builder.set_neutral_button(_tr('Удалить'),delete)
        builder.set_negative_button(_tr('Отмена'),lambda b,w:(b.dismiss(),self._show_styles()))
        builder.set_view(root)
        def cleanup():
            state['closed']=True;self._clear_view_actions(owner)
            try:AndroidUtilities.hideKeyboard(name);AndroidUtilities.hideKeyboard(prompt)
            except Exception:pass
        self._show_picker(builder,cleanup=cleanup)

    def _header_drawable(self, activity, index):
        import base64
        from java import jarray,jbyte
        from android.graphics import BitmapFactory,Bitmap
        from android.graphics.drawable import BitmapDrawable
        from org.telegram.messenger import AndroidUtilities
        pixels=int(AndroidUtilities.dp(24));index=index_value(index,len(HEADER_ICONS))
        if index==0:return None
        cache=getattr(self,'_header_bitmaps',None)
        if cache is None:self._header_bitmaps=cache={}
        key=(index,pixels)
        if key not in cache:
            data=base64.b64decode(HEADER_PNG[index-1])
            array=jarray(jbyte)([(value if value<128 else value-256) for value in data])
            decoded=BitmapFactory.decodeByteArray(array,0,len(data))
            if decoded is None:raise ValueError('icon_decode')
            cache[key]=Bitmap.createScaledBitmap(decoded,pixels,pixels,True)
            cache[key].setDensity(int(activity.getResources().getDisplayMetrics().densityDpi))
        return BitmapDrawable(activity.getResources(),cache[key])

    def _apply_header_icon(self, state):
        item=state.get('button')
        if item is None:return
        index=index_value(self.get_setting('summary_header_icon',0),len(HEADER_ICONS))
        fragment=state['fragment']
        try:colour=header_theme_colour(fragment)
        except Exception:colour=None
        try:item_key=int(item.hashCode())
        except Exception:item_key=id(item)
        signature=(item_key,index,colour)
        if state.get('header_icon_signature')==signature:return
        if state.get('header_icon_failed_signature')==signature and time.monotonic()<state.get('header_icon_retry_at',0):return
        stage='drawable'
        try:
            previous=state.get('header_icon_signature')
            if previous is None or previous[:2]!=signature[:2]:
                activity=fragment.getParentActivity()
                if index:
                    drawable=self._header_drawable(activity,index);stage='set_icon';item.setIcon(drawable)
                else:
                    resource=int(activity.getResources().getIdentifier('msg_list','drawable',str(activity.getPackageName())))
                    if not resource:raise ValueError('native_icon_missing')
                    stage='set_icon';item.setIcon(resource)
            stage='tint'
            if colour is not None:item.setIconColor(colour)
            state['header_icon_signature']=signature
            state.pop('header_icon_failed_signature',None);state.pop('header_icon_retry_at',None)
            self._last_header_icon_status={'requested':index,'applied':index,'ok':True}
        except Exception as error:
            state.pop('header_icon_signature',None)
            state['header_icon_failed_signature']=signature;state['header_icon_retry_at']=time.monotonic()+5.0
            self._last_header_icon_status={'requested':index,'ok':False,'stage':stage,'error':type(error).__name__}


    def _set_header_icon(self, index):
        index=index_value(index,len(HEADER_ICONS))
        self.set_setting('summary_header_icon',index)
        def apply():
            if not self._loaded:return
            for state in list(getattr(self,'_chat_states',{}).values()):
                state.pop('header_icon_signature',None);state.pop('header_icon_failed_signature',None)
                state.pop('header_icon_retry_at',None)
                self._apply_header_icon(state)
            # A settings refresh must not prevent closing the picker or persisting the choice.
            try:self._refresh_settings()
            except Exception:pass
        run_on_ui_thread(apply)


    def _show_header_icons(self):
        def open_preview():
            if not self._loaded:return
            activity=self._compat_activity()
            if activity is None:return
            owner=object();builder=None;stage='imports'
            try:
                from android.widget import ImageView
                from android.graphics import PorterDuff,PorterDuffColorFilter
                palette=ui_palette();builder=SummaryDialogBuilder(activity)
                builder.set_title(_tr('Посмотреть значки'))
                root=ui_stack(activity,(20,0,20,12));content=ui_stack(activity)
                current=index_value(self.get_setting('summary_header_icon',0),len(HEADER_ICONS))
                try:colour=header_theme_colour(get_last_fragment())
                except Exception:colour=None
                if colour is None:colour=palette['text']
                failures=0;stage='rows'
                for index,icon in enumerate(HEADER_ICONS):
                    row=ui_stack(activity,(12,10,12,10),horizontal=True)
                    try:
                        thumb=ImageView(activity)
                        if index:thumb.setImageDrawable(self._header_drawable(activity,index))
                        else:
                            resource=int(activity.getResources().getIdentifier('msg_list','drawable',str(activity.getPackageName())))
                            if resource:thumb.setImageResource(resource)
                        thumb.setColorFilter(PorterDuffColorFilter(colour,PorterDuff.Mode.MULTIPLY))
                        thumb.setClickable(False);ui_add(row,thumb,32,32,right=12)
                    except Exception:
                        failures+=1
                        ui_add(row,ui_text(activity,str(index),13,palette['muted']),32,32,right=12)
                    ui_add(row,ui_text(activity,_tr(icon['name']),15,palette['text'],translate=False),0,-2,weight=1)
                    ui_add(row,ui_text(activity,'✓' if index==current else '',16,palette['accent']),24,-2,left=8)
                    ui_background(row,palette['soft'],12,ripple=ui_mix(palette['soft'],palette['text'],0.1))
                    def choose(index=index):builder.dismiss();self._set_header_icon(index)
                    self._bind_view_action(row,choose,owner=owner);ui_add(content,row,bottom=6)
                stage='show'
                ui_add(root,ui_dialog_scroll(activity,content,440,0.56));builder.set_view(root)
                builder.set_negative_button(_tr('Закрыть'),lambda b,w:b.dismiss())
                self._show_picker(builder,cleanup=lambda:self._clear_view_actions(owner))
                self._last_header_picker_status={'open':True,'fallback':False,'failed_previews':failures}
            except Exception as error:
                self._clear_view_actions(owner)
                if builder is not None:dismiss_dialog(builder)
                self._last_header_picker_status={'open':False,'fallback':True,'stage':stage,'error':type(error).__name__}
                try:
                    self._show_header_icon_list(activity)
                    self._last_header_picker_status['open']=True
                except Exception as fallback_error:
                    self._last_header_picker_status['fallback_error']=type(fallback_error).__name__
                    self._notice(_tr('Используйте список «Значок кнопки в шапке» в настройках.'),True)
        run_on_ui_thread(open_preview)

    def _show_header_icon_list(self, activity):
        """Drawing-free fallback, also used by the SDK Selector in the settings page."""
        if not self._loaded:return
        current=index_value(self.get_setting('summary_header_icon',0),len(HEADER_ICONS))
        builder=SummaryDialogBuilder(activity);builder.set_title(_tr('Значок кнопки в шапке'))
        def selected(b,index):
            b.dismiss()
            if self._loaded:self._set_header_icon(index)
        builder.set_items([('✓  ' if index==current else '')+_tr(icon['name']) for index,icon in enumerate(HEADER_ICONS)],selected)
        builder.set_negative_button(_tr('Закрыть'),lambda b,w:b.dismiss())
        self._show_picker(builder)






