def ui_reading_scroll(context, content):
    from android.widget import LinearLayout,ScrollView,FrameLayout
    from android.view import ViewGroup
    from org.telegram.messenger import AndroidUtilities
    holder=ui_stack(context)
    scroll=ScrollView(context)
    scroll.setFillViewport(False)
    scroll.setPadding(0,AndroidUtilities.dp(8),0,AndroidUtilities.dp(16))
    # Content stays inside its own viewport; no drawing beneath the search field.
    scroll.setClipToPadding(True)
    scroll.setVerticalFadingEdgeEnabled(False)
    scroll.setVerticalScrollBarEnabled(True)
    scroll.setOverScrollMode(2)
    scroll.setDescendantFocusability(ViewGroup.FOCUS_BEFORE_DESCENDANTS)
    scroll.addView(content,FrameLayout.LayoutParams(-1,-2))
    holder.addView(scroll,LinearLayout.LayoutParams(-1,-1))
    return holder


UI_TRANSLATIONS.update({'с текстом': {'en': 'with text', 'uk': 'з текстом'}})


def summary_search_ranges(text, query):
    """Literal Unicode matching; offsets are converted to UTF-16 only at the UI edge."""
    query=str(query).strip()
    if not query:return []
    return [(m.start(),m.end()) for m in re.finditer(re.escape(query),str(text),re.IGNORECASE)]


def filter_summary_entries(entries, query):
    if not str(query).strip():return list(entries)
    return [entry for entry in entries if summary_search_ranges(entry[0]+'\n'+entry[1],query)]


def ui_mark_matches(view, query, palette):
    if not str(query).strip():return
    try:
        from android.text import SpannableStringBuilder,Spanned
        from android.text.style import BackgroundColorSpan
        value=SpannableStringBuilder(view.getText())
        plain=str(value.toString())
        fill=ui_mix(palette['soft'],palette['accent'],0.24)
        for start,end in summary_search_ranges(plain,query):
            value.setSpan(BackgroundColorSpan(fill),utf16_offset(plain,start),utf16_offset(plain,end),Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
        # Preserve the actual URLSpan objects; their ownership records stay valid.
        view.setText(value)
    except Exception:pass

