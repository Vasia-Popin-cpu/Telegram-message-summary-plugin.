SUMMARY_PERIODS = [('hour','Последний час'),('day','Последние сутки'),('yesterday','Вчера'),
                   ('week','Последняя неделя'),('month','Последний месяц'),
                   ('half_year','Последние полгода'),('all','Весь чат')]


def period_label(period):
    return _tr(dict(SUMMARY_PERIODS).get(period,'За период'))


def period_bounds(period, now=None):
    """Freeze Unix [start,end) at launch; calendar dates use the device's local time."""
    if period not in dict(SUMMARY_PERIODS):
        raise SummaryError('detail_period','Выберите период заново.')
    anchor=int(time.time() if now is None else now)
    local=datetime.fromtimestamp(anchor)
    end=anchor+1
    if period=='all':return 0,end
    seconds={'hour':3600,'day':86400,'week':7*86400}
    if period in seconds:return max(0,anchor-seconds[period]),end
    if period=='yesterday':
        midnight=local.replace(hour=0,minute=0,second=0,microsecond=0)
        return int((midnight-timedelta(days=1)).timestamp()),int(midnight.timestamp())
    months=1 if period=='month' else 6
    index=local.year*12+local.month-1-months
    year,month=divmod(index,12);month+=1
    start=local.replace(year=year,month=month,day=min(local.day,monthrange(year,month)[1]))
    return max(0,int(start.timestamp())),end


def period_range_text(transcript):
    if transcript.detail is None or not transcript.detail.period:return ''
    start,end=transcript.period_start,transcript.period_end
    if end<=0:return period_label(transcript.detail.period)
    first=datetime.fromtimestamp(start).strftime('%d.%m.%Y %H:%M') if start else _tr('Начало доступной истории')
    last=datetime.fromtimestamp(end-1).strftime('%d.%m.%Y %H:%M')
    return period_label(transcript.detail.period)+' · '+first+' — '+last


def summary_result_title(transcript):
    options=transcript.detail
    if options is not None and options.period:return _tr('Сводка за период')
    if options is not None:return _tr('Сводка прочитанных' if not options.include_unread else 'Подробная сводка')
    return _tr('Сводка непрочитанных')


def fetch_period_history(job, progress=None):
    """All accessible messages in a frozen time interval, independent of read status."""
    options=validate_detailed(job.detail)
    start,end=job.period_window or period_bounds(options.period)
    job.period_window=(start,end)
    peer=get_messages_controller(account=job.account).getInputPeer(job.dialog_id)
    if peer is None or 'inputPeerEmpty' in class_name(peer):
        raise SummaryError('peer','Не удалось определить исходный чат.')
    messages,users,chats={}, {}, {}
    offset=0;boundary=UnreadBounds(0,0,0,'period');pages=0
    while True:
        check_cancel(job.cancel)
        response=request_history_page(job,peer,offset,HISTORY_PAGE_SIZE,bounds_override=boundary,
                                      offset_date=end if offset==0 else 0)
        users.update(object_map(getattr(response,'users',None)))
        chats.update(object_map(getattr(response,'chats',None)))
        page=list_values(response.messages)
        if not page:break
        ids=[];reached_start=False
        for message in sorted(page,key=lambda m:int(getattr(raw_message(m),'id',0) or 0),reverse=True):
            raw=raw_message(message);mid=int(getattr(raw,'id',0) or 0)
            if mid<=0 or (offset and mid>=offset) or (job.thread_id and mid==job.thread_id):continue
            ids.append(mid)
            # MessageEmpty and service placeholders may have no date; they cannot define a time edge.
            stamp=int(getattr(raw,'date',0) or 0)
            if stamp<=0:continue
            if start and stamp<start:reached_start=True;continue
            if stamp<end:messages.setdefault(mid,message)
        if not ids:
            if job.thread_id and all(int(getattr(raw_message(m),'id',0) or 0)==job.thread_id for m in page):break
            raise SummaryError('history_offset','Telegram не продвинул историю за период. Неполная сводка не отправлена.')
        new_offset=min(ids)
        if offset and new_offset>=offset:raise SummaryError('history_offset','Не удалось продолжить историю за период.')
        if boundary.upper_id==0:boundary=UnreadBounds(0,max(ids),0,'period')
        offset=new_offset;pages+=1
        if progress:progress(_tr('За период найдено сообщений')+': '+str(len(messages)))
        if reached_start or len(page)<HISTORY_PAGE_SIZE:break
    if not messages:raise SummaryError('history_empty','За выбранный период нет доступных сообщений.')
    job.read_context_ids=frozenset()
    job.history_counts={'period':options.period,'selected':len(messages),'pages':pages,'start':start,'end':end}
    return sorted(messages.values(),key=lambda m:int(raw_message(m).id)),users,chats





