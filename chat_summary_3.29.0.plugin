def workspace_release_target(origin, position, dx, velocity, width, density=1.0, cancelled=False):
    if cancelled:return int(origin)
    if abs(dx)>=12*density and abs(velocity)>=600*density:
        return max(0,min(1,int(origin)+(1 if velocity<0 else -1)))
    # A short deliberate drag returns to its origin; crossing halfway commits.
    return max(0,min(1,int(math.floor(float(position)+0.5))))

def workspace_animation_end(callback):
    from android.animation import Animator
    from java import dynamic_proxy
    class End(dynamic_proxy(Animator.AnimatorListener)):
        def onAnimationStart(self,*args):pass
        def onAnimationRepeat(self,*args):pass
        def onAnimationCancel(self,*args):pass
        def onAnimationEnd(self,*args):callback()
    return End()

def workspace_interpolator():
    from android.view.animation import PathInterpolator
    return PathInterpolator(0.22,1.0,0.36,1.0)

class WorkspacePagerMotion:
    """Two persistent native pages: finger tracking, native settle, owned cleanup."""
    def __init__(self,container,pages,indicator,allowed,selected,density=1.0):
        self.container=container;self.pages=tuple(pages);self.indicator=indicator
        self.allowed=allowed;self.selected=selected;self.density=density
        self.index=0;self.position=0.0;self.width=1.0;self.closed=False
        self.revision=0;self.listener=None;self.dragging=False;self.origin=0;self.start=0.0
    def _cancel(self):
        self.revision+=1
        for view in self.pages+(self.indicator,):
            try:view.animate().setListener(None).cancel()
            except Exception:pass
        self.listener=None
    def _place(self,position,rest=False):
        self.position=max(0.0,min(1.0,float(position)))
        for i,view in enumerate(self.pages):
            view.setTranslationX((i-self.position)*self.width);view.setAlpha(1.0)
            view.setVisibility(0 if not rest or i==self.index else 4)
        self.indicator.setTranslationX(self.position*self.width/2)
    def resize(self,width):
        if self.closed or width<=0 or abs(self.width-width)<1:return
        self._cancel();self.width=float(width);self.dragging=False
        try:
            params=self.indicator.getLayoutParams();params.width=max(1,int(self.width/2));self.indicator.setLayoutParams(params)
        except Exception:pass
        self._place(self.index,True)
    def measure(self):
        try:self.resize(float(self.container.getWidth()))
        except Exception:pass
    def begin(self):
        if self.closed:return
        self.measure()
        try:position=-float(self.pages[0].getTranslationX())/self.width
        except Exception:position=self.position
        self._cancel();self.origin=self.index;self.start=max(0.0,min(1.0,position));self.dragging=True
        self._place(self.start)
    def drag(self,dx):
        if not self.closed and self.dragging:self._place(self.start-float(dx)/self.width)
    def release(self,dx=0.0,velocity=0.0,cancelled=False):
        if self.closed:return
        target=workspace_release_target(self.origin,self.position,dx,velocity,self.width,self.density,cancelled)
        self.dragging=False;self.select(target)
    def select(self,index,animate=True):
        if self.closed:return
        index=max(0,min(1,int(index)));self.measure()
        try:self.position=max(0.0,min(1.0,-float(self.pages[0].getTranslationX())/self.width))
        except Exception:pass
        self._cancel()
        self.index=index;self.selected(index)
        distance=abs(self.position-index)
        if not animate or not self.allowed() or distance<0.001:
            self._place(index,True);return
        revision=self.revision
        try:
            easing=workspace_interpolator()
            def complete():
                if self.closed or revision!=self.revision:return
                self._place(index,True);self.listener=None
            self.listener=workspace_animation_end(complete)
            duration=max(140,min(280,int(140+distance*140)))
            for i,view in enumerate(self.pages):
                view.setVisibility(0)
                animator=view.animate().translationX((i-index)*self.width).alpha(1.0).setStartDelay(0)
                animator.setDuration(duration).setInterpolator(easing).setListener(self.listener if i==0 else None).start()
            self.indicator.animate().translationX(index*self.width/2).setStartDelay(0).setDuration(duration).setInterpolator(easing).start()
        except Exception:self._cancel();self._place(index,True)
    def dispose(self):
        if self.closed:return
        self.closed=True;self._cancel();self._place(self.index,True)

class WorkspaceContentMotion:
    """A bounded history/result transition with no delayed callbacks after disposal."""
    def __init__(self,container,allowed,density=1.0):
        self.container=container;self.allowed=allowed;self.density=density
        self.current=None;self.views=[];self.closed=False;self.revision=0;self.listener=None
    def _cancel(self):
        self.revision+=1
        for view in self.views:
            try:view.animate().setListener(None).cancel()
            except Exception:pass
        self.listener=None
    def replace(self,view,direction=0):
        if self.closed:return
        from android.widget import FrameLayout
        outgoing=self.current;self._cancel();self.container.removeAllViews()
        self.current=view;self.views=[view]
        animate=bool(direction and outgoing is not None and self.allowed())
        if animate:self.container.addView(outgoing,FrameLayout.LayoutParams(-1,-1));self.views.insert(0,outgoing)
        self.container.addView(view,FrameLayout.LayoutParams(-1,-1))
        view.setAlpha(1.0);view.setTranslationX(0.0)
        if not animate:return
        revision=self.revision
        def complete():
            if self.closed or revision!=self.revision:return
            self.container.removeView(outgoing);view.setAlpha(1.0);view.setTranslationX(0.0)
            self.views=[view];self.listener=None
        try:
            easing=workspace_interpolator();self.listener=workspace_animation_end(complete)
            view.setAlpha(0.0);view.setTranslationX(float(direction*24*self.density))
            outgoing.animate().translationX(float(-direction*12*self.density)).alpha(0.0).setStartDelay(0).setDuration(180).setInterpolator(easing).setListener(None).start()
            view.animate().translationX(0.0).alpha(1.0).setStartDelay(0).setDuration(220).setInterpolator(easing).setListener(self.listener).start()
        except Exception:
            self._cancel();self.container.removeAllViews();self.container.addView(view,FrameLayout.LayoutParams(-1,-1))
            view.setAlpha(1.0);view.setTranslationX(0.0);self.views=[view]
    def dispose(self):
        if self.closed:return
        self.closed=True;self._cancel()
        for view in self.views:view.setAlpha(1.0);view.setTranslationX(0.0)


def summary_history_owner(account):
    try:
        from org.telegram.messenger import UserConfig
        return max(0,int(UserConfig.getInstance(int(account)).getClientUserId()))
    except Exception:return 0

def summary_history_root():
    import os
    from org.telegram.messenger import ApplicationLoader
    return os.path.join(str(ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath()),'chat_summary_history_v1')

def saved_summary_record(saved):
    from dataclasses import asdict
    result,transcript,provider,model=saved.data
    # Keep validated message links, never original message excerpts or raw JSONL.
    ids={mid for _,_,mid in summary_narrative_entries(local_summary_text(result.text,transcript,True),transcript) if mid is not None}
    sources=tuple((int(mid),str(stamp),'') for mid,stamp,*_ in transcript.sources if int(mid) in ids)
    senders=tuple(row for row in transcript.source_senders if int(row[0]) in ids)
    metadata=asdict(replace(transcript,text='',chunks=(),sources=sources,source_senders=senders))
    return {'schema':1,'id':saved.record_id,'owner':saved.owner_uid,'created_at':saved.created_at,
        'created_epoch':saved.created_epoch,'result':asdict(result),'transcript':metadata,'provider':provider,'model':model}

def saved_summary_from_record(record,owner,account):
    import math
    if not isinstance(record,dict) or record.get('schema')!=1 or int(record.get('owner',0))!=owner:
        raise ValueError('history schema/owner')
    rid=str(record['id'])
    if not re.fullmatch('[0-9a-f]{32}',rid):raise ValueError('history id')
    epoch=float(record['created_epoch'])
    if not math.isfinite(epoch) or epoch<0:raise ValueError('history date')
    result=record['result'];raw=dict(record['transcript'])
    if not isinstance(result['text'],str) or len(result['text'])>1000000:raise ValueError('history result')
    from dataclasses import fields
    allowed={field.name for field in fields(Transcript)}
    raw={k:v for k,v in raw.items() if k in allowed};raw.update(text='',chunks=(),account=int(account))
    for key in ('used','scanned','available_text','omitted','clipped','dialog_id','thread_id','unread_expected',
                'unread_read_max','unread_upper_id','prior_selected','prior_text','period_start','period_end'):
        if key in raw:raw[key]=int(raw[key])
    for key in ('speaker_names','sources','participants','source_senders'):raw[key]=tuple(tuple(row) for row in raw.get(key,()))
    detail=raw.get('detail')
    if isinstance(detail,dict):
        keys={field.name for field in fields(DetailedOptions)}
        raw['detail']=DetailedOptions(**{k:v for k,v in detail.items() if k in keys})
    elif detail is not None:raise ValueError('history detail')
    usage=result.get('usage',{})
    usage=TokenUsage(**{k:usage.get(k) for k in ('input_tokens','output_tokens','total_tokens','reasoning_tokens')})
    provider=int(record['provider'])
    if not 0<=provider<len(PROVIDERS):raise ValueError('history provider')
    data=(AIResult(result['text'],bool(result.get('truncated',False)),usage),Transcript(**raw),provider,str(record.get('model','')))
    return SavedSummary(data,str(record['created_at']),rid,int(owner),epoch)

class SummaryHistoryStore:
    """Immutable, atomic records outside the plugin-install directory; scoped by Telegram UID."""
    pattern=re.compile(r'(-?\d+)_(\d+)_(\d+)_([0-9a-f]{32})\.json')
    def __init__(self,root):
        import os
        self.root=os.path.abspath(root);self.lock=threading.RLock()
        os.makedirs(self.root,mode=0o700,exist_ok=True)
    def directory(self,owner):
        import os
        owner=int(owner)
        if owner<=0:raise ValueError('history owner')
        return os.path.join(self.root,'u'+str(owner))
    def put(self,saved):
        import os
        record=saved_summary_record(saved);encoded=json.dumps(record,ensure_ascii=False,separators=(',',':')).encode('utf-8')
        if len(encoded)>8*1024*1024:raise ValueError('history size')
        transcript=saved.data[1]
        name=f'{int(transcript.dialog_id)}_{int(transcript.thread_id)}_{int(saved.created_epoch*1000000)}_{saved.record_id}.json'
        if self.pattern.fullmatch(name) is None:raise ValueError('history file')
        directory=self.directory(saved.owner_uid);target=os.path.join(directory,name);temporary=target+'.tmp'
        with self.lock:
            os.makedirs(directory,mode=0o700,exist_ok=True)
            try:
                with open(temporary,'wb') as stream:stream.write(encoded);stream.flush();os.fsync(stream.fileno())
                os.replace(temporary,target)
            finally:
                if os.path.exists(temporary):os.remove(temporary)
        return saved
    def load(self,owner,account,dialog=None,thread=0,limit=20):
        import os
        directory=self.directory(owner);found=[]
        with self.lock:
            if not os.path.isdir(directory):return [],False
            names=[]
            for name in os.listdir(directory):
                match=self.pattern.fullmatch(name)
                if match is None:continue
                if dialog is not None and (int(match[1]),int(match[2]))!=(int(dialog),int(thread)):continue
                names.append((int(match[3]),name))
            for _,name in sorted(names,reverse=True):
                try:
                    target=os.path.join(directory,name)
                    if os.path.getsize(target)>8*1024*1024:continue
                    with open(target,'r',encoding='utf-8') as stream:record=json.load(stream)
                    saved=saved_summary_from_record(record,int(owner),account)
                    if dialog is not None and (saved.data[1].dialog_id,saved.data[1].thread_id)!=(int(dialog),int(thread)):continue
                    found.append(saved)
                    if len(found)>limit:return found[:limit],True
                except (ValueError,TypeError,KeyError,OSError):continue
        return found,False
    def remove(self,owner,record_id=None):
        import os
        if record_id is not None and not re.fullmatch('[0-9a-f]{32}',str(record_id)):raise ValueError('history id')
        directory=self.directory(owner)
        with self.lock:
            if not os.path.isdir(directory):return
            for name in os.listdir(directory):
                match=self.pattern.fullmatch(name)
                if match is not None and (record_id is None or match[4]==record_id):os.remove(os.path.join(directory,name))


