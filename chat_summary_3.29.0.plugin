BUILTIN_STYLE_PROMPTS = (
    'Write a concise two-to-three sentence summary of the most important points.',
    'Write a detailed, structured summary of the important topics, decisions and unresolved issues.',
    'Use a compact bullet list for the main topics, decisions and unresolved issues.',
    'List explicit decisions and action items. Include owners and deadlines only when explicitly stated. Mark unresolved questions separately. Use plain headings for Decisions, Tasks and Open questions in the response language, with one bullet per explicitly stated task.',
)
BUILTIN_STYLE_IDS = ('builtin:brief','builtin:detailed','builtin:bullets','builtin:tasks')


def builtin_styles():
    return [{'id':key,'name':name,'prompt':prompt} for key,name,prompt in zip(BUILTIN_STYLE_IDS,STYLES,BUILTIN_STYLE_PROMPTS)]


def parse_style_catalog(raw):
    if raw is None:return builtin_styles()
    try:
        records=json.loads(str(raw))
        if not isinstance(records,list):raise ValueError()
        result=[];seen=set()
        for record in records:
            if not isinstance(record,dict):raise ValueError()
            key,name,prompt=record.get('id'),record.get('name'),record.get('prompt')
            if not isinstance(key,str) or not re.fullmatch(r'(?:builtin:(?:brief|detailed|bullets|tasks)|custom:[a-f0-9]{32})',key):raise ValueError()
            if key in seen or not isinstance(name,str) or not name.strip() or len(name)>80:raise ValueError()
            if not isinstance(prompt,str) or not prompt.strip() or len(prompt)>10000:raise ValueError()
            result.append({'id':key,'name':name.strip(),'prompt':prompt.strip()});seen.add(key)
        return result
    except (ValueError,TypeError):
        return builtin_styles()


def style_title(record):
    for original in builtin_styles():
        if record['id']==original['id'] and record['name']==original['name']:return _tr(record['name'])
    return record['name']


def neutral_style():
    return {'id':'','name':_tr('Без дополнительного стиля'),'prompt':''}


def resolve_style(records, key='', legacy=0):
    if key:
        return next((dict(record) for record in records if record['id']==key),dict(records[0]) if records else neutral_style())
    original=BUILTIN_STYLE_IDS[index_value(legacy,len(BUILTIN_STYLE_IDS))]
    return next((dict(record) for record in records if record['id']==original),dict(records[0]) if records else neutral_style())


def style_legacy_index(record):
    return BUILTIN_STYLE_IDS.index(record['id']) if record['id'] in BUILTIN_STYLE_IDS else 0


def with_detail_style(options, record):
    return replace(options,style=style_legacy_index(record),style_key=record['id'],
                   style_prompt=record['prompt'],style_name=record['name'],analytics=False)


def validate_style_draft(name, prompt):
    name=str(name).strip();prompt=str(prompt).strip()
    if not name or len(name)>80:raise SummaryError('style_name','Название стиля: от 1 до 80 символов.')
    if not prompt or len(prompt)>10000:raise SummaryError('style_prompt','Промпт стиля: от 1 до 10 000 символов.')
    return name,prompt


def header_theme_colour(fragment):
    bar=fragment.getActionBar()
    colour=java_field(bar,'itemsColor',None)
    if colour is not None:return ui_signed(int(colour))
    try:
        from org.telegram.ui.ActionBar import Theme
        return ui_signed(int(fragment.getThemedColor(Theme.key_actionBarDefaultIcon)))
    except Exception:
        try:return theme_color('key_actionBarDefaultIcon',0xFFFFFFFF)
        except Exception:return None  # Preserve the ImageView's native tint when a fork hides theme APIs.


def header_icon_bitmap(index, pixels):
    from android.graphics import Bitmap,Canvas,Paint,Path
    index=index_value(index,len(HEADER_ICONS))
    if index==0:return None
    bitmap=Bitmap.createBitmap(pixels,pixels,Bitmap.Config.ARGB_8888)
    canvas=Canvas(bitmap);canvas.scale(float(pixels)/64.0,float(pixels)/64.0)
    paint=Paint(Paint.ANTI_ALIAS_FLAG);paint.setColor(-1);paint.setStyle(Paint.Style.STROKE)
    paint.setStrokeWidth(float(HEADER_ICONS[index]['stroke']));paint.setStrokeCap(Paint.Cap.ROUND);paint.setStrokeJoin(Paint.Join.ROUND)
    for operations in HEADER_ICONS[index]['paths']:
        path=Path()
        for command in operations:
            op,args=command[0],command[1:]
            if op=='M':path.moveTo(*args)
            elif op=='L':path.lineTo(*args)
            elif op=='C':path.cubicTo(*args)
            elif op=='Z':path.close()
        canvas.drawPath(path,paint)
    return bitmap


