DETAIL_MODES = [
    ('unread','Непрочитанные','Все непрочитанные сообщения автоматически.'),
    ('with_read','Непрочитанные + прочитанные','Все непрочитанные и выбранное число прочитанных перед ними.'),
    ('period','По времени','Все сообщения за выбранный период, независимо от прочтения.'),
]


def initial_detail_mode(options, has_unread):
    if options.period:return 'period'
    return 'with_read' if options.prior_count or not has_unread else 'unread'


def selected_detail_options(base, mode, has_unread, count_text, prompt, selections, period, analytics):
    """Only the selected mode's control contributes to the immutable job options."""
    if mode not in {key for key,_,_ in DETAIL_MODES}:
        raise SummaryError('detail_options','Откройте настройки подробной сводки заново.')
    if mode=='unread' and not has_unread:
        raise SummaryError('detail_unread','Непрочитанных нет. Выберите прочитанные сообщения или период.')
    if mode=='with_read':
        value=str(count_text).strip()
        if not value.isdecimal() or int(value)<=0:
            raise SummaryError('detail_count','Введите количество прочитанных сообщений больше 0.')
    else:count_text='0'
    if mode=='period' and period not in dict(SUMMARY_PERIODS):
        raise SummaryError('detail_period','Выберите период заново.')
    base=replace(base,period=period if mode=='period' else '',analytics=False)
    return detail_form_options(base,has_unread and mode!='period',count_text,prompt,selections)


