FAQ_ITEMS = [
    ("Не удаётся подключиться", "Проверьте сервис, ключ именно этого провайдера и ID модели. Откройте «Модель» и загрузите список. Ошибка 401 — авторизация; 403 — права, проект или регион; 404 — модель или адрес; 429 — лимит или квота. Проверка подключения делает короткий запрос без переписки и может тарифицироваться."),
    ("Кто видит переписку?", "После нажатия «Создать сводку» выбранный текст отправляется настроенному AI-сервису без дополнительного окна. Псевдонимы заменяют имя отправителя, но не очищают имена, телефоны и секреты внутри текста. Условия хранения данных задаёт провайдер."),
    ("Нужно ли платить?", "Плагин использует ваш API-ключ. Проверка подключения и создание сводки могут стоить денег по тарифу сервиса. Подписка на приложение AI не обязательно включает API. У Ollama условия зависят от того, где и как запущен сервер."),
    ("Что делает отмена?", "Отмена прекращает следующие шаги, закрывает ожидание и игнорирует поздний ответ. Уже принятый AI-сервером запрос и его стоимость отозвать нельзя. Занятый сетевой запрос должен завершиться или достичь таймаута перед новым запуском."),
    ("Ollama работает на компьютере", "127.0.0.1 в плагине означает телефон, не компьютер. Укажите адрес ПК в вашей сети и убедитесь, что сервер доступен телефону. HTTP без шифрования разрешайте только в доверенной сети. Не открывайте незащищённый Ollama в интернет."),
    ("Почему сообщений меньше?", "Берутся все входящие в сохранённом непрочитанном диапазоне. Текст, подписи и опросы разбиваются на части без пропуска старых записей. Медиа без подписи и служебные сообщения не содержат текста для AI."),
]

FAQ_ITEMS.append(("Как показываются имена?", "Включите «Скрывать имена» и «Имена в результате». AI получает метки отправителей, а известные имена подставляются на телефоне. Это не удаляет имена из самих сообщений. Если профиль недоступен или сервис изменил метки, часть псевдонимов останется. Сопоставление сохраняется вместе со сводкой на устройстве; старые результаты без него восстановить невозможно."))
