HEADER_PNG = ['', '', '', '', '', '', '', '', '', '', '']



def workspace_identity(data):
    transcript=data[1]
    return (transcript.account,transcript.dialog_id,transcript.thread_id)

def workspace_history(entries, identity):
    return [item for item in entries if workspace_identity(item.data)==tuple(identity)]

def workspace_swipe(dx, dy, threshold=32.0):
    # 2 locks a vertical drag; +1 goes to the next tab, -1 to the previous.
    if abs(dy)>=threshold/2 and abs(dy)>=abs(dx):return 2
    if abs(dx)>=threshold and abs(dx)>abs(dy)*1.5:return 1 if dx<0 else -1
    return 0

def workspace_dimensions(width, height, density):
    return (max(1,min(int(width-32*density),int(560*density))),
            max(1,min(int(height*0.78),int(height-48*density))))

class SummaryWorkspaceTouchHook(MethodHook):
    def __init__(self,plugin):self.plugin=plugin
    def before_hooked_method(self,param):
        if self.plugin._loaded and self.plugin._workspace_touch(param.thisObject,param.args[0]):param.setResult(True)

class SummaryWorkspaceDialog(SummaryReadingDialog):
    """A bounded modal window. Reading consumes its remaining measured height."""
    def __init__(self,activity):
        super().__init__(activity)
        self.activity=activity;self.dialog.setCanceledOnTouchOutside(True)
    def setBackgroundColor(self,color):
        from android.graphics.drawable import ColorDrawable
        self.dialog.getWindow().setBackgroundDrawable(ColorDrawable(0))
    def fixNavigationBar(self,color):
        # The app remains visible around this window; keep the host's system bars.
        pass
    def show(self):
        from android.view import WindowManager
        self.dialog.show();window=self.dialog.getWindow()
        metrics=self.activity.getResources().getDisplayMetrics()
        width,height=workspace_dimensions(metrics.widthPixels,metrics.heightPixels,metrics.density)
        window.setLayout(width,height)
        window.addFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND)
        attributes=window.getAttributes();attributes.dimAmount=0.45;attributes.gravity=17
        window.setAttributes(attributes)

