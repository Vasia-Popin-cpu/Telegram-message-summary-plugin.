def reasoning_levels(provider, model):
    # Only documented model families get vendor-specific controls automatically.
    all_levels=('none','low','medium','high','xhigh','max')
    if provider==PROVIDER_CUSTOM:return all_levels  # Explicit OpenAI-compatible server opt-in.
    if provider!=PROVIDER_OPENAI:return ()
    name=str(model).lower()
    if re.fullmatch(r'(?:gpt-6-luna|gpt-6-sol|gpt-6\.1-terra)(?:-\d{4}-\d{2}-\d{2})?',name):return all_levels
    if re.fullmatch(r'(?:gpt-6-astra|gpt-6\.1-sol)(?:-\d{4}-\d{2}-\d{2})?',name):return all_levels[1:]
    return ()

def reasoning_setting_key(provider, model):
    digest=hashlib.sha256(str(model).strip().encode('utf-8')).hexdigest()[:16]
    return 'reasoning_'+str(provider)+'_'+digest

def reasoning_label(value):
    return _tr({'':'Авто · как у модели','none':'Выключены','low':'Low · низкий','medium':'Medium · средний',
        'high':'High · высокий','xhigh':'Xhigh · очень высокий','max':'Max · максимальный'}.get(value,'Авто · как у модели'))


